

[events e_generic_npc_vendors]
ON=@CLICK
MESSAGE @1153,,1,1 [<JOB>]
MESSAGE @<DEF.NOTO.<NOTOGETFLAG>> <NAME>
RETURN 1


ON=@DCLICK
// sorgular buy speechin altında mı olmalı? buraya ekstra sorguya gerek var mı
IF !(<SRC.ISGM>)
	IF (<SRC.FLAGS>&STATF_DEAD) 
		SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // Ölü durumdayken bu işlemi yapamazsınız.
		RETURN 1
	ELSEIF (<SRC.ISDIFF 2,<UID>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
		RETURN 1
	ENDIF
ENDIF
FACE <SRC>
BUY
RETURN 1


On=@EnvironChange
IF (<FLAGS>&STATF_WAR) 
	RETURN 0
ENDIF
IF !(<SECTOR.ISDARK>) || (<FLAGS>&STATF_NIGHTSIGHT)
	IF (<FINDLAYER(LAYER_HAND2)>)
		IF (<FINDLAYER(LAYER_HAND2).TYPE> == T_LIGHT_LIT)
			FINDLAYER(LAYER_HAND2).BOUNCE
		ENDIF
	ENDIF
	RETURN 0
ENDIF
IF (<FINDLAYER(LAYER_HAND2)>)
	IF (<FINDLAYER(LAYER_HAND2).TYPE> == T_LIGHT_LIT)
		RETURN 0
	ENDIF
ENDIF
IF (<FINDTYPE.T_LIGHT_OUT>)
	FINDTYPE.T_LIGHT_OUT.EQUIP
	FINDTYPE.T_LIGHT_OUT.USE
ENDIF
RETURN 0



[eof]
