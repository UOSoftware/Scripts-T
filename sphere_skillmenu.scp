VERSION=0.56T



[COMMENT]
The sphereserver has a number of hardcoded spellmenu's, this file contains the softcoded component.  The prupose of each is as follows:
// Spells
sm_summon				= Triggered by the Magery "summoning" spell
sm_summon_familiar		= Triggered by the Necromancy "Summon Familiar" spell
sm_polymorph			= Triggered by the Magery Polymorph spell


[PLEVEL 1]
MAKELAST

[FUNCTION MAKELAST]
LOCAL.MAKEITEM = <TAG0.CRAFT_LASTMAKE_BASEID>
LOCAL.MAKEAMOUNT = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>

IF !(<ACTION> == -1)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Şu an zaten bir beceri kullanıyorsunuz.
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>Şu an zaten bir beceri kullanıyorsunuz.
	RETURN 1
	
ELSEIF !(<TAG0.CRAFT_LASTMAKE_BASEID>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, En son ne yaptığınızı hatırlamıyorsunuz.
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>En son ne yaptığınızı hatırlamıyorsunuz.
	RETURN 1
	
ELSEIF (<LOCAL.MAKEITEM> == 0) || !(<LOCAL.MAKEITEM>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, En son ne yaptığınızı hatırlamıyorsunuz.
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>En son ne yaptığınızı hatırlamıyorsunuz.
	RETURN 1
	
ELSEIF (<LOCAL.MAKEAMOUNT> > 50000)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,  En fazla 50.000 kere tekrar yapabilirsiniz.
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>En fazla 50.000 kere tekrar yapabilirsiniz.
	RETURN 1

ELSEIF !(<CANMAKESKILL <LOCAL.MAKEITEM>>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, [<serv.itemdef.<LOCAL.MAKEITEM>.name>] Yeterli beceriye sahip değilsin. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.SKILLMAKE>)
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>[<serv.itemdef.<LOCAL.MAKEITEM>.name>] Yeterli beceriye sahip değilsin. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.SKILLMAKE>)
	RETURN 1

ELSEIF (<ISEVENT.E_MAKELAST>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Şu an zaten yaptıklarınız tekrarlanıyor.
	CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>Şu an zaten yaptıklarınız tekrarlanıyor.
	RETURN 1

ELSEIF !(<CANMAKE <LOCAL.MAKEITEM>>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yeterli malzemeye sahip değilsin. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.RESMAKE>)
		CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>Yeterli malzemeye sahip değilsin. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.RESMAKE>)
	RETURN 1
ENDIF

// IF (<WEIGHT> >= <MAXWEIGHT>)
	// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Olabilecek en yüksek ağırlığa ulaştığınız için eşyayı üretemezsiniz. (<FVAL <WEIGHT>>/<FVAL <MAXWEIGHT>>)
	// CTAG.Craft_Menu.Notice = <DEF.BFONT_RED>Olabilecek en yüksek ağırlığa ulaştığınız için eşyayı üretemezsiniz. (<FVAL <WEIGHT>>/<FVAL <MAXWEIGHT>>)
	// RETURN 1
// ENDIF

IF (<ISONLINE>)

	IF (<LOCAL.MAKEAMOUNT> > 1)
		EVENTS +E_MAKELAST
	ENDIF
	
	IF (<ISEMPTY <ARGS>>)
		SYSMESSAGELOC <def.tcolor_blue>,<def.empty_cliloc2>, .makelast 5000 olarak da komutu kullanabilirsiniz. 5000 tekrar otomatik olarak yapılacaktır. 5000 yerine 2 ile 50.000 arasında herhangi bir rakam girebilirsiniz.
	ENDIF
	
	MAKEITEM <LOCAL.MAKEITEM>
	CTAG0.CRAFT_NOTICE <DEF.BFONT_GREEN><SERV.ITEMDEF.<LOCAL.MAKEITEM>.NAME> isimli eşya tekrar yapılıyor.
	CTAG0.MAKE_TEKRAR = <LOCAL.MAKEAMOUNT>
	CTAG0.MAKE_TEKRAR_BASE <dCTAG0.MAKE_TEKRAR>
	CTAG.Craft_Menu.Notice = <DEF.BFONT_GREEN>Son yaptığınız eşya yapılıyor. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.NAME>)
			
	IF !(<ISDIALOGOPEN D_CRAFT_MENU>)
		SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, Son yaptığınız eşya yapılıyor. (<SERV.ITEMDEF.<LOCAL.MAKEITEM>.NAME>)
		
		IF (<LOCAL.MAKEAMOUNT> > 1)
			SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Tekrar sayisi: <dCTAG0.MAKE_TEKRAR>
			SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, İslemi iptal etmek icin savas moduna gecmeniz yeterlidir.
		ENDIF
	ELSE
		DIALOGCLOSE D_CRAFT_MENU
		DIALOG D_CRAFT_MENU
	ENDIF
	
ENDIF




[EVENTS e_makelast]
ON=@USERWARMODE
SRC.CTAG0.MAKE_TEKRAR =
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
SRC.EVENTS -E_MAKELAST
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF
	

ON=@DEATH
SRC.CTAG0.MAKE_TEKRAR =
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
SRC.EVENTS -E_MAKELAST
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF


ON=@LOGOUT
SKILL FAIL
SRC.CTAG0.MAKE_TEKRAR =
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
SRC.EVENTS -E_MAKELAST
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF


ON=@ATTACK
CTAG0.MAKE_TEKRAR =
SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
EVENTS -E_MAKELAST
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF


ON=@SPELLCAST
SRC.CTAG0.MAKE_TEKRAR =
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
SRC.EVENTS -E_MAKELAST
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF


ON=@SKILLFAIL
LOCAL.MAKEITEM=<TAG0.CRAFT_LASTMAKE_BASEID>

CTAG0.MAKE_TEKRAR -=1
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
CTAG.Craft_Menu.Notice = <DEF.BFONT_WHITE>Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
TIMERF 1,MAKEITEM <LOCAL.MAKEITEM>

IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF






ON=@SKILLABORT
LOCAL.MAKEITEM=<TAG0.CRAFT_LASTMAKE_BASEID>
CTAG0.MAKE_TEKRAR -=1
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
CTAG.Craft_Menu.Notice = <DEF.BFONT_WHITE>Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
TIMERF 1,MAKEITEM <LOCAL.MAKEITEM>
IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF




ON=@SKILLMAKEITEM
LOCAL.MAKEITEM=<SRC.TAG0.CRAFT_LASTMAKE_BASEID>

SRC.CTAG0.MAKE_TEKRAR --

IF (<SRC.DCTAG0.MAKE_TEKRAR> <= 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tekrar işleminiz sona erdi.
	SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED>Tekrar işleminiz sona erdi.
	SRC.EVENTS -E_MAKELAST
	SRC.CTAG0.MAKE_TEKRAR=

ELIF !(<SRC.CANMAKE <LOCAL.MAKEITEM>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,  <SERV.ITEMDEF.<LOCAL.MAKEITEM>.NAME> uretebilecek malzemeniz veya yeteneğiniz bulunmuyor.
	SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_LRED><SERV.ITEMDEF.<LOCAL.MAKEITEM>.NAME> uretebilecek malzemeniz veya yeteneğiniz bulunmuyor.
	SRC.CTAG0.MAKE_TEKRAR=
	SRC.EVENTS -E_MAKELAST
ENDIF

SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
SRC.CTAG.Craft_Menu.Notice = <DEF.BFONT_WHITE>Kalan tekrar: <DCTAG0.MAKE_TEKRAR>/<dCTAG0.MAKE_TEKRAR_BASE>
SRC.TIMERF 1,MAKEITEM <LOCAL.MAKEITEM>

IF (<ISDIALOGOPEN D_CRAFT_MENU>)
	DIALOGCLOSE D_CRAFT_MENU
	DIALOG D_CRAFT_MENU
ENDIF



// SCROLL YAZMA GEREKSINIM KONTROLU
[FUNCTION ISCANCAST]
IF !(<ISEMPTY <ARGS>>)
	IF (STRMATCH('I_SCROLL_PARALYZE_FIELD','<ARGS>'))
		LOCAL.SPELL=S_PARALYZATION_FIELD
	ELSE
		LOCAL.SPELL=S_<STRSUB 9 99 <ARGS>>
	ENDIF
	IF (<CANCAST <LOCAL.SPELL>>)	
		RETURN 1
	ENDIF
	RETURN 0
ENDIF







[FUNCTION TOOLS]
SERV.NEWITEM I_MORTAR_PESTLE,1,<FINDLAYER.21>,1
SERV.NEWITEM I_ARROW_SHAFT,1,<FINDLAYER.21>,1
SERV.NEWITEM I_SAW,1,<FINDLAYER.21>,1
SERV.NEWITEM I_MAPMAKERS_PEN,1,<FINDLAYER.21>,1
SERV.NEWITEM I_MAP_BLANK,100,<FINDLAYER.21>,1
SERV.NEWITEM I_SCROLL_BLANK,100,<FINDLAYER.21>,1
SERV.NEWITEM I_SEWING_KIT,1,<FINDLAYER.21>,1
SERV.NEWITEM I_TINKER_TOOLS,1,<FINDLAYER.21>,1
SERV.NEWITEM I_BOTTLE_EMPTY,100,<FINDLAYER.21>,1
SERV.NEWITEM I_HAMMER_SMITH,1,<FINDLAYER.21>,1

// SERV.NEWITEM I_BAG,1,<FINDLAYER.21>,1
// REF1=<NEW>

// FOR 1 <ARRAYCOUNT <DEF.STORE_BOX_ITEMLIST_INGOTS>>
	// LOCAL.ITEM <ARRAY <DEF.STORE_BOX_ITEMLIST_INGOTS>,<DLOCAL._FOR>>
	// SERV.NEWITEM <LOCAL.ITEM>,100,<REF1>,1
// ENDFOR





[DIALOG d_craft_menu]
<DEF.dlgstartpos>

RESIZE 0,0,620,430,<SRC.CTAG.Craft_Menu.Skill> Menu

LOCAL.SKILL = <SRC.CTAG.Craft_Menu.Skill>

LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	
	// Kategoriler
	DORIGIN 20 50
	RESIZEPIC +0 +0 3000 140 250
	LDB.QUERY "SELECT id, category FROM 'craftmenu' WHERE skill_key='SKILL_<STRTOUPPER <LOCAL.SKILL>>' AND <SRC.CTAG.Craft_Menu.CAT_WHERE> GROUP BY category ORDER BY category ASC LIMIT <SRC.DCTAG.CRAFT_MENU.CAT_INDEX>,9"
	IF (<LDB.ROW.NUMROWS>)
		FOR cats 0 <EVAL <LDB.ROW.NUMROWS>-1>
			LOCAL.CATCOUNT=<LDB.ROW.NUMROWS>
			DHTMLGUMP +40 <EVAL (<LOCAL.cats>*20)+80> 140 25 0 0 <QVAL (<ISBLANK <LDB.ROW.<DLOCAL.cats>.category>>) ? Hepsi : <LDB.ROW.<DLOCAL.cats>.category>>
			BUTTON +10 <EVAL (<LOCAL.cats>*20)+80> 4006 4007 1 0 <EVAL <LDB.ROW.<DLOCAL.cats>.id>>	
		ENDFOR
	ENDIF
	
	DTEXT +10 +10 0 Kategori (<dLOCAL.CATCOUNT>);

	// Kategori içeriği
	RESIZEPIC +150 +0 3000 430 250
	LDB.QUERY "SELECT id, baseid FROM 'craftmenu' WHERE <SRC.CTAG.Craft_Menu.Item_Where> AND skill_key='SKILL_<STRTOUPPER <LOCAL.SKILL>>' ORDER BY <SRC.CTAG.Craft_Menu.Item_Order> LIMIT <SRC.DCTAG.CRAFT_MENU.ITEM_INDEX>,9"
	
	IF (<LDB.ROW.NUMROWS>)
		LOCAL.ITEMCOUNT=<LDB.ROW.NUMROWS>
		LOCAL.X=180
		LOCAL.Y=15
		FOR items 0 <EVAL <LDB.ROW.NUMROWS>-1>
			LOCAL.ITEM <LDB.ROW.<DLOCAL.items>.baseid>
			LOCAL.ROWID=<lDB.ROW.<DLOCAL.items>.id>
			LOCAL.Y +=80
			
			IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
				DCROPPEDTEXT <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-30)> 90 25 38 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
				
			ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
				DCROPPEDTEXT <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-30)> 90 25 38 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
				
			ELSEIF ((<SERV.ITEMDEF.<LOCAL.ITEM>.TYPE> == T_SCROLL) && (<LOCAL.ITEM> != I_SCROLL_BLANK))
				IF !(<SRC.ISCANCAST <LOCAL.ITEM>>)
					DCROPPEDTEXT <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-30)> 90 25 38 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
				ELSE
					DCROPPEDTEXT <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-30)> 90 25 044 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
				ENDIF
			ELSE
				DCROPPEDTEXT <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-30)> 90 25 044 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
			ENDIF
			
			BUTTON <EVAL (<DLOCAL.X>)> <EVAL (<DLOCAL.Y>-10)> 4006 4007 1 0 <EVAL <LOCAL.ROWID>+1000>  //  Üret			
			TILEPICHUE <EVAL (<DLOCAL.X>)+50> <EVAL (<DLOCAL.Y>+0)> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <DSERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE>
			BUTTON <EVAL (<DLOCAL.X>)+30> <EVAL (<DLOCAL.Y>-7)> 0845 0846 1 0 <EVAL <LOCAL.ROWID>+2000> // Detay
			IF (<LOCAL.Y> > 240)
				LOCAL.X +=140
				LOCAL.Y=15
			ENDIF		
		ENDFOR
	ENDIF
	
	// Orta BG
	DORIGIN 20 310
	RESIZEPIC +0 +0 3000 580 40
	
	// Category Sayfalama
	LOCAL.CATPAGE = <EVAL (<SRC.dCTAG.Craft_Menu.Cat_INDEX>/9)+1>
	// IF (<DLOCAL.CATPAGE> > 1)
		DTEXT +10 +10 0 Sayfa: <DLOCAL.CATPAGE>
	// ENDIF
	IF (<EVAL (<LOCAL.CATCOUNT>/9)>)
		BUTTON +120 +10 5601 5605 1 0 10000 // ++ 
	ENDIF
	IF !(<SRC.dCTAG.Craft_Menu.Cat_INDEX> <= 0)
		BUTTON +100 +10 5603 5607 1 0 10001 // --
	ENDIF

	// Item sayfalama
	LOCAL.ITEMPAGE = <EVAL (<SRC.DCTAG.CRAFT_MENU.ITEM_INDEX>/9)+1> 
	// IF (<DLOCAL.ITEMPAGE> > 1)
		DTEXT +470 +10 0 Sayfa: <DLOCAL.ITEMPAGE>
	// ENDIF
	IF (<EVAL (<DLOCAL.ITEMCOUNT>/9)>)
		BUTTON +560 +10 5601 5605 1 0 10002 // ++ 
	ENDIF
	IF !(<SRC.dCTAG.Craft_Menu.ITEM_INDEX> <= 0)
		BUTTON +540 +10 5603 5607 1 0 10003 // --
	ENDIF
	
	// İtem arama
	RESIZEPIC +150 +7 3000 130 25
	BUTTON +280 +10 4006 4007 1 0 10004
	DTEXT +310 +10 0 Eşya Ara
	IF (<ISBLANK <SRC.CTAG.Craft_Menu.Item_SearchInput>>)
		DTEXTENTRYLIMITED +155 +10 120 25 0 1 13 
	ELSE
		DTEXTENTRYLIMITED +155 +10 120 25 0 1 13 <SRC.CTAG.Craft_Menu.Item_SearchInput>
	ENDIF
	
	// Sol Alt
	DORIGIN 20 360
	RESIZEPIC +0 +0 3000 285 50
	BUTTON +10 +5 4006 4007 1 0 10005 
	IF (<ISBLANK <SRC.TAG.Craft_Menu.MakeLastItem>>)
		DTEXT +40 +5 0 Tekraryap 
	ELSE
		DTEXT +40 +5 0 Tekraryap (<SERV.ITEMDEF.<SRC.TAG.Craft_Menu.MakeLastItem>.NAME>)
	ENDIF
	
	// Sağ Alt
	DORIGIN 315 360
	RESIZEPIC +0 +0 3000 285 50
	DTEXT +10 +5 0 <SRC.CTAG.CRAFT_MENU.SKILL>: <SRC.<LOCAL.SKILL>>
	IF (<ARGO> && <ARGO.ISITEM>)
		DTEXT +10 +25 0 Araç: <argo.name>
	ENDIF
DB.CLOSE
ENDIF


[DIALOG D_CRAFT_MENU BUTTON]
on=0
SRC.CTAG.Craft_Menu.Item_SearchInput=


// KATEGORI BUTONLARI
ON=1 999
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.QUERY "SELECT id, category FROM 'craftmenu' WHERE id='<EVAL <DARGN>>'"
	IF (<lDB.ROW.NUMROWS>)
		SRC.CTAG.CRAFT_MENU.ITEM_WHERE="category='<LDB.ROW.0.category>'"
		SRC.CTAG.CRAFT_MENU.ITEM_INDEX=0
		SRC.CTAG.CRAFT_MENU.ITEM_ORDER="name asc"
		SRC.SYSMESSAGE Kategori: <LDB.ROW.0.category>
		SDIALOG D_CRAFT_MENU
	ELSE
		SRC.SYSMESSAGE Kategori bulunamadi!
	ENDIF	
ENDIF
LDB.CLOSE




// ESYA URETME BUTONLARI
ON=1000 1999
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.QUERY "SELECT baseid FROM 'craftmenu' WHERE id='<EVAL <DARGN>-1000>'"
	IF (<lDB.ROW.NUMROWS>)
		LOCAL.ITEM <LDB.ROW.0.BASEID>

		IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı üretmek için gereken becerilere sahip değilisiniz.
			SRC.CTAG.CRAFT_MENU.ITEM_INFO=<LDB.ROW.0.BASEID>
			SDIALOG D_CRAFT_MENU_ITEM_PROPS 
			RETURN 1

		ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı üretmek için gereken malzemelere sahip değilisiniz.
			SRC.CTAG.CRAFT_MENU.ITEM_INFO=<LDB.ROW.0.BASEID>
			SDIALOG D_CRAFT_MENU_ITEM_PROPS 
			RETURN 1

		ELSEIF ((<SERV.ITEMDEF.<LOCAL.ITEM>.TYPE> == T_SCROLL) && (<LOCAL.ITEM> != I_SCROLL_BLANK))
		
			IF !(<SRC.ISCANCAST <LOCAL.ITEM>>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu büyü kitabınızda yer almıyor veya büyüyü uygulayacak niteliğe sahip değilsiniz. (Int - Mana - Skill - Reagent - Spellbook kontrol ediniz.)
				LOCAL.SPELL = <IsScrollSpell <LOCAL.ITEM>>
				IF (<SRC.MANA> <= <SERV.SPELL.<LOCAL.SPELL>.MANAUSE>)
					SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yetersiz mana. (Gereken mana: <SERV.SPELL.<LOCAL.SPELL>.MANAUSE>)
				ENDIF
				SDIALOG D_CRAFT_MENU
				RETURN 1
			ENDIF
			
		ENDIF
		
		IF (<SRC.ACTION> != -1)
			IF (<SERV.SKILL.<SRC.ACTION>.FLAGS>&SKF_CRAFT)
				SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Şu an zaten birşey üretiyorsuz.
				SDIALOG D_CRAFT_MENU
				RETURN 1
			ENDIF
		ENDIF

		IF (<SRC.ISONLINE>)
			SRC.MAKEITEM <LOCAL.ITEM>
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> isimli eşyayı üretmeye başladın.
			SDIALOG D_CRAFT_MENU
		ENDIF
		
	ENDIF		
ENDIF
LDB.CLOSE





// İncele
ON=2000 2999
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.QUERY "SELECT baseid FROM 'craftmenu' WHERE id='<EVAL <DARGN>-2000>'"
	IF (<lDB.ROW.NUMROWS>)
		SRC.CTAG.Craft_Menu.Item_Info=<LDB.ROW.0.BASEID>
		SDIALOG D_CRAFT_MENU_ITEM_PROPS 
	ENDIF		
ENDIF
LDB.CLOSE



// KATEGORI PAGE ++
ON=10000
SRC.CTAG.Craft_Menu.Cat_Index +=9
SDIALOG D_CRAFT_MENU

// KATEGORI PAGE --
ON=10001
IF (<SRC.CTAG.Craft_Menu.Cat_Index> > 0)
	SRC.CTAG.Craft_Menu.Cat_Index -=9
ENDIF
SDIALOG D_CRAFT_MENU



// ITEM PAGE ++
ON=10002
SRC.CTAG.Craft_Menu.Item_Index +=9
SDIALOG D_CRAFT_MENU


// ITEM PAGE --
ON=10003
IF (<SRC.CTAG.Craft_Menu.Item_Index> > 0)
	SRC.CTAG.Craft_Menu.Item_Index -=9
ENDIF
SDIALOG D_CRAFT_MENU


// ITEM Ara
ON=10004
IF !(<ISSTRING <argtxt[1]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600011 // "Sadece harf kullanabilirsiniz."
	SRC.CTAG.Craft_Menu.Item_Index=0
	SRC.CTAG.Craft_Menu.Item_WHERE="id"

ELSEIF (<ISBLANK <ARGTXT[1]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600011 // "Boş giriş yapamazsınız."
	SRC.CTAG.Craft_Menu.Item_Index=0
	SRC.CTAG.Craft_Menu.Item_WHERE="id"

ELSE
	SRC.CTAG.Craft_Menu.Item_SearchInput=<ARGTXT[1]>
	SRC.CTAG.Craft_Menu.Item_Index=0
	SRC.CTAG.Craft_Menu.Item_WHERE="name LIKE '%<ARGTXT[1]>%'"
ENDIF
SDIALOG D_CRAFT_MENU



// Tekraryap
ON=10005
SRC.MAKELAST
SDIALOG D_CRAFT_MENU




[DIALOG D_CRAFT_MENU_ITEM_PROPS]
<DEF.dlgstartpos>

LOCAL.ITEM=<SRC.CTAG.CRAFT_MENU.ITEM_INFO>
LOCAL.SKILL=<SRC.CTAG0.CRAFT_MENU.SKILL>

PAGE 0
RESIZE 0,0,440,440,<LOCAL.SKILL> / <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 

DORIGIN 20 400
BUTTON +0 +0 4015 4016 1 0 0
DTEXT +30 +0 0 Geri

// Item Picture
DORIGIN 20 50
RESIZEPIC +0 +0 2620 100 80
TILEPICHUE +25 +25 <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <DSERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE>

// Item Detay
DORIGIN 130 50
RESIZEPIC +0 +0 2620 285 80
DTEXT +10 +10 1000 Eşya : <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
IF (<SERV.ITEMDEF.<LOCAL.ITEM>.WEIGHT>)
	DTEXT +10 +50 1000 Ağırlık : <SERV.ITEMDEF.<LOCAL.ITEM>.WEIGHT>
ENDIF


// Resources
DORIGIN 20 140
RESIZEPIC +0 +0 3000 190 240
LOCAL.RESOURCES <SERV.ITEMDEF.<LOCAL.ITEM>.RESOURCES.0.KEY>
IF (<ARRAYCOUNT <LOCAL.RESOURCES>>)
	DTEXT +10 +10 0 Malzemeler (<ARRAYCOUNT <LOCAL.RESOURCES>>)
	FOR r 1 <ARRAYCOUNT <LOCAL.RESOURCES>>
		LOCAL.RESITEM <SERV.ITEMDEF.<LOCAL.ITEM>.RESOURCES.<DLOCAL.r>.KEY>
		LOCAL.RESAMOUNT <SERV.ITEMDEF.<LOCAL.ITEM>.RESOURCES.<DLOCAL.r>.VAL>
		IF (<SRC.RESTEST <DLOCAL.RESAMOUNT> <LOCAL.RESITEM>>)
			DCROPPEDTEXT +50 <EVAL (<LOCAL.r>*35)+150> 135 25 044 <SRC.Pack_Counter <LOCAL.RESITEM>>/<DLOCAL.RESAMOUNT> <SERV.ITEMDEF.<LOCAL.RESITEM>.NAME>
		ELSE
			DCROPPEDTEXT +50 <EVAL (<LOCAL.r>*35)+150> 135 25 38 <SRC.Pack_Counter <LOCAL.RESITEM>>/<DLOCAL.RESAMOUNT> <SERV.ITEMDEF.<LOCAL.RESITEM>.NAME>
		ENDIF
		TILEPICHUE +0 <EVAL (<LOCAL.r>*35)+150> <SERV.ITEMDEF.<LOCAL.RESITEM>.ID> <dSERV.ITEMDEF.<LOCAL.RESITEM>.RESDISPDNHUE>
	ENDFOR
ENDIF


// Skillmake
DORIGIN 220 140
RESIZEPIC +0 +0 3000 190 240
LOCAL.SKILLMAKE <SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE>
IF (<ARRAYCOUNT <LOCAL.SKILLMAKE>>)
	DTEXT +10 +10 0 Beceriler & Araçlar (<ARRAYCOUNT <LOCAL.SKILLMAKE>>)
	FOR s 1 <ARRAYCOUNT <LOCAL.SKILLMAKE>>
		LOCAL.SKILL_ID <STREAT <ARRAY <LOCAL.SKILLMAKE>,<DLOCAL.S>>>
		LOCAL.SKILL_VAL <STRARG <ARRAY <LOCAL.SKILLMAKE>,<DLOCAL.S>>>
		IF (<RESOURCETYPE <LOCAL.SKILL_ID>> == RES_SKILL)	
			IF (<SRC.<SERV.SKILL.<dLOCAL.SKILL_ID>.NAME>> >= <DLOCAL.SKILL_VAL>)
				DCROPPEDTEXT +40 <EVAL (<LOCAL.s>*35)+150> 135 25 044 <SRC.<SERV.SKILL.<LOCAL.SKILL_ID>.NAME>>/<FVAL <DLOCAL.SKILL_VAL>> <SERV.SKILL.<LOCAL.SKILL_ID>.NAME>
			ELSE
				DCROPPEDTEXT +40 <EVAL (<LOCAL.s>*35)+150> 135 25 0 <SRC.<SERV.SKILL.<LOCAL.SKILL_ID>.NAME>>/<FVAL <DLOCAL.SKILL_VAL>> <SERV.SKILL.<LOCAL.SKILL_ID>.NAME>
			ENDIF
		ELSEIF (<RESOURCETYPE <LOCAL.SKILL_ID>> == RES_ITEMDEF)	
			IF (<SRC.RESTEST 1 <LOCAL.SKILL_ID>>)
				DCROPPEDTEXT +40 <EVAL (<LOCAL.s>*35)+150> 135 25 044 <SERV.ITEMDEF.<LOCAL.SKILL_ID>.NAME>
			ELSE
				DCROPPEDTEXT +40 <EVAL (<LOCAL.s>*35)+150> 135 25 0 <SERV.ITEMDEF.<LOCAL.SKILL_ID>.NAME>
			ENDIF
			TILEPICHUE +0 <EVAL (<LOCAL.s>*35)+150> <SERV.ITEMDEF.<LOCAL.SKILL_ID>.ID> 0	
		ELSE
			DCROPPEDTEXT +40 <EVAL (<LOCAL.s>*35)+150> 135 25 0 <DEF.TYPENAME_<LOCAL.SKILL_ID>>
		ENDIF
	ENDFOR
ENDIF

[DIALOG D_CRAFT_MENU_ITEM_PROPS BUTTON]
ON=0
DIALOGCLOSE D_CRAFT_MENU
DIALOG D_CRAFT_MENU


		

[FUNCTION Func_Craft_Menu_Rebuild]	
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	Func_Craft_Menu_List
	LDB.EXECUTE DROP TABLE IF EXISTS 'craftmenu'
	LDB.EXECUTE CREATE TABLE IF NOT EXISTS 'craftmenu' (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, baseid TEXT, name TEXT, type TEXT, category TEXT, subsection TEXT, skill_key TEXT, skill_val TEXT, created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)

	LOCAL.HOUR=<SERV.RTICKS>
	LDB.EXECUTE BEGIN	
	IF (<SERV.LIST.CRAFTITEMS.COUNT>)
		FOR 0 <EVAL <SERV.LIST.CRAFTITEMS.COUNT>-1>
			LOCAL.ITEM=<SERV.LIST.CRAFTITEMS.<DLOCAL._FOR>>
			IF (<RESOURCETYPE <LOCAL.ITEM>> == RES_ITEMDEF)
				LOCAL.SKILL_KEY=<SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE.1.KEY>
				LOCAL.SKILL_VAL=<SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE.1.VAL>	
				LOCAL.NAME=<STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>>
				IF (<ISBLANK <SERV.ITEMDEF.<LOCAL.ITEM>.CATEGORY>>)
					LOCAL.CATEGORY=Undefined
				ELSE
					LOCAL.CATEGORY = <STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.CATEGORY>>
				ENDIF
				IF (<ISBLANK <SERV.ITEMDEF.<LOCAL.ITEM>.SUBSECTION>>)
					LOCAL.SUBSECTION=Undefined
				ELSE
					LOCAL.SUBSECTION = <STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.SUBSECTION>>
				ENDIF
				LDB.QUERY "SELECT id FROM 'craftmenu' WHERE baseid='<STRTOUPPER <LOCAL.ITEM>>'"
				IF (<LDB.ROW.NUMROWS>)
					LDB.EXECUTE "UPDATE 'craftmenu' SET name='<LOCAL.NAME>', type='<STRTOUPPER <SERV.ITEMDEF.<LOCAL.ITEM>.TYPE>>', skill_key='<STRTOUPPER <LOCAL.SKILL_KEY>>', skill_val='<FVAL <DLOCAL.SKILL_VAL>>', WHERE baseid='<STRTOUPPER <LOCAL.ITEM>>'"
				ELSE
					LDB.EXECUTE INSERT INTO 'craftmenu' (baseid, name, type, skill_key, skill_val) VALUES ('<STRTOUPPER <LOCAL.ITEM>>','<LOCAL.NAME>','<STRTOUPPER <SERV.ITEMDEF.<LOCAL.ITEM>.TYPE>>','<STRTOUPPER <LOCAL.SKILL_KEY>>','<FVAL <DLOCAL.SKILL_VAL>>')
				ENDIF
			ENDIF
		ENDFOR
	ENDIF
	LDB.EXECUTE COMMIT
	SERV.LOG Output done in <eval <serv.rticks>-<local.hour>> seconds.
	SERV.LIST.CRAFTITEMS.CLEAR
DB.CLOSE
ENDIF





