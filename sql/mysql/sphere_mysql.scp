

[FUNCTION Func_Mysql_Test]
SERV.MYSQL=0
SERV.MySqlHost=
SERV.MySqlUser=
SERV.MySqlPassword=
SERV.MySqlDatabase=
Serv.log [Mysql] Host=<SERV.MySqlHost>, Database=<SERV.MySqlDatabase>, User=<SERV.MySqlUser>, Password=<SERV.MySqlPassword>
DB.CONNECT
IF !(<DB.CONNECTED>)
	SERV.LOG [Mysql] Baglanti basarili! (<DB.CONNECTED>)
ELSE
	SERV.LOG [Mysql] Baglanti BASARISIZ. (<DB.CONNECTED>)
ENDIF
DB.CLOSE



[FUNCTION MysqlConnTest]
Func_Mysql_Set_State 1

IF !(<SERV.MYSQL>)
    serv.log [MySQL] KAPALI. (<SERV.MYSQL>)
ELSE
    serv.log [MySQL] ACIK. (<SERV.MYSQL>)
	db.connect
	if (<db.connected>)
		serv.log [MySQL] Bagli. (<db.connected>)
        DB.QUERY "SELECT id FROM sphere_accounts LIMIT 1"
        SERV.log Query success: <ddb.row.numrows>
		db.close
	ELSE
		serv.log [MySQL] Bagli Degil. (<db.connected>)
	ENDIF
ENDIF




[eof]
