	DOSWITCH (<DIR>)
	LOCAL.OK=<MOVE n>
	LOCAL.OK=<MOVE ne>
	LOCAL.OK=<MOVE e>
	LOCAL.OK=<MOVE se>
	LOCAL.OK=<MOVE s>
	LOCAL.OK=<MOVE sw>
	LOCAL.OK=<MOVE w>
	LOCAL.OK=<MOVE nw>
	ENDDO
	// IF (<LOCAL.OK>&08)
		// RETURN 1
	// ENDIF
ENDIF
DOSWITCH (<DIR>)
MOVE n <ARGS>
MOVE ne <ARGS>
MOVE e <ARGS>
MOVE se <ARGS>
MOVE s <ARGS>
MOVE sw <ARGS>
MOVE w <ARGS>
MOVE nw <ARGS>
ENDDO


