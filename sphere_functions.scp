VERSION=0.56T

[COMMENT sphere_functions]
Komutlar;
Logger = Herhangi bir nesne için veya bağımsız olarak özelleştirilmiş log komutu.
FUNC_GIVE_HITS_FIX = Hitsi direkt olarak + yapıldığında bazen bug olabiliyor, bu komutla verilebilir.



[FUNCTION Logger]
IF (<GETREFTYPE> == <def.tref_account> || <GETREFTYPE> == <def.tref_client> || <GETREFTYPE> == <def.tref_world> || <GETREFTYPE> == <def.tref_char> || <GETREFTYPE> == <def.tref_item> || <GETREFTYPE> == <def.tref_object>)
	
	// Item
	IF (<ISITEM>)
		LOCAL.OBJINFO = ItemLog - [BaseID=<BASEID>, Type=<TYPE>, Name=<NAME>, UID=<UID>, P=<P>, Region=<QVAL (<REGION>)?<REGION.NAME>:->, Topobj=<TOPOBJ>(<TOPOBJ.NAME>)]
		LOCAL.COLOR=<def.CTCOL_DEFAULT>
		CALL ContanerAllInsideLog 
	// Char
	ELSEIF (<ISCHAR>)
		IF (<ISPLAYER>)
			LOCAL.COLOR=<QVAL (<ACCOUNT.PLEVEL> == 1)?<def.CTCOL_YELLOW>:<DEF.CTCOL_CYAN>>
			LOCAL.OBJINFO <QVAL (<ACCOUNT.PLEVEL> == 1)?Player:Staff>Log - [Priv=<ACCOUNT.PLEVEL>, Account=<ACCOUNT>, Name=<NAME>, UID=<UID>, Region=<QVAL (<REGION>)?<REGION.NAME>/<P>:>, IP=<ACCOUNT.LASTIP>, PC=<ISPC>, ClientVersion=<REPORTEDCLIVER>]
		ELSE
			LOCAL.COLOR=<def.CTCOL_WHITE>
			LOCAL.OBJINFO NPCLog - [Name=<NAME>, UID=<UID>, Food=<FOOD>/<MAXFOOD>, Owner=<qval (<owner>)?<owner.NAME>:Yok>, Region=<QVAL (<REGION>)?<REGION.NAME>/<P>:>]
		ENDIF
	ENDIF
	
	SERV.LOG [<GETREFTYPE>] <LOCAL.OBJINFO> == <ARGS>
ELSE
	SERV.LOG [<GETREFTYPE>] <ARGS>
ENDIF






[FUNCTION ContanerAllInsideLog]
REF1=<UID>
IF (<REF1.ISCONT>)
	IF (<REF1.RESCOUNT> > 0)
		LOCAL.OBJINFO .= [Container Items / Rescont=<RESCOUNT>];
		FORCONT <UID> 99999999
			LOCAL.x ++
			LOCAL.OBJINFO .= * <DLOCAL.x>. BaseID=<BASEID>, Type=<TYPE>, Name=<NAME>, UID=<UID> , 
		ENDFOR
		LOCAL.OBJINFO .= ]
	ENDIF
ENDIF





[Function SetProcessDelay]
// IF !(<ISGM>)
	IF (<TAG0.<ARGV0>.Delay> > <SERV.TIME>)
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, You must wait to perform another action. (<f_stonesys_determine_timeleft <TAG0.<ARGV0>.DELAY>>)
		RETURN 1
	ENDIF
	TAG0.<ARGV0>.DELAY = <EVAL <SERV.TIME>+<ARGV1>>
// ENDIF





[FUNCTION FUNC_GIVE_HITS_FIX]
IF (<HITS> >= <STR>)
	HITS=<STR>
ENDIF
IF (<HITS> < <STR>)
	LOCAL.HITS=<ARGS>
	HITS +=<DLOCAL.HITS>
	IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.HITS> Hits"
	ENDIF
ELSE
	HITS=<STR>
ENDIF

IF (<HITS> >= <STR>)
	HITS=<STR>
ENDIF


[FUNCTION FUNC_GIVE_MANA_FIX]
IF (<MANA> >= <INT>)
	MANA=<INT>
ENDIF
IF (<MANA> < <INT>)
	LOCAL.MANA=<ARGS>
	MANA +=<DLOCAL.MANA>
	// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.MANA> Mana"
ELSE
	MANA=<INT>
ENDIF
IF (<MANA> >= <INT>)
	MANA=<INT>
ENDIF



[FUNCTION FUNC_GIVE_STAM_FIX]
IF (<STAM> >= <DEX>)
	STAM=<DEX>
ENDIF
IF (<STAM> < <DEX>)
	LOCAL.STAM=<ARGS>
	STAM +=<DLOCAL.STAM>
	// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.STAM> Stam"
ELSE
	STAM=<DEX>
ENDIF
IF (<STAM> >= <DEX>)
	STAM=<DEX>
ENDIF





// TAKE STAT

[FUNCTION FUNC_TAKE_HITS_FIX]
IF (<HITS> >= 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	IF (<HITS> <= <DLOCAL.DROP>)
		HITS 0
	ELSE
		HITS -=<DLOCAL.DROP>
	ENDIF
	IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, "-<DLOCAL.DROP> Hits"
	ENDIF
ENDIF


[FUNCTION FUNC_TAKE_MANA_FIX]
IF (<MANA> > 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	
	IF (<MANA> <= <DLOCAL.DROP>)
		MANA 0
	ELSE
		MANA -=<DLOCAL.DROP>
	ENDIF
	
	// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, "-<DLOCAL.DROP> Mana"
ENDIF

[FUNCTION FUNC_TAKE_STAM_FIX]
IF (<STAM> > 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	IF (<STAM> <= <DLOCAL.DROP>)
		STAM 0
	ELSE
		STAM -=<DLOCAL.DROP>
	ENDIF
	IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,"-<DLOCAL.DROP> Stam"
	ENDIF
ENDIF










[FUNCTION TARGKAPAT]
IF (<ISONLINE>)
	// TARGETCLOSE
	SENDPACKET 06c 00 D(00) 03 D(00) W(00) W(00) 00 00 W(00)
	SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Hedef zorla kapatildi.
ENDIF




/// Custom Openbank Function
[FUNCTION OPENBANK]
IF (<FLAGS>&statf_dead)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // Ölü durumdayken bu işlemi yapamazsınız.
	RETURN 1
ELSEIF (<FLAGS>&statf_freeze)
	SYSMESSAGELOC <def.tcolor_red>,600029 // "Freeze durumdayken bu işlemi yapamazsınız."
	RETURN 1
// ELSEIF (<SRC.FLAGS>&statf_invisible) || (<SRC.FLAGS>&statf_insubstantial) || (<SRC.FLAGS>&statf_hidden)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,600039 // "Görünmez durumdayken bu işlemi yapamazsınız."
	// RETURN 1
ELSEIF (<FLAGS>&statf_stone)
	SYSMESSAGELOC <def.tcolor_red>,600028 // "Stone durumdayken bu işlemi yapamazsınız."
	RETURN 1
// ELSEIF (<SRC.ISPOISONED>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // Zehirli durumdayken bu işlemi yapamazsınız.
	// RETURN 1
// ELSEIF (<SRC.IsYarali>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,600075 // "Yaralı durumdayken bu işlemi yapamazsınız."
	// RETURN 1
ENDIF

IF !(<SERV.BANKMAXWEIGHT> == -1)
	IF (<EVAL (<FINDLAYER(LAYER_BANKBOX).WEIGHT> / 10)> >= <SERV.BANKMAXWEIGHT>)
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Dikkat! Banka kasanızın toplam ağırlığı <SERV.BANKMAXWEIGHT> eşyayı geçmiş, hareket ettirdiğiniz bir eşyayı geri koyamazsınız.
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Lütfen dikkatli olunuz! Kaybolan eşyalarınızın sorumluluğu size aittir.
		LOGGER Banka agirligi maximum seviyede.
	ENDIF
ENDIF
IF !(<SERV.BankMaxItems> == -1)
	IF (<FINDLAYER(LAYER_BANKBOX).RESCOUNT> >= <SERV.BankMaxItems>)
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Dikkat! Banka kasanızın toplam esya kapasitesi <SERV.BankMaxItems> eşyayı geçmiş, hareket ettirdiğiniz bir eşyayı geri koyamazsınız.
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Lütfen dikkatli olunuz! Kaybolan eşyalarınızın sorumluluğu size aittir.
		LOGGER Banka esya kapasitesi maximum seviyede.
	ENDIF
ENDIF
FORCONT <FINDLAYER.29> 9999
	LOCAL.BANKITEMS ++
	LOCAL.BANKWEIGHT +=<WEIGHT>
ENDFOR
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Banka ağırlığı : <FVAL <DLOCAL.BANKWEIGHT>>/<QVAL (<SERV.BANKMAXWEIGHT> == -1)?Sinirsiz:<SERV.BANKMAXWEIGHT>>
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Eşya sayısı : <BolukAyir <DLOCAL.BANKITEMS>>/<QVAL (<SERV.BankMaxItems> == -1)?Sinirsiz:<SERV.BankMaxItems>>
BANKSELF
RETURN 1


[FUNCTION BolukAyir]
IF (<EVAL STRLEN(<ARGS>)> > 3)
LOCAL.CURRENTDIGIT=<EVAL STRLEN(<ARGS>)>
	WHILE (<LOCAL.CURRENTDIGIT> > 3)
	   ARGS = <STRSUB 0 <EVAL <dLOCAL.CURRENTDIGIT>-3> <ARGS>>.<STRSUB <EVAL <LOCAL.CURRENTDIGIT> - 3> 9999 <ARGS>>
	   LOCAL.CURRENTDIGIT -=3
	ENDWHILE
ENDIF
RETURN <ARGS>


//
[FUNCTION Pack_Counter]
IF (<FINDLAYER.LAYER_PACK>)
	FORCONT <FINDLAYER.LAYER_PACK.UID> 9999
		IF (<BASEID> == <ARGV0>)
			LOCAL.ADET +=<AMOUNT>
		ENDIF
	ENDFOR
ENDIF
RETURN <DLOCAL.ADET>


[FUNCTION Bank_Counter]
IF (<FINDLAYER.layer_bankbox>)
	FORCONT <FINDLAYER.layer_bankbox.UID> 9999
		IF (<BASEID> == <ARGV0>)
			LOCAL.ADET +=<AMOUNT>
		ENDIF
	ENDFOR

ENDIF
RETURN <DLOCAL.ADET>


[FUNCTION PackBank_Counter]
IF (<FINDLAYER.layer_bankbox>)
	FORCONT <FINDLAYER.layer_bankbox.UID> 9999
		IF (<BASEID> == <ARGV0>)
			LOCAL.ADET +=<AMOUNT>
		ENDIF
	ENDFOR
ENDIF
IF (<FINDLAYER.LAYER_PACK>)
	FORCONT <FINDLAYER.LAYER_PACK.UID> 9999
		IF (<BASEID> == <ARGV0>)
			LOCAL.ADET +=<AMOUNT>
		ENDIF
	ENDFOR
ENDIF
RETURN <DLOCAL.ADET>




// Pack & Bank Item Remover
// Use I.PACKBANK_REMOVER i_gold
[FUNCTION PACKBANK_REMOVER]
// Pack
Pack_Remover <args>

// Bank
Bank_Remover <args>

// Layers
Layer_Remover <args>



// Layer Item Remover
// Use I.Layer_Remover i_robe
[FUNCTION Layer_Remover]
// Layers
FOR 1 54
	IF (<FINDLAYER.<DLOCAL._FOR>>)
	REF3=<FINDLAYER.<DLOCAL._FOR>.UID>
		IF (<REF3.DISPID>==<ARGS>) || (<REF3.BASEID>==<ARGS>)
			REF3.REMOVE
		ENDIF
	ENDIF
ENDFOR


// Pack & Bank Item Remover
// Use I.PACKBANK_REMOVER i_gold
[FUNCTION Pack_Remover]
// Pack
FORCONT <FINDLAYER.21> 9999
REF1=<UID>
	IF (<REF1.DISPID>==<ARGS>) || (<REF1.BASEID>==<ARGS>)
		REF1.REMOVE
	ENDIF
ENDFOR


[FUNCTION Bank_Remover]
// Bank
FORCONT <FINDLAYER.29> 9999
REF2=<UID>
	IF (<REF2.DISPID>==<ARGS>) || (<REF2.BASEID>==<ARGS>)
		REF2.REMOVE
	ENDIF
ENDFOR




// Full Stats Function
[FUNCTION FUNC_FULLSTATS]
HITS <STR>
MANA <INT>
STAM <DEX>
FUNC_Cure


[FUNCTION FUNC_Cure]
IF (<FINDID.I_RUNE_POISON_FIELD>)
	LOCAL.POISON ++
ENDIF
IF (<FLAGS>&statf_poisoned)
	LOCAL.POISON ++
ENDIF
IF (<FINDID.I_RUNE_POISON>)
	LOCAL.POISON ++
ENDIF

IF (<LOCAL.POISON>)
	FLAGS <FLAGS>&~statf_poisoned
	
	IF (<FINDID.I_RUNE_POISON>)
		FINDID.I_RUNE_POISON.REMOVE
	ENDIF
	
	IF (<FINDID.I_RUNE_POISON_FIELD>)
		FINDID.I_RUNE_POISON_FIELD.REMOVE
	ENDIF
	
	SOUND SND_SPELL_CURE
	EFFECT 3,0376A,1,30,1
	// CURE <args>
ENDIF







[FUNCTION FlagDel]
FLAGS &= ~<args>

[FUNCTION FlagAdd]
FLAGS |= <args>

[FUNCTION FlagToggle]
IF (<FLAGS>&<ARGS>)
	FLAGS &= ~<args>
ELSE
	FLAGS |= <args>
ENDIF


[FUNCTION CustomMemDel_Force]
FORCHARMEMORYTYPE <args>
	REMOVE
ENDFOR



// Custom Peace Mode Function
[FUNCTION FUNC_PEACEMODE]
IF (<ISCHAR>)
	IF (<ISPLAYER>)
		TARGKAPAT

		CustomMemDel_Force memory_iaggressor
		CustomMemDel_Force memory_harmedby
		CustomMemDel_Force memory_irritatedby
		CustomMemDel_Force memory_aggreived
		CustomMemDel_Force memory_war_targ	
		CustomMemDel_Force memory_fight	
		
		ACTION -1
		FUNC_WARMODE 0
		ATTACKER.CLEAR
		SKILL FAIL	
	ENDIF
ENDIF


[FUNCTION ActLogla]
// SERV.LOG ACT: <ACT>
// SERV.LOG ACTARG1: <dACTARG1>
// SERV.LOG ACTARG2: <dACTARG2>
// SERV.LOG ACTARG3: <dACTARG3>
// SERV.LOG ACTPRV: <ACTPRV>
// SERV.LOG ACTP: <ACTP>
// SERV.LOG ACTION: <ACTION>
// SERV.LOG ACTDIFF: <ACTDIFF>
// SERV.LOG ActPri: <ActPri>

SYSMESSAGE @,,1,1 ----------------
SYSMESSAGE @,,1,1 ACT: <ACT> <qval (<act.isvalid>) ? [<ACT.NAME>] : >
SYSMESSAGE @,,1,1 ACTARG1: <dACTARG1>
SYSMESSAGE @,,1,1 ACTARG2: <dACTARG2>
SYSMESSAGE @,,1,1 ACTARG3: <dACTARG3>
REF1=<ACTPRV>

SYSMESSAGE @,,1,1 ACTPRV: <REF1> <QVAL (<REF1.ISVALID>) ? [<REF1.NAME>] : >
SYSMESSAGE @,,1,1 ACTP: <ACTP>
SYSMESSAGE @,,1,1 ACTION: <ACTION>
SYSMESSAGE @,,1,1 ACTIONEFFECT: <ACTIONEFFECT>
SYSMESSAGE @,,1,1 ACTDIFF: <ACTDIFF>

IF (<ISONLINE> && <ISPLAYER>)
	SYSMESSAGE @,,1,1 Targ: <TARG> <qval (<Targ>) ? [<Targ.NAME>] : >
	SYSMESSAGE @,,1,1 TargP: <TargP>
ENDIF

SYSMESSAGE @,,1,1 ActPri: <ActPri>



[FUNCTION FUNC_ORDERSET]
LOCAL.TAG=<ARGV[0]>
IF (<ISCHAR>)
	IF (STRMATCH(*ASC*,<CTAG0.<LOCAL.TAG>>)) || (STRMATCH(*ASC*,<TAG0.<LOCAL.TAG>>))
		SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Artan
		RETURN DESC
	ELSE
		SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Azalan
		RETURN ASC
	ENDIF
ELSE
	IF STRMATCH(*ASC*,<TAG0.<LOCAL.TAG>>)
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Artan
		RETURN DESC
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Azalan
		RETURN ASC
	ENDIF
ENDIF

[FUNCTION FUNC_STATFIX]
SPELLEFFECT S_DISPEL,100.0,0,<UID>
IF (<FINDLAYER.layer_spell_stats>)
	FINDLAYER.layer_spell_stats.REMOVE
ENDIF
IF (<FINDLAYER.layer_flag_potion>)
	FINDLAYER.layer_flag_potion.REMOVE
ENDIF

IF (<FINDLAYER.layer_flag_drunk>)
	FINDLAYER.layer_flag_drunk.REMOVE
ENDIF
TARGKAPAT
// EVENTS +E_STAT // .ini de zaten var
MODDEX=0
MODINT=0
MODSTR=0
OSTR=<ARGV[0]>
ODEX=<ARGV[1]>
OINT=<ARGV[2]>
STR = <OSTR>
DEX = <ODEX>
INT = <OINT>
MAXHITS=
MAXSTAM=
MAXMANA=
IF (<HITS> >= <STR>)
	HITS=<EVAL <STR>/2>
ENDIF
IF (<STAM> >= <DEX>)
	STAM=<EVAL <DEX>/2>
ENDIF
IF (<MANA> >= <INT>)
	MANA=<EVAL <INT>/2>
ENDIF
STATLOCK[1] 2
STATLOCK[2] 2
STATLOCK[0] 2
UPDATE




[PLEVEL 2]
S
SC


[FUNCTION S]
FUNC_Staff_Chat <ARGS>

[FUNCTION SC]
FUNC_Staff_Chat <ARGS>


[FUNCTION FUNC_Staff_Chat]
IF (<ISEMPTY <ARGS>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600011 // "Boş giriş yapamazsınız."
	RETURN 1
ENDIF
IF (0<ACCOUNT.PLEVEL> > 1)
	SERV.ALLCLIENTS Func_Staff_To_Staff_Chat [Yetkili] <SRC.NAME> : <ARGS>
ENDIF

[FUNCTION Func_Staff_To_Staff_Chat]
IF (<ACCOUNT.PLEVEL> > 1)
	SYSMESSAGE @035,,1,1 <ARGS>
ENDIF


[FUNCTION Func_Player_To_Staff_Chat]
IF (<ACCOUNT.PLEVEL> > 1)
	SYSMESSAGE @037,,1,1 <ARGS>
ENDIF



[FUNCTION GIT]
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
IF (<SERV.ACCOUNT.<DLOCAL._for>>)
	LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL._for>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>)
			FOR CHARS 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.CHARS>.UID>
				IF (STRMATCH('<ARGS>','<REF1.NAME>'))
					SRC.GO <REF1.P>
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR





[FUNCTION GETNAME]
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
	IF (<SERV.ACCOUNT.<DLOCAL._FOR>>)
		LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL._FOR>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS> > 1)
			FOR CHARS 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.CHARS>.UID>
				IF (STRMATCH('<ARGS>','<REF1.NAME>'))
					REF1.GO <SRC.P>
					SRC.UPDATE
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR




[FUNCTION GITACC]
IF (<SERV.ACCOUNT.<ARGS>>)
REF1=<SERV.ACCOUNT.<ARGS>.CHAR.0.UID>
	IF (<REF1.ISPLAYER>)
		SRC.GO <REF1.P>
	ENDIF
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,3000033 // Hesap bulunamadi! Sunucuya boyle bir hespa kayitli degil.
ENDIF




[FUNCTION GETACCSOLO]
IF (<SERV.ACCOUNT.<ARGS>>)
REF1=<SERV.ACCOUNT.<ARGS>.CHAR.0.UID>
	IF (<REF1.ISPLAYER>)
		REF1.GO <SRC.P>
	ENDIF
ELSE
	//SRC.SYSMESSAGE @38,,1,1 Hesap bulunamadi! Sunucuya boyle bir hespa kayitli degil.
	SRC.SYSMESSAGELOC <def.tcolor_red>,3000033 // Hesap bulunamadi! Sunucuya boyle bir hespa kayitli degil.
ENDIF


[FUNCTION GOCLIENT]
IF (0<CTAG.NEXTCLI> > <HVAL <SERV.CLIENTS>-1>) || !(<ISEMPTY <ARGS>>)
CTAG.NEXTCLI
ENDIF
GOCLI 0<CTAG.NEXTCLI>
CTAG.NEXTCLI=<HVAL 0<CTAG.NEXTCLI>+1>


[FUNCTION GOCLIENT_PREV]
IF (0<CTAG.NEXTCLI> > <HVAL <SERV.CLIENTS>-1>) || !(<ISEMPTY <ARGS>>)
CTAG.NEXTCLI
ENDIF
GOCLI 0<CTAG.NEXTCLI>
CTAG.NEXTCLI=<HVAL 0<CTAG.NEXTCLI>-1>



[FUNCTION GETUID]
IF (STRMATCH('','<ARGS>'))
RETURN 1
ENDIF
REF1=<ARGS>
IF (<REF1>)
	IF (<REF1.ISITEM>)
		REF1.P <SRC.P>
	ELSEIF (<REF1.ISCHAR>)
		// REF1.MOVETO <SRC.P>
		REF1.GO <SRC.P>
		REF1.UPDATE
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu seri numarasında herhangi bir nesne/obje yok.
	ENDIF
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu seri numarasında herhangi bir nesne/obje yok.
ENDIF



[FUNCTION GOGUILD]
FORINSTANCES i_guild_stone
	IF (STRMATCH('<ARGS>','<NAME>'))
		REF1=<UID>
		SRC.GOUID <REF1>
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu isimde guild bulunamadı!
		RETURN 1
	ENDIF
ENDFOR



[PLEVEL 4]
GOACC
GETACC

[FUNCTION GOACC]
IF !(<SERV.ACCOUNT.<ARGS>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3000033 // Hesap bulunamadi! Sunucuya boyle bir hespa kayitli degil.
	RETURN 1
ENDIF
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
	LOCAL.ACCOUNT=<SERV.ACCOUNT.<DLOCAL._FOR>.NAME>
	IF (STRMATCH('<ARGS>','<LOCAL.ACCOUNT>'))
		REF1=<SERV.ACCOUNT.<DLOCAL._FOR>.CHAR.0>
		SRC.GO <REF1.P>
	ENDIF
ENDFOR




[FUNCTION GETACC]
IF !(<SERV.ACCOUNT.<ARGS>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3000033 // Hesap bulunamadi! Sunucuya boyle bir hespa kayitli degil.
	RETURN 1
ENDIF
FOR acc 0 <EVAL <SERV.ACCOUNTS>-1>
	LOCAL.ACCOUNT=<SERV.ACCOUNT.<DLOCAL.acc>.NAME>
	IF (STRMATCH('<ARGS>','<LOCAL.ACCOUNT>'))
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Chars: <SERV.ACCOUNT.<DLOCAL.acc>.CHARS>
		FOR chars 0 <EVAL <SERV.ACCOUNT.<DLOCAL.acc>.CHARS>-1>
			REF1=<SERV.ACCOUNT.<DLOCAL.acc>.CHAR.<dlocal.chars>>
			IF (<REF1.ISPLAYER>)
				SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <eval <dlocal.chars>+1>.<REF1.NAME>
				REF1.GO <SRC.P>
				REF1.UPDATE
			ENDIF
		ENDFOR
	ENDIF
ENDFOR







[PLEVEL 2]
GETIR

[FUNCTION GETIR]
SRC.TARGETF F_SUMMONTO
src.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Yanınıza getirmek istediğiniz varlığı veya eşyayı seçiniz.

[FUNCTION F_SUMMONTO]
IF (<ARGO>)
	IF (<ARGO.UID> == <SRC.UID>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600088 // "Kendinizi seçemezsiniz."
		SRC.TARGETF F_SUMMONTO
	ENDIF

	IF (<ARGO.ISITEM>)
		ARGO.P <SRC.P>
		SRC.TARGETF F_SUMMONTO
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <argo.name> isimli esya yaniniza geldi.
	ENDIF

	IF (<ARGO.ISCHAR>)
		ARGO.GO <SRC.P>
		SRC.TARGETF F_SUMMONTO
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <argo.name> isimli varlik yaniniza geldi.
	ENDIF
ENDIF







[FUNCTION RESKILL]
SRC.TARGETF F_RESKILL

[FUNCTION F_RESKILL]
IF (<ARGO.FLAGS>&STATF_DEAD)
	ARGO.RESURRECT 1
	ARGO.HITS=<ARGO.STR>
	SRC.RESKILL
ELSE
	// ARGO.DAMAGE 9999
	ARGO.HITS=0
	SRC.RESKILL
ENDIF


[PLEVEL 2]
GOTUR

[FUNCTION GOTUR]
SRC.TARGETF FUNC_GOTUR_SELECT_OBJ
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Başka yere götürmek istediğiniz varlığı veya eşyayı seçiniz.
RETURN 1

[FUNCTION FUNC_GOTUR_SELECT_OBJ]
REF1=<ARGO>

IF !(<ARGO>)
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bir eşya veya varlık seçiniz.
SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
RETURN 1
ENDIF

SRC.CTAG0.GOTUR_OBJ <REF1>
SRC.TARGETFG FUNC_GOTUR_SELECT_P
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Götürmek istediğiniz <qval (<ref1.isitem>)?eşya:varlık> seçildi. Şimdi götürmek istediğiniz yeri seçiniz.
 

[FUNCTION FUNC_GOTUR_SELECT_P]
REF1=<SRC.CTAG0.GOTUR_OBJ>

IF !(<REF1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,SYSMESSAGELOC <def.tcolor_red>,600022 // Bir hata oluştu!
	SRC.SYSMESSAGELOC <def.tcolor_red>,SYSMESSAGELOC <def.tcolor_red>,600052 // Nesne sunucuda kayıtlı değil/bulunamadı!
	SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
RETURN 1
ENDIF

IF (<REF1>)

	IF (<REF1.ISITEM>)
		REF1.P <SRC.TARGP>
	ELSE
		REF1.GO <SRC.TARGP>
	ENDIF

	SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <REF1.NAME>: <SRC.TARGP.X>-<SRC.TARGP.Y>-<SRC.TARGP.Z>-<SRC.TARGP.M> yerine götürüldü!
	SRC.CTAG0.GOTUR_OBJ=
	SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
ELSE
SRC.SYSMESSAGELOC <def.tcolor_red>,600021 // Hatalı seçim/hedef.
ENDIF




[PLEVEL 2]
BAGLA

[FUNCTION BAGLA]
TARGETF F_BAGLAC_TELEPAD
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Baglamak istediginiz Teleporteri seçiniz.
RETURN 1


[FUNCTION F_BAGLAC_TELEPAD]
IF !(<ARGO>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece telepadi baglayabilirsiniz.
	RETURN 1
ELSEIF !(<ARGO.ISITEM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece telepadi baglayabilirsiniz.
	RETURN 1
ENDIF

IF (<ARGO.TYPE> == T_TELEPAD)
	SRC.CLEARCTAGS BAGLA_TELEPORTERS
	
	FORITEMS 7168
		IF (<TYPE> == T_TELEPAD) && (<MOREX> <= 0)
			SRC.CTAG0.BAGLA_TELEPORTERS ++
			SRC.CTAG0.BAGLA_TELEPORTERS.<SRC.dCTAG0.BAGLA_TELEPORTERS> <UID>
		ENDIF
	ENDFOR
	
	SRC.TARGETFG F_BAGLAC_YER <ARGO>
	
	IF (<SRC.DCTAG0.BAGLA_TELEPORTERS> > 0)
		DIALOGCLOSE D_BAGLA_TELEPAD_LIST
		ARGO.DIALOG D_BAGLA_TELEPAD_LIST
	ENDIF
	
	
	SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Baglamak istediginiz yeri seçiniz. (<argo.name>)	
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Telepad tipi eşyalara koordinat verebilirsin.
	RETURN 1
ENDIF
RETURN 1

 
[DIALOG D_BAGLA_TELEPAD_LIST]
<DEF.dlgstartpos>

RESIZE 0,0,580,400,Sunucudaki Hiç Bağlanmamış Geçitler (<SRC.DCTAG0.BAGLA_TELEPORTERS>) / <NAME> (<UID>)

DORIGIN 20 50

IF (<SRC.DCTAG0.BAGLA_TELEPORTERS> > 0)
	FOR <SRC.DCTAG0.BAGLA_TELEPORTERS>
		REF1=<SRC.CTAG0.BAGLA_TELEPORTERS.<DLOCAL._FOR>>
		IF (<REF1.ISVALIDE>)
			IF (<REF1.TYPE> == T_TELEPAD) && (<REF1.MOREX> <= 0)
				TILEPICHUE +0 <eval (<dlocal._for>*45)+20> <REF1.DISPIDDEC> <EVAL <REF1.COLOR> &~ 08000|04000>
				DTEXT +50 <eval (<dlocal._for>*45)+25> <EVAL <REF1.COLOR> &~ 08000|04000> <REF1.NAME>
				DTEXT +50 <eval (<dlocal._for>*45)+40> <EVAL <REF1.COLOR> &~ 08000|04000> <ref1> <qval (<ref1> == <uid>) ? [Bu Teleporter] : >
				
				DTEXT +245 <eval (<dlocal._for>*45)+25> <EVAL <REF1.COLOR> &~ 08000|04000> <REF1.REGION.NAME> (<REF1.P>)
				
				BUTTON +420 <eval (<dlocal._for>*45)+25> 4006 4007 1 0 <eval (<dlocal._for>)+100>
				DTEXT +450 <eval (<dlocal._for>*45)+25> 0 Git
				IF (<REF1> != <UID>)
					BUTTON +480 <eval (<dlocal._for>*45)+25> 0845 0846 1 0 <eval (<dlocal._for>)+1000>
					DTEXT +500 <eval (<dlocal._for>*45)+25> 044 Bağla
				ENDIF
			ENDIF
		ENDIF
	ENDFOR
ELSE

DTEXT +0 +0 38 World üzerinde bağlı olmayan teleporter yok.
ENDIF

[DIALOG D_BAGLA_TELEPAD_LIST button]
ON=100 999
REF1=<SRC.CTAG0.BAGLA_TELEPORTERS.<EVAL <ARGN>-100>>
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGE @38,,1,1 Teleporter bulunamadı!
	RETURN 1
ENDIF
SRC.GOUID <REF1>


ON=1000 1999
REF1=<SRC.CTAG0.BAGLA_TELEPORTERS.<EVAL <ARGN>-1000>>
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGE @38,,1,1 Teleporter bulunamadı!
	RETURN 1
ENDIF
REF1.MOREP <P>
MOREP <REF1.P>
SRC.SYSMESSAGE Iki teleporter birbirine baglandi.



ON=0
// SRC.CLEARCTAGS BAGLA_TELEPORTERS



 
[FUNCTION F_BAGLAC_YER]
REF1=<ARGS>
SRC.SYSMESSAGE <REF1.P>
IF (<REF1>)
	IF (<EVAL <TARGP>> == <EVAL <REF1.P>>)
		SRC.SYSMESSAGE @38,,1,1 Aynı yere bağlayamazsınız.
		RETURN 1
	ENDIF

	SRC.SYSMESSAGE @,,1,1 Baglanan yer : <SRC.TARGP>
	REF1.MOREP <SRC.TARGP>
ENDIF







[FUNCTION FUNC_ISIM_KONTROL]
IF (<FINDID.I_RUNE_INCOGNITO>)
	FINDID.I_RUNE_INCOGNITO.REMOVE
ENDIF
IF (STRLEN(<ARGS>) > 16) || (STRLEN(<ARGS>) < 2)
	LOCAL.NAME_BAD_LEN ++
ENDIF
IF (<ISFORBIDSTRING <ARGS>>)
	LOCAL.NAME_BAD_FORBIDDEN ++
ENDIF
LOCAL.CHAR=<ASC <ARGS>>
IF ( (STRMATCH('41*,'<LOCAL.CHAR>')) || (STRMATCH(*03d*,'<LOCAL.CHAR>')) || (STRMATCH(*02c*,'<LOCAL.CHAR>')) || (STRMATCH(*02e*,'<LOCAL.CHAR>')) || (STRMATCH(*021*,'<LOCAL.CHAR>')) || (STRMATCH(*05e*,'<LOCAL.CHAR>')) || (STRMATCH(*02b*,'<LOCAL.CHAR>')) || (STRMATCH(*025*,'<LOCAL.CHAR>')) || (STRMATCH(*026*,'<LOCAL.CHAR>')) || (STRMATCH(*028*,'<LOCAL.CHAR>')) || (STRMATCH(*029*,'<LOCAL.CHAR>')) || (STRMATCH(*03f*,'<LOCAL.CHAR>')) || (STRMATCH(*03e*,'<LOCAL.CHAR>')) || (STRMATCH(*03c*,'<LOCAL.CHAR>')) || (STRMATCH(*023*,'<LOCAL.CHAR>')) || (STRMATCH(*07b*,'<LOCAL.CHAR>')) || (STRMATCH(*05b*,'<LOCAL.CHAR>')) || (STRMATCH(*05d*,'<LOCAL.CHAR>')) || (STRMATCH(*07d*,'<LOCAL.CHAR>')) || (STRMATCH(*05c*,'<LOCAL.CHAR>')) || (STRMATCH(*07c*,'<LOCAL.CHAR>')) )
	LOCAL.NAME_BAD_CHAR ++
ENDIF
IF !(<ISSTRING <ARGS>>)
	LOCAL.NAME_BAD_CHAR ++
ENDIF
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
IF (<SERV.ACCOUNT.<DLOCAL._for>>)
	LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL._for>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>)
			FOR CHARS 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.CHARS>.UID>
				IF !(<REF1> == <UID>) && (STRMATCH('<REF1.NAME>','<ARGS>'))
					LOCAL.NAME_DUPE ++
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR
IF (<DLOCAL.NAME_BAD_LEN>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz EN AZ 2 EN FAZLA 16 karakter olmalıdır.
ENDIF
IF (<DLOCAL.NAME_BAD_FORBIDDEN>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz içeriğinde argo veya yasaklı kelimeler bulunuyor.
ENDIF	
IF (<DLOCAL.NAME_BAD_CHAR>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminizde yalnızca alfabetik karakter kullanabilirsiniz.
ENDIF		
IF (<DLOCAL.NAME_DUPE>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu isimden sunucuda bulunuyor.
ENDIF
LOCAL.RESPONSE <EVAL <DLOCAL.NAME_BAD_LEN> + <DLOCAL.NAME_BAD_FORBIDDEN> + <DLOCAL.NAME_BAD_CHAR> + <DLOCAL.NAME_DUPE>>
IF (<DLOCAL.RESPONSE>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz hatalıdır, Otomatik olarak değiştirilmiştir. (<NAME>)
	NAME #NAMES_HUMAN<IsGenderName>
	DIALOGCLOSE D_RENAME_CHAR
	DIALOG D_RENAME_CHAR
ENDIF



[DIALOG D_RENAME_CHAR]
<DEF.dlgstartpos>
IF !(<SRC.CTAG0.RENAMEDEED>)
	NOCLOSE
ENDIF

RESIZE 0,0,390,200
DORIGIN 20 20
DHTMLGUMP +0 +0 350 120 1 1 Adınız en az 2 ve en fazla 16 karakterden oluşabilir. Alfabetik karakterleri ve özel karakter olarak yalnızca kesme işareti kullanabilirsiniz. Hakaret veya küfür içerikli olmamalıdır. Adınız sunucu veya yöneticilerinden herhangi birinin isimlerini içermemelidir. Adınızda boşluk kullanamazsınız. Kurulumda türkçe karakter (ş-ç-ı-ğ) kullanmayınız.

RESIZEPIC +0 +130 3000 160 30 
DTEXTENTRYLIMITED +5 +135 160 25 0 1 16

BUTTON +180 +135 4006 4007  1 0 1
DTEXT +210 +135 044 Tamamla

[DIALOG D_RENAME_CHAR BUTTON]
ON=1
REF1=<SRC.CTAG0.RENAMEDEED>
IF (<SRC.CTAG0.RENAMEDEED>)
	IF !(<SRC.ISINPACK <REF1>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<REF1.NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
		RETURN 1
	ENDIF
ENDIF
CALL FUNC_ISIM_KONTROL <ARGTXT[1]>
IF (<DLOCAL.RESPONSE>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsim değişikliği başarısız oldu. Bazı hatalar tespit edildi.
	RETURN 1
ENDIF

LOCAL.NAME <STRARG <STRTOUPPER(<STRSUB 0 1 <ARGTXT[1]>>)><STRTOLOWER(<STRSUB 1 16 <ARGTXT[1]>>)>>
SRC.NAME <STRTRIM <LOCAL.NAME>>
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>,İsminiz <SRC.NAME> olarak değiştirilmiştir.

// IF (<REF1.ISVALIDE>) && (<REF1.BASEID> == I_DEED_RENAME)
	// REF1.REMOVE
