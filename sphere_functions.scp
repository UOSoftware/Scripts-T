[function f_oncommand]
IF (<ARGN>)

	// PLEVEL = General
	IF (STRMATCH(*MySQL*,'<args>'))
		SRC.SYSMESSAGELOC <def.tcolor_red>,600115 // "Hatalı komut."
		RETURN 1
	ENDIF
	
	// PLEVEL = Player
	IF (<SRC.ACCOUNT.PLEVEL> == 1)
		IF !( (STRMATCH(*gc*,'<ARGS>')) || (STRMATCH('gon','<ARGS>')) || (STRMATCH('gonline','<ARGS>')) )
			IF (<SRC.CTAG0.Cmd.Delay> > <SERV.TIME>)
				// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, [Command] <defmsg.skillwait_3>: (<f_stonesys_determine_timeleft <SRC.CTAG0.Cmd.Delay>>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, [Command] <defmsg.skillwait_3>
				RETURN 1
			ENDIF
			// IF (<SERV.CommandLog> == 0)
				// SRC.Logger [Komut]'<ARGS>'=<ARGN>
			// ENDIF
			SRC.CTAG0.Cmd.Delay=<EVAL <SERV.TIME>+4>
		ENDIF
	ENDIF
	
	// PLEVEL =STAFF
	IF (<SRC.ACCOUNT.PLEVEL> > 1)
	
		IF ( (STRMATCH('REMOVE','<ARGS>')) || (STRMATCH('DESTROY','<ARGS>')) )
			SRC.TARGETF FUNC_TARGETF_REMOVE
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, What item or char do you want to remove?
			RETURN 1
			
		// ELSEIF (STRMATCH('JAIL','<ARGS>'))
			// SRC.HAPIS
			// RETURN 1
			
		ELSEIF (STRMATCH('BLOCK','<ARGS>')) || (STRMATCH('kick','<ARGS>')) 
			// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu komutlar kapalıdır.
			// SRC.TARGETF Func_BLOCKER_TARGET_PLAYER
			// SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Kimi bloke etmek istiyorsunuz?
			RETURN 1
			
		ELSEIF (STRMATCH('FLIP','<ARGS>'))
			SRC.TARGETF FUNC_TARGETF_FLIP
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, What item or char do you want to flip?
			RETURN 1
			
		ELSEIF (STRMATCH('MTELE','<ARGS>'))
			SRC.TARGETFG FUNC_TELE
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <defmsg.select_magic_target>
			RETURN 1		
		ENDIF		
	ENDIF
	
	
ENDIF




//  Custom Flip Function
[FUNCTION FUNC_TARGETF_FLIP]
REF1=<ARGO>
IF (<REF1>)
	REF1.FLIP
	SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, Flipped: <REF1.NAME>
	SRC.TARGETF FUNC_TARGETF_FLIP
ELSE
	RETURN 1
ENDIF



[FUNCTION FUNC_TARGETF_REMOVE]
IF !(<ARGO>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600020 //"Hatalı seçim/hedef."
	RETURN 1
ENDIF
IF (<SRC.ACCOUNT.PLEVEL> < 7)
	IF (<ARGO.TAG0.SILINMEZ>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu nesne silinmez.
		SRC.TARGETF FUNC_TARGETF_REMOVE
		RETURN 1
	ENDIF
ENDIF
	
IF (<ARGO.ISCHAR>)

	IF (<ARGO.ISPLAYER>)
		// ARGO.FUNC_REMOVE_PLAYER
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Oyuncular bu şekilde silinemez.
		RETURN 1
	ELSE
		ARGO.FUNC_REMOVE_CHAR
	ENDIF

ELSEIF (<ARGO.ISITEM>)
	// IF ((<ARGO.TAG0.MULTICOMPONENT>) || (<ARGO.ISEVENT.ei_house_door>) || (<ARGO.ISEVENT.ei_house_component>))
		// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev komponentleri silinemez.
		// RETURN 1
	// ENDIF
	ARGO.FUNC_REMOVE_ITEM
ELSE
   RETURN 1
ENDIF

SRC.TARGETF FUNC_TARGETF_REMOVE
RETURN 1





