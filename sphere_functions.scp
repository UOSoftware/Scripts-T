TYPE=T_EQ_SCRIPT
VALUE=0
WEIGHT=0
LAYER=30
//CAN=CAN_O_NOSLEEP
NAME=Remove Timer

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_NEWBIE|ATTR_DECAY
TIMER=1

ON=@EQUIP
