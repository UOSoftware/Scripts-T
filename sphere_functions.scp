SRC.EVENTS +e_removetimer_npc

ON=@UNEQUIP
SRC.EVENTS -e_removetimer_npc

ON=@Timer
IF !(<DMORE1>)
	TOPOBJ.REMOVE
ELSE
	IF (<DMORE1> == 3)
		TOPOBJ.SAYU * 3 saniye sonra silinecektir *
	ENDIF
	MORE1 --
	TIMER=1
ENDIF
RETURN 1



[events e_removetimer_npc]
