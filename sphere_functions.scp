[function SaveToDB]
IF !(<LDB.CONNECTED>)
LDB.CONNECT "db/save.db"
	IF !(<LDB.CONNECTED>)
		serv.log Can't connect to LDB "db/save.db".
		RETURN 0
	ENDIF
ENDIF
LDB.EXECUTE DROP TABLE IF EXISTS 'sphereworld'
lDB.EXECUTE CREATE TABLE IF NOT EXISTS 'sphereworld' (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, baseid TEXT, name TEXT, amount INT, type TEXT, attr TEXT, color TEXT, morep TEXT, morex INT, morey INT, morez INT, morem INT, more1 TEXT, more2 TEXT, p TEXT, px INT, py INT, pz INT, pm INT, created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)
SERV.LOG Starting sphereworld database rebuild...

local.hour=<serv.time>
LDB.EXECUTE BEGIN
FORITEMS 7168
	LOCAL.NAME <StringReplacerSQL <NAME>>
	LDB.EXECUTE INSERT INTO 'sphereworld' (baseid,  name , amount, type, attr, color, morep, morex, morey, morez, morem, more1, more2, p, px, py, pz, pm) VALUES ('<BASEID>','<LOCAL.NAME>','<AMOUNT>','<TYPE>','<attr>','<color>','<morep>','<morex>','<morey>','<morez>','<morem>','<more1>', '<more2>', '<p>', '<P.X>', '<P.Y>', '<P.Z>', '<P.M>')
ENDFOR
LDB.EXECUTE COMMIT
serv.log Database rebuilt in <eval <serv.time>-<local.hour>> seconds.


LDB.CLOSE


	
[EOF]
