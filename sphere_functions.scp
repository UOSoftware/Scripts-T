	SERV.NEWITEM I_REMOVETIMER,1,<UID>,1
	NEW.TIMER=1
	NEW.MORE1=<ARGS>
ENDIF

[ITEMDEF I_REMOVETIMER]
DEFNAME=I_REMOVETIMER
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
VALUE=0
WEIGHT=0
LAYER=30
//CAN=CAN_O_NOSLEEP
NAME=Remove Timer

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_NEWBIE|ATTR_DECAY
TIMER=1

ON=@EQUIP
TIMER=1

ON=@Timer
IF !(<DMORE1>)
	TOPOBJ.REMOVE
ELSE
	IF (<DMORE1> == 3)
		TOPOBJ.SAYU * 3 saniye sonra silinecektir *
	ENDIF
	MORE1 --
	TIMER=1
	TOPOBJ.SYSMESSAGE <DMORE1>
ENDIF



