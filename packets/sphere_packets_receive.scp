IF (<REF1.ISVALIDE> && <REF1.ISPLAYER>)
	//REF1.TAG0.Ping.Receive = <SERV.TIMEHIRES>
	//serv.log <REF1.dTAG0.PING.RECEIVE>
	//serv.log <REF1.dTAG0.PING.SEND>
