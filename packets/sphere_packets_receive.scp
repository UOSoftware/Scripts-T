VERSION=0.56T

[FUNCTION F_PACKET_RECEIVE_0x00]
LOCAL.DESC PacketCreate
LOCAL.ID 00
LOCAL.Type Receive
LOCAL.DETAIL=0
REF1=<UID.<LOCAL.CHAR>.UID>
IF (<DLOCAL.DETAIL>)
FOR <DLOCAL.NUM>
IF (<DLOCAL.<DLOCAL._FOR>>)
IF (STRMATCH('0','<local.message>'))
local.message = <serv.chr <LOCAL.<DLOCAL._FOR>>>
ELSE
local.message .= <serv.chr <LOCAL.<DLOCAL._FOR>>>
ENDIF
ENDIF
ENDFOR
ENDIF
