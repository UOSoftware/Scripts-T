LOCAL.ID 73
LOCAL.Type Receive
LOCAL.DETAIL=0
IF (<LOCAL.CHAR>)
REF1=<UID.<LOCAL.CHAR>.UID>
ENDIF
IF (<DLOCAL.DETAIL>)
	FOR <DLOCAL.NUM>
		IF (<DLOCAL.<DLOCAL._FOR>>)
			IF (STRMATCH('0','<local.message>'))
			local.message = <serv.chr <LOCAL.<DLOCAL._FOR>>>
			ELSE
			local.message .= <serv.chr <LOCAL.<DLOCAL._FOR>>>
			ENDIF
		ENDIF
	ENDFOR
	SERV.LOG [ID=<LOCAL.ID>, Desc=<LOCAL.DESC>, Type=<LOCAL.TYPE>]: CONNECTIONTYPE=<DEF.CONNECTYPE.<DLOCAL.CONNECTIONTYPE>>/<DLOCAL.CONNECTIONTYPE>, NUM=<DLOCAL.NUM>, STR=<LOCAL.STR>, STRLEN=<EVAL STRLEN(<LOCAL.STR>)> - <QVAL (<LOCAL.CHAR>)?CHAR=<REF1.NAME>/<REF1>:>, IP=<ARGS>, <QVAL (<ISEMPTY <LOCAL.ACCOUNT>>)?:ACCOUNT=<LOCAL.ACCOUNT>> <QVAL (<DLOCAL.DETAIL>)?[Detail=<LOCAL.MESSAGE>]:>
