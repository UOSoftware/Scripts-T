[function paketleriyazdir]
serv.deletefile receives.txt
serv.deletefile send.txt

for 0 255
	if !(<isblank <def.PACKET_RECEIVE.<dlocal._for>>>)
		args= <def.PACKET_RECEIVE.<dlocal._for>>
		serv.writefile receives.txt PACKET<dlocal._for>=F_PACKET_RECEIVE_0x<argv0> / <argv1>
	endif

	if !(<isblank <def.PACKET_SEND.<dlocal._for>>>)
		args= <def.PACKET_SEND.<dlocal._for>>
		serv.writefile send.txt OUTPACKET<dlocal._for>=F_PACKET_SEND_0x<argv0> / <argv1>
	endif
ENDFOR


for 0 255
	if !(<isblank <def.PACKET_RECEIVE.<dlocal._for>>>)
	args= <def.PACKET_RECEIVE.<dlocal._for>>
		serv.writefile receives.txt [FUNCTION F_PACKET_RECEIVE_0x<argv0>]
		serv.writefile receives.txt LOCAL.DESC <argv1>
		serv.writefile receives.txt LOCAL.ID <argv0>
		serv.writefile receives.txt LOCAL.Type Receive
		serv.writefile receives.txt LOCAL.DETAIL=0
		serv.writefile receives.txt REF1=<def.L1>UID.<def.L1>LOCAL.CHAR<def.R1>.UID<def.R1>
		serv.writefile receives.txt IF (<def.L1>DLOCAL.DETAIL<def.R1>)
		serv.writefile receives.txt 	FOR <def.L1>DLOCAL.NUM<def.R1>
		serv.writefile receives.txt 		IF (<def.L1>DLOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1>)
		serv.writefile receives.txt 			IF (STRMATCH('0','<def.L1>local.message<def.R1>'))
		serv.writefile receives.txt 				local.message = <def.L1>serv.chr <def.L1>LOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1><def.R1>
		serv.writefile receives.txt 			ELSE
		serv.writefile receives.txt 				local.message .= <def.L1>serv.chr <def.L1>LOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1><def.R1>
		serv.writefile receives.txt 			ENDIF
		serv.writefile receives.txt 		ENDIF
		serv.writefile receives.txt 	ENDFOR
		serv.writefile receives.txt ENDIF
		serv.writefile receives.txt SERV.LOG [ID=<def.L1>LOCAL.ID<def.R1>, Desc=<def.L1>LOCAL.DESC<def.R1>, Type=<def.L1>LOCAL.TYPE<def.R1>]: NUM:<def.L1>DLOCAL.NUM<def.R1>, STR:<def.L1>LOCAL.STR<def.R1>, STRLEN:<def.L1>EVAL STRLEN(<def.L1>LOCAL.STR<def.R1>)<def.R1> - <def.L1>QVAL (<def.L1>REF1.ISVALIDE<def.R1>)?CHAR:<def.L1>REF1.NAME<def.R1>/<def.L1>REF1<def.R1>:<def.R1>, IP: <def.L1>ARGS<def.R1>, <def.L1>QVAL (<def.L1>ISEMPTY <def.L1>LOCAL.ACCOUNT<def.R1><def.R1>)?:ACCOUNT: <def.L1>LOCAL.ACCOUNT<def.R1><def.R1> <def.L1>qval (<def.L1>DLOCAL.DETAIL<def.R1>)?[Detail: <def.L1>LOCAL.MESSAGE<def.R1>]:<def.R1> Detail: <def.L1>LOCAL.MESSAGE<def.R1>
		serv.writefile receives.txt ------------
		serv.writefile receives.txt ------------
	endif

	if !(<isblank <def.PACKET_SEND.<dlocal._for>>>)
	args= <def.PACKET_SEND.<dlocal._for>>
		serv.writefile send.txt [FUNCTION F_PACKET_SEND_0x<argv0>]
		serv.writefile send.txt LOCAL.DESC <argv1>
		serv.writefile send.txt LOCAL.ID <argv0>
		serv.writefile send.txt LOCAL.Type Send
		serv.writefile send.txt LOCAL.DETAIL=0
		serv.writefile send.txt REF1=<def.L1>UID.<def.L1>LOCAL.CHAR<def.R1>.UID<def.R1>
		serv.writefile send.txt IF (<def.L1>DLOCAL.DETAIL<def.R1>)
		serv.writefile send.txt 	FOR <def.L1>DLOCAL.NUM<def.R1>
		serv.writefile send.txt 		IF (<def.L1>DLOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1>)
		serv.writefile send.txt 			IF (STRMATCH('0','<def.L1>local.message<def.R1>'))
		serv.writefile send.txt 				local.message = <def.L1>serv.chr <def.L1>LOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1><def.R1>
		serv.writefile send.txt 			ELSE
		serv.writefile send.txt 				local.message .= <def.L1>serv.chr <def.L1>LOCAL.<def.L1>DLOCAL._FOR<def.R1><def.R1><def.R1>
		serv.writefile send.txt 			ENDIF
		serv.writefile send.txt 		ENDIF
		serv.writefile send.txt 	ENDFOR
		serv.writefile send.txt ENDIF
		serv.writefile send.txt SERV.LOG [ID=<def.L1>LOCAL.ID<def.R1>, Desc=<def.L1>LOCAL.DESC<def.R1>, Type=<def.L1>LOCAL.TYPE<def.R1>]: NUM:<def.L1>DLOCAL.NUM<def.R1>, STR:<def.L1>LOCAL.STR<def.R1>, STRLEN:<def.L1>EVAL STRLEN(<def.L1>LOCAL.STR<def.R1>)<def.R1> - <def.L1>QVAL (<def.L1>REF1.ISVALIDE<def.R1>)?CHAR:<def.L1>REF1.NAME<def.R1>/<def.L1>REF1<def.R1>:<def.R1>, IP: <def.L1>ARGS<def.R1>, <def.L1>QVAL (<def.L1>ISEMPTY <def.L1>LOCAL.ACCOUNT<def.R1><def.R1>)?:ACCOUNT: <def.L1>LOCAL.ACCOUNT<def.R1><def.R1> <def.L1>qval (<def.L1>DLOCAL.DETAIL<def.R1>)?[Detail: <def.L1>LOCAL.MESSAGE<def.R1>]:<def.R1> Detail: <def.L1>LOCAL.MESSAGE<def.R1>
		serv.writefile send.txt ------------
		serv.writefile send.txt ------------
	endif
ENDFOR


[EOF]
