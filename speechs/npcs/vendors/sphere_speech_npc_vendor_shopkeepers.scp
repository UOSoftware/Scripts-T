VERSION=0.56T

[SPEECH spk_generic_npc_vendor_shopkeepers]
ON=*sell*
IF (<SRC.FLAGS>&STATF_DEAD) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.ISDIFF 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ELSEIF ((<SRC.ACTION> != -1) && (<SERV.SKILL.<SRC.ACTION>.FLAGS>&SKF_CRAFT))
	SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>,Eşya üretimi yapıyorken eşya satışı yapamazsınız.
	RETURN 1
ENDIF
SELL
FACE <SRC>

on=*teach*
sayu Ben bir eğitmen değilim.

ON=*buy*
IF (<SRC.FLAGS>&STATF_DEAD) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.ISDIFF 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ENDIF
BUY
FACE <SRC>

[EOF]
