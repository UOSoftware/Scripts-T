VERSION=0.56T

[SPEECH spk_generic_npc_bankers]
ON=*bank*
SRC.OPENBANK


ON=*balance*
IF (<SERV.FeatureTOL>&02)
	SAY Thy current bank balance is <bolukayir <SRC.VIRTUALGOLD>> virtual gold.
ELSE
	SAY Thy current bank balance is <bolukayir <SRC.BANKBALANCE>> physical gold.
ENDIF


ON=*check*




[EOF]
