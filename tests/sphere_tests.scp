


[FUNCTION SPELLBOOK]
DIALOGCLOSE D_SPELLBOOK
DIALOG D_SPELLBOOK
MANA = <INT>

[DIALOG D_SPELLBOOK]
<DEF.DSP>

RESIZEPIC 0 0 3000 700 730
LOCAL.X=5
LOCAL.Y=5

FOR 2240 2303
	local.spell <eval (<dlocal._for>-2240)+1>
	
	BUTTON <DLOCAL.X> <DLOCAL.Y> <dlocal._for> <dlocal._for> 1 0 <dlocal.spell>
	
	LOCAL.HUETEXT=0
	
	DTEXT <EVAL <DLOCAL.X>+50> <DLOCAL.Y> <LOCAL.HUETEXT> <dlocal.spell>. <SERV.SPELL.<DLOCAL.spell>.NAME> 
	DTEXT <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>+20> 0 <SERV.SPELL.<DLOCAL.spell>.RUNES> 
	LOCAL.Y +=45
	IF (<LOCAL.Y> > 720)
		LOCAL.X +=160
		LOCAL.Y=5
	ENDIF
ENDFOR

[DIALOG D_SPELLBOOK BUTTON]
on=1 64
IF !(<RESTEST 1 I_FULL_SPELLBOOK>)
	SERV.NEWITEM I_FULL_SPELLBOOK
	NEW.BOUNCE
ENDIF
//src.mana = <src.int>
CAST <DARGN>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ID=<ARGN>, NAME=<SERV.SPELL.<DARGN>.NAME>, WORD=<SERV.SPELL.<DARGN>.RUNES>
DIALOGCLOSE D_SPELLBOOK
DIALOG D_SPELLBOOK



[eof]