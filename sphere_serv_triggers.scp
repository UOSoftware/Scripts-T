// IF (<ACCOUNT.CHARS> <= 1)
	// NEWGOLD <DDEF.FIRSTSTARTMONEY_GOLD>
// ELSE
	// NEWGOLD <DDEF.STARTMONEY_GOLD>
// ENDIF
NAME <STRARG <STRTOUPPER(<STRSUB 0 1 <NAME>>)><STRTOLOWER(<STRSUB 1 16 <NAME>>)>>
ONAME = <NAME>




