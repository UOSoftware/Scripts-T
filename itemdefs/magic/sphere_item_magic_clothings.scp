[TYPEDEF ei_generic_item_clothings_magic]
ON=@Equip
IF (<ATTR>&ATTR_NEWBIE)
	ATTR &= ~ATTR_NEWBIE
ENDIF
IF (<COLOR> != <SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>)
	COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ENDIF
LOCAL.SKILLNAME = <SERV.SKILL.<SKILL>.NAME>

IF (<SRC.PARRYING> >= 0.1)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <NAME> kullanabilmek için Parrying becerisine sahip olmamalısınız. (0.0 Parrying)
	UNEQUIP
	RETURN 1
ELSEIF (<SRC.MAGERY> < 100.0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <NAME> kullanacak beceriye sahip değilsiniz. (100.0 Magery)
	UNEQUIP
	RETURN 1
ELSEIF (<SRC.<LOCAL.SKILLNAME>> < <MOREY>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <NAME> kullanacak beceriye sahip değilsiniz. (<FVAL <dDEF.SKILL_MAGIC_CLOTH_<MagicValueBaseIdByValue>>> <LOCAL.SKILLNAME>)
	UNEQUIP
	RETURN 1
ENDIF
// IF (<SRC.FINDID.I_RUNE_PROTECTION>)
	// SRC.FINDID.I_RUNE_PROTECTION.REMOVE
	// SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Protection büyü etkisi kaldırıldı.
// ENDIF


ON=@UNEQUIP
IF (<ATTR>&ATTR_NEWBIE)
	ATTR &= ~ATTR_NEWBIE
ENDIF
IF (<COLOR> != <SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>)
	COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ENDIF


On=@Click
IF (<ATTR>&ATTR_NEWBIE)
	ATTR &= ~ATTR_NEWBIE
ENDIF
IF (<COLOR> != <SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>)
	COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ENDIF


[EOF]
