
[DEFNAME DEF_MOONGATES]

// MOONGATE_FACET_0_MOONGATES A_BRITAIN_MOONGATE_1,A_MINOC_VESPER_MOONGATE_1,A_MOONGLOW_MOONGATE_1,A_TRINSIC_MOONGATE_1,A_MAGINCIA_MOONGATE_1,A_SKARA_BRAE_MOONGATE_1,A_YEW_MOONGATE_1,A_JHELOM_MOONGATE_1,A_OCLLO_MOONGATE_1,A_COVE_MOONGATE_1,A_DELUCIA_MOONGATE_1,A_SOSARIA_LAIR

MOONGATE_FACET_0_MOONGATES A_BRITAIN_MOONGATE_1,A_MINOC_VESPER_MOONGATE_1,A_MOONGLOW_MOONGATE_1,A_TRINSIC_MOONGATE_1,A_MAGINCIA_MOONGATE_1,A_SKARA_BRAE_MOONGATE_1,A_YEW_MOONGATE_1,A_JHELOM_MOONGATE_1
MOONGATE_FACET_0_CITYS A_TOWNBRITAIN,A_TOWNMINOC,A_TOWNVESPER,A_TOWNMOONGLOW,A_TOWNYEW,A_TOWNMAGINCIA,A_TOWNSKARABRAE,A_TOWNJHELOM,A_TOWNTRINSIC,A_TOWNNUJELM,A_TOWNBUCSDEN,A_TOWNWIND,A_TOWNOCCLO,A_TOWNCOVE
MOONGATE_FACET_0_DUNGEONS A_DECEIT_LEVEL_1,A_DECEIT_LEVEL_2,A_DECEIT_LEVEL_3,A_DECEIT_LEVEL_4,A_FIRE_DUNGEON_LEVEL_1,A_FIRE_DUNGEON_LEVEL_2,A_ICE_DUNGEON_LEVEL_1,A_ICE_DUNGEON_LEVEL_2,A_ICE_DUNGEON_LEVEL_3,A_DESTARD_LEVEL_1,A_DESTARD_LEVEL_2,A_DESTARD_LEVEL_3,A_DESPISE_LEVEL_1,A_DESPISE_LEVEL_2,A_DESPISE_LEVEL_3,A_DESPISE_LEVEL_4,A_WRONG_LEVEL_1,A_WRONG_LEVEL_2,A_WRONG_LEVEL_3,A_SHAME_LEVEL_1,A_SHAME_LEVEL_2,A_SHAME_LEVEL_3,A_SHAME_LEVEL_4,A_SHAME_LEVEL_5,A_COVETOUS_LEVEL_1,A_COVETOUS_LEVEL_2,A_COVETOUS_LEVEL_3,A_COVETOUS_LEVEL_4,A_COVETOUS_LEVEL_5,A_HYTHLOTH_LEVEL_1,A_HYTHLOTH_LEVEL_2,A_HYTHLOTH_LEVEL_3,A_HYTHLOTH_LEVEL_4,A_TERATHAN_KEEP,A_ICE_ISLE
MOONGATE_FACET_0_GRAVEYARDS A_BRITAIN_GRAVEYARD,A_VESPER_GRAVEYARD,A_MOONGLOW_GRAVEYARD,A_YEW_GRAVEYARD,A_JHELOM_GRAVEYARD,A_NUJELM_GRAVEYARD,A_COVE_GRAVEYARD
MOONGATE_FACET_0_CAVES A_MT_KENDALL,A_MINOC_CAVE1,A_MINOC_CAVE2,A_MINOC_CAVE3,A_CAVE1,A_CAVE2,A_CAVE3
 
 
[TYPEDEF T_MOONGATE_CUSTOM]
ON=@STEP
TYPE=T_MOONGATE_CUSTOM
// SRC.DCLICK <UID>
SRC.USEITEM <UID>

ON=@DCLICK
TYPE=T_MOONGATE_CUSTOM
DISPID=<SERV.ITEMDEF.<BASEID>.ID>
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER

IF (<SRC.ISPOISONED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // Zehirli durumdayken bu işlemi yapamazsınız.
	RETURN 1
ELSEIF (<SRC.IsYarali>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600075 // "Yaralı durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içindeyken kullanamazsınız.
	RETURN 1
ELSEIF !(<SRC.ISNEARTYPE T_MOONGATE_CUSTOM 4>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yakınlarınızda Moongate bulunmuyor.
	RETURN 1
ENDIF

SRC.CTAG0.MOONGATE=<UID>
DIALOGCLOSE D_MOONGATE
DIALOG D_MOONGATE
RETURN 1

ON=@CLICK
TYPE=T_MOONGATE_CUSTOM
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
MESSAGE @0,3 [<REGION.NAME>]
// MESSAGE <SERV.NAME> Moongate
MESSAGE Moongate
IF !(<REGION.SAFE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Geçişlerin etrafını herhangi bir şekilde kapatmak ihlal ve sabote etmek Alan İhlali suçudur.
ENDIF
RETURN 1

// On=@PickUp_Ground
// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sistem tarafından sabitlenmiştir.
// RETURN 1



[ITEMDEF I_MOONGATE_CUSTOM]
DEFNAME=I_MOONGATE_CUSTOM
DEFNAME2=I_MOONGATE
ID=I_MOONGATE_BLUE
TYPE=T_MOONGATE_CUSTOM
NAME=Moongate

ON=@CREATE
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TYPE=T_MOONGATE_CUSTOM
COLOR=0

ON=@TIMER
TYPE=T_MOONGATE_CUSTOM
RETURN 1



[DIALOG D_MOONGATE]
<DEF.DSP>
NOMOVE
SRC.DIALOGCLOSEALL
RESIZE 0,0,210,<EVAL (<ARRAYCOUNT <DEF.MOONGATE_FACET_0_MOONGATES>>*25)+80>,Moongate

DORIGIN 20 20
FOR 1 <ARRAYCOUNT <DEF.MOONGATE_MOONGATES>>
	LOCAL.MOONGATE <SERV.AREA.<ARRAY <DEF.MOONGATE_FACET_0_MOONGATES>,<DLOCAL._FOR>>.NAME>
	
	BUTTON +0 <eval (<dLOCAL._FOR>*25)+32> 0845 0846 1 0 <DLOCAL._FOR>
	DCROPPEDTEXT +20 <eval (<dLOCAL._FOR>*25)+30> 150 25 1000 <LOCAL.MOONGATE>
ENDFOR


[DIALOG D_MOONGATE BUTTON]
ON 1 99
REF1=<SRC.CTAG0.MOONGATE> // Moongate
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Moongate bulunamadı!
	RETURN 1
ELSEIF (<SRC.ISDIFF 2,<REF1>> > 3)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<REF1>
	RETURN 1
ELSEIF (<SRC.ISPOISONED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // Zehirli durumdayken bu işlemi yapamazsınız.
	RETURN 1
ELSEIF (<SRC.IsYarali>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600075 // "Yaralı durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içindeyken kullanamazsınız.
	RETURN 1
ELSEIF !(<SRC.ISNEARTYPE T_MOONGATE_CUSTOM 4>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yakınlarınızda Moongate bulunmuyor.
	RETURN 1
ENDIF
LOCAL.P <SERV.AREA.<ARRAY <DEF.MOONGATE_FACET_0_MOONGATES>,<DARGN>>.P>
SRC.SKILL FAIL
SRC.TARGKAPAT
// SRC.MOVETO <LOCAL.P>
SRC.GO <LOCAL.P>
// SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <LOCAL.P>
SRC.DIALOGCLOSEALL
SRC.MOVE <ARRAY S,W,N,E,SW,NE,ES,WN,NW,SE,<R1,10>> <R1,2> // moongateye gittikten sonra random move ettir
// SRC.REVEALALL
SRC.REVEAL STATF_INVISIBLE



// Sphere Default
[TYPEDEF T_MOONGATE]
ON=@STEP
SRC.SYSMESSAGE @38,,1,1 <name> Bu eşya kullanılmamaktadır.
RETURN 1

ON=@DCLICK
SRC.SYSMESSAGE @38,,1,1 <name> Bu eşya kullanılmamaktadır.
RETURN 1


[EOF]