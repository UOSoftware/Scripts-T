
[ITEMDEF I_BALL_REPUTATION]
DEFNAME=I_BALL_REPUTATION
DEFNAME2=i_crystal_reputation
ID=i_crystal_ball
NAME=reputation crystal
VALUE=10000
WEIGHT=20
TYPE=t_script

ON=@CREATE
COLOR=0254
ATTR=attr_magic
USESMAX=5
USESCUR=0

ON=@CLICK
message a <name>
IF (<USESMAX>)
	MESSAGE [<USESCUR>/<USESMAX> charge]
ENDIF
return 1

ON=@DCLICK
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ELSEIF (<USESMAX> > 0) && (<USESCUR> >= <USESMAX>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Şarj bitmiş.
	REMOVE
	RETURN 1
ENDIF
SRC.EFFECT 3,I_FX_SPARKLE,2,25,1
SRC.SOUND SND_SPELL_ARCHPROTECTION
// SRC.SOUND 0F7
// SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <src.nototitle>;
IF (<SRC.FLAGS>&STATF_CRIMINAL)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Criminal: Evet
ENDIF
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Kills: <src.kills>
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Deaths: <src.Deaths>
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Fame: <bolukayir <src.fame>>
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Karma: <bolukayir <src.karma>>
IF !(<ISBLANK <SRC.TITLE>>)
	SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Title: <SRC.TITLE>
ENDIF
USESCUR ++
// REMOVE
RETURN 1



[eof]