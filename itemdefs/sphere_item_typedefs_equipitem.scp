

[COMMENT sphere_item_typedef_equipitem]
The t_equipitem TYPEDEF is typically applied on every equipable item.
eg:
  t_clothing
  t_armor*
  t_weapon*
  t_wand
  t_jewelry
  t_container (just quivers)
  t_light_lit (just lights that could be equipped like candles, lanterns)
  t_spellbook
  t_fishing_pole

When an item with t_equipitem is equipped by a char, the item properties are
usually added to the char wearing it.  That way multiple items with the same
properties can be equipped at the same time, stacking the effect.

Properties being handled inside this TYPEDEF currently include:

CANUSE
 - Purpose: flag to control what race/gender can equip the item
 - Values:  can_u_human
            can_u_elf
            can_u_gargoyle
            can_u_female
            can_u_all
            can_u_none

BONUSSKILL1[AMT]
BONUSSKILL2[AMT]
BONUSSKILL3[AMT]
BONUSSKILL4[AMT]
BONUSSKILL5[AMT]
 - Purpose: increase/decrease up to 5 char skills when equipped
 - Values:  BONUSSKILL[x]:     skill name (eg: Alchemy, Fencing, ...)
            BONUSSKILL[x]AMT:  decimal value to increase/decrease (eg: 100 = +10.0)

TAG.SlayerGroup (NOT IMPLEMENTED YET)
 - Purpose: weapons with slayer property set will deal double damage when hit monsters of the opposite slayer group


// Bunun yerine ei_generic_item_wearables kullaniliyor.
[TYPEDEF t_equipitem]



[TYPEDEF t_shield]
ON=@EQUIPTEST
IF (<BASEID> == I_SHIELD_ORDER)
	LOCAL.SPELLREMOVE=0
ELSEIF (<BASEID> == I_SHIELD_CHAOS)
	LOCAL.SPELLREMOVE=0
ELSE
	LOCAL.SPELLREMOVE=1
ENDIF
IF (<LOCAL.SPELLREMOVE>)
	IF (<SRC.FINDID.I_RUNE_PROTECTION>)
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Protection etkisi silindi.
		SRC.FINDID.I_RUNE_PROTECTION.REMOVE
	ENDIF
	IF (<SRC.FINDID.I_RUNE_REACTIVE_ARMOR>)
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Reactive Armor etkisi silindi.
		SRC.FINDID.I_RUNE_REACTIVE_ARMOR.REMOVE
	ENDIF
ENDIF









[TYPEDEF T_ROBE_GM]
ON=@DCLICK
IF (<SRC.ISINVIS>)
	SRC.INVIS=0
ELSE
	SRC.INVIS=1
ENDIF



[TYPEDEF T_SPELLBOOK]
ON=@CLICK
// FOR 1 64
	// LOCAL.ACTIVESPELL ++
// ENDFOR
// IF (<SPELLCOUNT> >= <LOCAL.ACTIVESPELL>)
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Full Spellbook
// ELSEIF (<SPELLCOUNT> <= 0)
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Empty Spellbook
// ELSE
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Spellbook
// ENDIF
IF (<SPELLCOUNT> <= 0)
	MESSAGE a spellbook
ELSE
	MESSAGE a spellbook[<spellcount>]
ENDIF
RETURN 1




[TYPEDEF T_SPELLBOOK_NECRO]
ON=@CLICK
FOR 101 117
	LOCAL.ACTIVESPELL ++
ENDFOR
IF (<SPELLCOUNT> >= <LOCAL.ACTIVESPELL>)
	MESSAGE @044,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Full Spellbook
ELSEIF (<SPELLCOUNT> <= 0)
	MESSAGE @38,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Empty Spellbook
ELSE
	MESSAGE @,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Spellbook
ENDIF
RETURN 1




[TYPEDEF T_HAIR]
ON=@TIMER
RETURN 1


[TYPEDEF T_BEARD]
ON=@TIMER
RETURN 1






[TYPEDEF T_WEAPON_THROWING]

[TYPEDEF T_WEAPON_THROWN]



[TYPEDEF T_WEAPON_FENCE]
ON=@EQUIP
IF (<dispid> == i_pitchfork || <ID> == i_spear_short)
	IF !(<SRC.ISEVENT.e_char_bonus_paradarbe>)
		SRC.EVENTS +e_char_bonus_paradarbe
	ENDIF
ENDIF
IF (<dispid> == i_spear)
	IF !(<SRC.ISEVENT.e_char_bonus_dismount>)
		SRC.EVENTS +e_char_bonus_dismount
	ENDIF
ENDIF

ON=@UNEQUIP
IF (<SRC.ISEVENT.e_char_bonus_paradarbe>)
	SRC.EVENTS -e_char_bonus_paradarbe
ENDIF
IF (<SRC.ISEVENT.e_char_bonus_dismount>)
	SRC.EVENTS -e_char_bonus_dismount
ENDIF




[TYPEDEF T_WEAPON_SWORD]
ON=@EQUIP
IF (<dispid> == i_halberd || <dispid> == i_bardiche)
	IF !(<SRC.ISEVENT.e_char_bonus_dismount>)
		SRC.EVENTS +e_char_bonus_dismount
	ENDIF
ENDIF
IF (<dispid> == i_sword_broad || <dispid> == i_cutlass || <dispid> == i_katana || <dispid> == i_sword_viking || <dispid> == i_sword_long || <dispid> == i_scimitar)
	IF !(<SRC.ISEVENT.e_char_bonus_bleeding>)
		SRC.EVENTS +e_char_bonus_bleeding
	ENDIF
ENDIF


ON=@UNEQUIP
IF (<SRC.ISEVENT.e_char_bonus_dismount>)
	SRC.EVENTS -e_char_bonus_dismount
ENDIF
IF (<SRC.ISEVENT.e_char_bonus_bleeding>)
	SRC.EVENTS -e_char_bonus_bleeding
ENDIF




[TYPEDEF T_WEAPON_BOW]
ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGE [Arrows: <EVAL <TOPOBJ.RESCOUNT <TDATA3>>>]
ENDIF

[TYPEDEF T_WEAPON_XBOW]
ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGE [Bolts: <EVAL <TOPOBJ.RESCOUNT <TDATA3>>>]
ENDIF


[TYPEDEF T_WEAPON_MACE_SMITH]
ON=@EQUIP
IF (<dispid> == i_mace || <dispid> == i_mace_war || <dispid> == i_hammer_pick || <dispid> == i_maul || <dispid> == i_hammer_war)
	IF !(<SRC.ISEVENT.e_char_bonus_dropstam>)
		SRC.EVENTS +e_char_bonus_dropstam
	ENDIF
ENDIF
IF (<dispid> == i_club && <ATTR>&ATTR_MAGIC)
	IF !(<SRC.ISEVENT.e_char_bonus_dropstam>)
		SRC.EVENTS +e_char_bonus_dropstam
	ENDIF
ENDIF


ON=@UNEQUIP
IF (<SRC.ISEVENT.e_char_bonus_dropstam>)
	SRC.EVENTS -e_char_bonus_dropstam
ENDIF


