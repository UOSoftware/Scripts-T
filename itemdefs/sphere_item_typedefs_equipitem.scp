[TYPEDEF T_ROBE_GM]
ON=@DCLICK
IF (<SRC.ISINVIS>)
	SRC.INVIS=0
ELSE
	SRC.INVIS=1
ENDIF



[TYPEDEF T_SPELLBOOK]
ON=@CLICK
// FOR 1 64
	// LOCAL.ACTIVESPELL ++
// ENDFOR
// IF (<SPELLCOUNT> >= <LOCAL.ACTIVESPELL>)
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Full Spellbook
// ELSEIF (<SPELLCOUNT> <= 0)
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Empty Spellbook
// ELSE
	// MESSAGE @0 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL>]
	// MESSAGE Spellbook
// ENDIF
IF (<SPELLCOUNT> <= 0)
	MESSAGE a spellbook
ELSE
	MESSAGE a spellbook[<spellcount>]
ENDIF
RETURN 1




[TYPEDEF T_SPELLBOOK_NECRO]
ON=@CLICK
FOR 101 117
	LOCAL.ACTIVESPELL ++
ENDFOR
IF (<SPELLCOUNT> >= <LOCAL.ACTIVESPELL>)
	MESSAGE @044,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Full Spellbook
ELSEIF (<SPELLCOUNT> <= 0)
	MESSAGE @38,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Empty Spellbook
ELSE
	MESSAGE @,,1 [<SPELLCOUNT>/<DLOCAL.ACTIVESPELL> Büyü]
	MESSAGE Spellbook
ENDIF
RETURN 1




