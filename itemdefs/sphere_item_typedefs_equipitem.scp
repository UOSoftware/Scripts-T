[TYPEDEF T_WEAPON_MACE_PICK]




[TYPEDEF T_WEAPON_MACE_CROOK]
ON=@CLICK
REF1=<TAG0.NPC>
IF (<REF1.ISVALIDE>) && (<REF1.ISCHAR>)
MESSAGE (<REF1.NAME>)
ENDIF

IF (<TAG0.TARGP>)
MESSAGE (<TAG0.TARGP>)
ENDIF

ON=@TARGON_ITEM
RETURN 1

ON=@TARGON_CHAR
IF !(<SRC.TARG.NPC> == brain_animal)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece hayvanları sürebilirsiniz.
	RETURN 1
ELSEIF (<SRC.ISDISS 5,<SRC.TARG.UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<SRC.TARG.NAME>
	RETURN 1
ELSEIF (<SRC.TARG.OWNER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sahipli hayvanları süremezsiniz.
	RETURN 1
ENDIF
TAG0.NPC=<SRC.TARG.UID>




[TYPEDEF T_WEAPON_AXE]

ON=@EQUIP
IF !(<SRC.ISEVENT.e_char_bonus_axe>)
	SRC.EVENTS +e_char_bonus_axe
ENDIF

ON=@UNEQUIP
IF (<SRC.ISEVENT.e_char_bonus_axe>)
	SRC.EVENTS -e_char_bonus_axe
ENDIF



