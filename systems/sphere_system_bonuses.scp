VERSION=0.56T

[FUNCTION FUNC_BONUS_All_On]
FOR 1 <DEF.BONUS_COUNT>
	FUNC_BONUS_ON <dlocal._for>
ENDFOR

[FUNCTION FUNC_BONUS_All_Off]
FOR 1 <DEF.BONUS_COUNT>
	FUNC_BONUS_Off <dlocal._for>
ENDFOR

[FUNCTION FUNC_BONUS_On]
LOCAL.EVENT <DEF.BONUS_<ARGS>_EVENT>
LOCAL.NAME <DEF.BONUS_<ARGS>_NAME>
IF !(<ISEVENT.<LOCAL.EVENT>>)
	EVENTS +<LOCAL.EVENT>
	SYSMESSAGE @044 <LOCAL.NAME> bonus: Aktif
ENDIF

[FUNCTION FUNC_BONUS_Off]
LOCAL.EVENT <DEF.BONUS_<ARGS>_EVENT>
LOCAL.NAME <DEF.BONUS_<ARGS>_NAME>
IF (<ISEVENT.<LOCAL.EVENT>>)
	EVENTS -<LOCAL.EVENT>
	SYSMESSAGE @38 <LOCAL.NAME> bonus: Pasif
ENDIF

[FUNCTION FUNC_BONUS_Toggle]
LOCAL.EVENT <DEF.BONUS_<ARGS>_EVENT>
LOCAL.NAME <DEF.BONUS_<ARGS>_NAME>

IF (<ISEVENT.<LOCAL.EVENT>>)
	FUNC_BONUS_Off <ARGS>
ELSE
	FUNC_BONUS_On <ARGS>
ENDIF


[FUNCTION AllBonusEquipedMemDel]
FOR 1 <DEF.BONUS_COUNT>
	LOCAL.MEM <DEF.BONUS_<DLOCAL._FOR>_EQMEMORY>
	IF (<FINDID.<LOCAL.EVENT>>)
		FINDID.<LOCAL.MEM>.REMOVE
	ENDIF
ENDFOR


