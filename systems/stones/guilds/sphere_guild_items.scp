VERSION=0.56T


[ITEMDEF I_CLOAK_GUILD]
DEFNAME=I_CLOAK_GUILD
ID=i_cape
ARMOR=5
NAME=Guild cloak
VALUE=220
WEIGHT=1.0
RESOURCES=
SKILLMAKE=
TEVENTS=t_equipitem
RESDISPDNHUE=0455
TAG0.GuildPoint=1000
TAG0.GuildAlign=

ON=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=attr_magic
HITPOINTS={128 154}

ON=@EquipTest
IF !(<SRC.ISGM>)
	IF !(<SRC.GUILD>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı sadece guild üyeleri kullanabilir.
		UNEQUIP
		RETURN 1
	ENDIF
ENDIF


[ITEMDEF I_GUILD_RESIGN_MEMORY]
DEFNAME=I_GUILD_RESIGN_MEMORY
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
VALUE=0
WEIGHT=0
LAYER=30
NAME=Guild Resign Timer

ON=@CREATE
ATTR ATTR_INVIS|ATTR_NEWBIE|ATTR_DECAY

On=@Equip
SRC.NOTICE 1-2 dakika içinde guildden tamamen ilişkiniz kesilecektir. DİKKAT: Bu süre içinde Guardzoneye girerseniz ayrılma süreci iptal olacaktır.
SRC.GC 1-2 dakika içinde guild üyeliğinden ayrılmış olacağım.
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, 1-2 dakika içinde guildden tamamen ilişkiniz kesilecektir. DİKKAT: Bu süre içinde Guardzoneye girerseniz ayrılma süreci iptal olacaktır.
SRC.SAYUA 38,6,0,0 Guildden ayrılıyor...
MORE1={60 120}
TIMER 1
SRC.FUNC_DIALOGCLOSEALL

ON=@UNEQUIP
SRC.FUNC_DIALOGCLOSEALL

ON=@TIMER
IF (<TOPOBJ.ISONLINE>)
	IF (<TOPOBJ.REGION.GUARDED>)
		TOPOBJ.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Guildden ayrılma sürecinde Guardzone içine girdiğiniz için ayrılma süreci iptal edildi.
		REMOVE
		RETURN 1
	ENDIF
ENDIF
IF !(<MORE1>)
	REF1=<TOPOBJ.GUILD> 
	IF (<REF1>)
		TOPOBJ.f_guildsys_resigncharfromguild <REF1>,<TOPOBJ>
	ENDIF
	REMOVE
ELSEIF (<MORE1> < 11)
	TOPOBJ.SAYU *<DMORE1>. sn sonra guildden ayrılıyor*
ENDIF

MORE1 --
TIMER 1
RETURN 1




[EOF]
