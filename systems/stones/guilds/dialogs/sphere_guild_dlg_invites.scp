VERSION=0.56T

[DIALOG D_GUILD_INVITE_ADD_MEMBER]
<DEF.DSP>
RESIZE 0,0,250,220,Guild - Uye Daveti
REF1=<SRC.CTAG0.INVITE_GUILD>
IF (<REF1.ISVALIDE>)
	DHTMLGUMP 30 50 200 25 1 0 Guild adı: <REF1.NAME>
	DHTMLGUMP 30 80 200 25 1 0 Guild kısaltması: <REF1.ABBREV>
	DHTMLGUMP 30 110 200 25 1 0 Guild destek yönü: <REF1.ALIGNTYPE>
	DHTMLGUMP 30 140 200 25 1 0 Guild üye sayısı: <REF1.MEMBER.COUNT>
	
	DBUTTON 30,170,4006,4007,1,0,1,<DEF.SMSG_SUCCESS_COLOR>,Kabul et
	DBUTTON 30,190,0fb2,0fb3,1,0,0,<DEF.SMSG_ERROR_COLOR>,Reddet
ELSE
	DTEXT 30 50 38 Guild bulunamadı!
ENDIF

[DIALOG D_GUILD_INVITE_ADD_MEMBER BUTTON]
ON=0
REF1=<SRC.CTAG0.INVITE_GUILD>
IF (<REF1.ISVALIDE>)
	SRC.SYSMESSAGE @38,,1,1 <REF1.NAME> guildinin üyelik teklifini reddetin.
	SYSMESSAGE @38,,1,1 <SRC.NAME> guild teklifinizi reddetti.
ENDIF

ON=1
REF1=<SRC.CTAG0.INVITE_GUILD>
IF (<REF1.ISVALIDE>)
	F_GUILDSYS_ADDCHARTOGUILD <REF1>,<SRC>,1
ENDIF



[eof]