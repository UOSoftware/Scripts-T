VERSION=0.56T


[dialog d_Guild_Market]
<DEF.dlgstartpos>
IF (<TYPE> != T_STONE_GUILD)
	RETURN 1
ENDIF

RESIZE 0,0,320,<EVAL (<ARRAYCOUNT <DEF.GUILDCONFIG_MARKET_ITEMS>>*70)+140>,Guild Marketi

DCROPPEDTEXT 30 45 155 25 044 Guild puanınız: <BolukAyir <SRC.dTAG0.POINTS.GUILD>>

FOR 1 <ARRAYCOUNT <DEF.GUILDCONFIG_MARKET_ITEMS>>
	LOCAL.ITEM=<ARRAY <DEF.GUILDCONFIG_MARKET_ITEMS>,<DLOCAL._FOR>>
	IF (<SERV.ITEMDEF.<LOCAL.ITEM>>)
		LOCAL.POINT=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildPoint>
		LOCAL.ALIGN=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildAlign>
		IF (<DLOCAL.ALIGN> > 0)
			IF (<ALIGN> == <DLOCAL.ALIGN>)
				BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 22004 22004 1 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <SERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 5 5
				DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 0 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
			ELSE
				BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 22004 22004 0 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> 38 5 5
				DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 38 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
			ENDIF
		ELSE
			BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 22004 22004 1 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <SERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 5 5
			DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 0 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
		ENDIF
		
		IF (<DLOCAL.POINT>)
			DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+40> 255 25 0 Gerekli Puan: <bolukayir <DLOCAL.POINT>>
		ENDIF
		
	ENDIF	
ENDFOR


[DIALOG D_GUILD_MARKET BUTTON]
ON=0
SDIALOG D_GUILD_MAIN

ON=1 500
LOCAL.ITEM=<ARRAY <DEF.GUILDCONFIG_MARKET_ITEMS>,<ARGN>>
LOCAL.POINT=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildPoint>
LOCAL.ALIGN=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildAlign>

IF (<DLOCAL.POINT>)
	IF (<SRC.dTAG0.POINTS.GUILD> < <DLOCAL.POINT>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı almak için <DLOCAL.POINT> Guild puanına ihtiyacınız var.
		DIALOGCLOSE d_Guild_Market
		DIALOG d_Guild_Market
		RETURN 1
	ENDIF
ENDIF

SERV.NEWITEM <LOCAL.ITEM>
NEW.BOUNCE
IF (<NEW.BASEID> == I_CLOAK_GUILD)
	NEW.COLOR=<REF1.COLOR>
ENDIF
NEW.LINK=<REF1>
IF (<DLOCAL.POINT>)
	SRC.TAG0.POINTS.GUILD -=<DLOCAL.POINT>
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <DLOCAL.POINT> guild puanı harcadınız. Kalan guild puanını: <BolukAyir <SRC.dTAG0.POINTS.GUILD>>
	IF (<SRC.TAG0.POINTS.GUILD> <= 0)
		SRC.TAG0.POINTS.GUILD=0
	ENDIF
ENDIF




[EOF]


  
