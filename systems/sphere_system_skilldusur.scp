VERSION=0.56T

[PLEVEL 1]
skilldusur


[FUNCTION skilldusur]
FUNC_skilldusur

[FUNCTION FUNC_skilldusur]
FOR 0 57
	IF (<<SERV.SKILL.<DLOCAL._FOR>.KEY>> >= 0.1)
		LOCAL.SKILL +=1
	ENDIF
ENDFOR
IF !(<dLOCAL.SKILL>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Herhangi bir yeteneğiniz 0.1 dan yüksek değil.
	RETURN 1
ENDIF
DIALOGCLOSE D_SKILLDUSUR
DIALOG D_SKILLDUSUR <DLOCAL.SKILL>


[DIALOG D_SKILLDUSUR]
<DEF.dlgstartpos>
FOR 0 57
	IF (<<SERV.SKILL.<DLOCAL._FOR>.KEY>> >= 0.1)
		LOCAL.SKILL +=1
	ENDIF
ENDFOR
RESIZE 0,0,240,<EVAL (<dLOCAL.SKILL>*20)+110>,Skilldusur
DORIGIN 20 50

DTEXT +0 +0 0 Beceri toplamı : <FVAL <SRC.SKILLTOTAL>>/<FVAL <SRC.SKILLCLASS.SKILLSUM>>

FOR 0 57
	IF (<SRC.<SERV.SKILL.<DLOCAL._FOR>.KEY>> >= 0.1)
		LOCAL.ID ++
		CHECKBOX +0 <EVAL <LOCAL.Y>+70> 0d2 0d3 0 <DLOCAL._FOR>
		DHTMLGUMP +20 <EVAL <LOCAL.Y>+70>  115 25 0 0 <DLOCAL.ID>.<SERV.SKILL.<DLOCAL._FOR>.NAME>
		DHTMLGUMP +140 <EVAL <LOCAL.Y>+70> 60 25 0 0 <DEF.CENTER><SRC.<SERV.SKILL.<DLOCAL._FOR>.NAME>>
		LOCAL.Y +=20
	ENDIF
ENDFOR

DORIGIN 245 0
RESIZE 245,0,240,140

BUTTON +20 +20 4006 4007 1 0 1
DTEXT +50 +20 0 Seçilen beceriyi 0.1 düşür

BUTTON +20 +40 4006 4007 1 0 2
DTEXT +50 +40 0 Seçilen beceriyi 1.0 düşür

BUTTON +20 +60 4006 4007 1 0 3
DTEXT +50 +60 0 Seçilen beceriyi 5.0 düşür

BUTTON +20 +80 4006 4007 1 0 4
DTEXT +50 +80 0 Seçilen beceriyi 10.0 düşür

BUTTON +20 +100 4006 4007 1 0 5 
DTEXT +50 +100 0 Seçilen beceriyi sıfırla


// [DIALOG D_SKILLDUSUR PREBUTTON]
// SRC.UnequipAll
// SRC.TARGKAPAT

[DIALOG D_SKILLDUSUR BUTTON]
ON=1 5
SRC.UnequipAll
SRC.TARGKAPAT

IF (<DARGN> == 1)
	LOCAL.DUSUR 0.1
ELSEIF (<DARGN> == 2)
	LOCAL.DUSUR 1.0
ELSEIF (<DARGN> == 3)
	LOCAL.DUSUR 5.0
ELSEIF (<DARGN> == 4)
	LOCAL.DUSUR 10.0
ENDIF

FOR 0 57
	IF (<ARGCHK[<DLOCAL._FOR>]>)
		LOCAL.SKILLNUM <DLOCAL._FOR>
		IF (<SRC.<SERV.SKILL.<LOCAL.SKILLNUM>.NAME>> >= <LOCAL.DUSUR>)
			IF (<DLOCAL.DUSUR>)
				SRC.<SERV.SKILL.<LOCAL.SKILLNUM>.NAME> -=<FVAL <LOCAL.DUSUR>>
			ELSE
				SRC.<SERV.SKILL.<LOCAL.SKILLNUM>.NAME> 0
			ENDIF
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <SERV.SKILL.<LOCAL.SKILLNUM>.NAME> beceriniz <FVAL <LOCAL.DUSUR>> düşmüştür.
			SRC.Logger <SERV.SKILL.<LOCAL.SKILLNUM>.NAME> becerisini 0.1 dusurdu.
			SRC.CTAG0.SKILLDUSUR_SELECT.<DLOCAL.SKILLNUM>=<ARGCHK[<DLOCAL._FOR>]> // SEÇİMLERİ HATIRLAMAK İÇİN AMA KULLANILMIYOR. FAZLA DÜŞÜRÜLÜYOR FARKINDA OLMADAN
		ENDIF
	ENDIF
ENDFOR
SRC.SKILLDUSUR


// Gerek var mı belki başka titlesi var adamın alakasız o yüzden sıfırlamayalım
// SRC.TITLE=
// SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Titleniz sıfırlandı.


[EOF]
