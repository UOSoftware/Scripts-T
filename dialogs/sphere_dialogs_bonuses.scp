VERSION=0.56T

[PLEVEL 1]
BONUSLAR

[FUNCTION BONUSLAR]
DIALOGCLOSE d_bonuses
DIALOG d_bonuses

[DIALOG d_bonuses]
<DEF.DSP>
RESIZE 0,0,330,<eval (<DEF.BONUS_COUNT>*25)+90>,Bonuslar

DORIGIN 20 50

FOR 1 <DEF.BONUS_COUNT>
	IF (<DEF.BONUS_<DLOCAL._FOR>_STATUS> == 1)
		LOCAL.AUMENTAR += 1
		LOCAL.EVENT=<DEF.BONUS_<DLOCAL._FOR>_EVENT>
		LOCAL.NAME=<DEF.BONUS_<DLOCAL._FOR>_NAME>
		BUTTON +0 <EVAL (<LOCAL.AUMENTAR>*25)+40> 0845 0846 1 0 <DLOCAL._FOR>
		IF (<ISEVENT.<LOCAL.EVENT>>)
			DTEXT +20 <EVAL (<LOCAL.AUMENTAR>*25)+40> 044 <DLOCAL._FOR>.<LOCAL.NAME>
			DTEXT +200 <EVAL (<LOCAL.AUMENTAR>*25)+40> 044 Aktif
			LOCAL.AKTIF ++
		ELSE
			DTEXT +20 <EVAL (<LOCAL.AUMENTAR>*25)+40> 38 <DLOCAL._FOR>.<LOCAL.NAME>
			DTEXT +200 <EVAL (<LOCAL.AUMENTAR>*25)+40> 38 Pasif
		ENDIF
	ENDIF
ENDFOR

DTEXT +0 <eval (<DEF.BONUS_COUNT>*25)+60> <QVAL (<DLOCAL.AKTIF>)?044:38> Aktif bonus : <DLOCAL.AKTIF>/<dDEF.BONUS_COUNT>

PAGE 2
LOCAL.NAME <DEF.BONUS_<SRC.dCTAG0.BONUS.SELECT>_NAME>
LOCAL.SKILLS <DEF.BONUS_<SRC.dCTAG0.BONUS.SELECT>_SKILLS>
LOCAL.WEAPONS <DEF.BONUS_<SRC.dCTAG0.BONUS.SELECT>_WEAPONS>
LOCAL.DESCRIPTION <DEF.BONUS_<SRC.dCTAG0.BONUS.SELECT>_DESCRIPTION>

RESIZE 340,0,280,550,<LOCAL.NAME> Bonus Detayları 
DORIGIN 360 50

DTEXT +0 +0 0 Açıklama;
IF !(<ISBLANK <LOCAL.DESCRIPTION>>)
	DHTMLGUMP +0 +20 240 80 1 1 <LOCAL.DESCRIPTION>
ENDIF

IF !(<ISBLANK <LOCAL.SKILLS>>) && (<ARRAYCOUNT <LOCAL.SKILLS>>)
	DORIGIN 360 150
	DTEXT +0 +0 0 Gereken Beceriler;
	ARGS=<LOCAL.SKILLS>
	FOR s 0 <EVAL <ARGV>-1>
		LOCAL.SKILLAMT = <STRARG <argv<dlocal.s>>>
		LOCAL.SKILLID = <STREAT <argv<dlocal.s>>>
		DTEXT +0 <EVAL (<DLOCAL.s>*25)+170> 1000 <LOCAL.SKILLAMT> <SERV.SKILL.<LOCAL.SKILLID>.NAME>
	ENDFOR
ENDIF

IF !(<ISBLANK <LOCAL.WEAPONS>>) && (<ARRAYCOUNT <LOCAL.WEAPONS>>)
DORIGIN 360 250
DTEXT +0 +0 0 Silahlar;
	ARGS=<LOCAL.WEAPONS>
	FOR w 0 <EVAL <ARGV>-1>
		LOCAL.WEAPON  <argv<dlocal.w>>
		TILEPICHUE +0 <EVAL (<DLOCAL.w>*30)+270> <SERV.ITEMDEF.<LOCAL.WEAPON>.ID> 0
		DTEXT +80 <EVAL (<DLOCAL.w>*30)+270> 07a1 <SERV.ITEMDEF.<LOCAL.WEAPON>.NAME>
	ENDFOR
ENDIF

[DIALOG d_bonuses BUTTON]
ON=1 50
CTAG0.BONUS.SELECT=<DARGN>
DIALOGCLOSE d_bonuses
DIALOG d_bonuses 2

[eof]
