VERSION=0.56T

[COMMENT sphere_dialog_hunry]


[DIALOG D_HUNGRY]
<DEF.dlgstartpos>
RESIZEPIC 0 0 5120 240 140
RESIZEPIC 10 10 3000 220 120 

DTEXT 20 20 0 Hungry
DORIGIN 20 50
RESIZEPIC +0 +0 2620 200 35
LOCAL.MAXWIDTH=193
LOCAL.PERCENT=<MULDIV <FOOD>,100,<MAXFOOD>>
LOCAL.WIDTH=<MULDIV <FOOD>,200,<MAXFOOD>>
IF (<DLOCAL.WIDTH> >= <DLOCAL.MAXWIDTH>)
	LOCAL.WIDTH=<DLOCAL.MAXWIDTH>
ENDIF
IF (<DLOCAL.PERCENT> >= 100)
	LOCAL.PERCENT=100
ENDIF
RESIZEPIC +6 +6 3000 <EVAL <DLOCAL.WIDTH>-3> 23
DTEXT +85 +9 1000 %<DLOCAL.PERCENT>
DTEXT +0 +35 0 Food/MaxFood: <FOOD>/<MAXFOOD>
DTEXT +0 +55 0 <ARGS>


[EOF]
