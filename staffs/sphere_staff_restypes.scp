


[ITEMDEF I_RESTYPES_DEED]
DEFNAME=I_RESTYPES_DEED
ID=I_DEED
TYPE=T_SCRIPT
NAME=Resource Types Deed
RESDISPDNHUE=0901

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_NEWBIE

ON=@DCLICK
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
IF (<SRC.ACCOUNT.PLEVEL> >= 5)
	SRC.f_onclient_add
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşya yetkililere aittir.
	REMOVE
ENDIF
RETURN 1

ON=@PICKUP_PACK
RETURN 1



[DIALOG D_RESTYPES_DEED]
<DEF.dlgstartpos>
RESIZE 0,0,870,600,Restypes (<SRC.TAG0.RESTYPE_DLG.TYPE>)

LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)

	PAGE 0
	// SAĞ TARAF
	LOCAL.X=35
	LOCAL.Y=0
	DORIGIN 20 50
	DHTMLGUMP +0 +0 270 25 1 0 <DEF.CENTER>RESOURCE
	DHTMLGUMP +280 +0 270 25 1 0 <DEF.CENTER>NAME
	DHTMLGUMP +560 +0 270 25 1 0 <DEF.CENTER>DATA
	
	lDB.Query "SELECT id, name, defname, data, description FROM 'restypes' WHERE <SRC.TAG0.RESTYPE_DLG.WHERE> LIMIT <SRC.DTAG0.RESTYPE_DLG.INDEX>,15"
	IF (<lDB.ROW.NUMROWS>)
		FOR 0 <EVAL <lDB.ROW.NUMROWS>-1>
			LOCAL.DEFNAME= <ldb.row.<dlocal._for>.defname>
			LOCAL.NAME= <ldb.row.<dlocal._for>.NAME>
			LOCAL.DESCRIPTION= <ldb.row.<dlocal._for>.description>

			IF (<SERV.ITEMDEF.<LOCAL.DEFNAME>>) 
				ARGS= <ldb.row.<dlocal._for>.data>
				LOCAL.COLOR <strsub 10 99 <ARGV0>>
				TILEPICHUE +0 <EVAL (<DLOCAL._FOR>*30)+80> <SERV.ITEMDEF.<LOCAL.DEFNAME>.ID> <dLOCAL.COLOR>
			ELSEIF (<SERV.CHARDEF.<LOCAL.DEFNAME>>)
				ARGS= <ldb.row.<dlocal._for>.data>
				LOCAL.COLOR <strsub 10 99 <ARGV0>>
				TILEPICHUE +0 <EVAL (<DLOCAL._FOR>*30)+80> <SERV.CHARDEF.<LOCAL.DEFNAME>.ICON> <dLOCAL.COLOR>
			ENDIF
			
			BUTTON +42 <EVAL (<DLOCAL._FOR>*30)+85> 0845 0846 1 0 <eval <ldb.row.<dlocal._for>.id>+1000> // INFO
			BUTTON +240 <EVAL (<DLOCAL._FOR>*30)+80> 4006 4007 1 0 <eval <ldb.row.<dlocal._for>.id>+30000> // PROCESS
			
			// name
			IF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_SPAWN) 
				DHTMLGUMP +60 <EVAL (<DLOCAL._FOR>*30)+80> 180 25 1 0 <LOCAL.description>
			ELSE
				DHTMLGUMP +60 <EVAL (<DLOCAL._FOR>*30)+80> 180 25 1 0 <LOCAL.NAME>
			ENDIF
			
			// defname
			RESIZEPIC +280 <EVAL (<DLOCAL._FOR>*30)+80> 3000 270 25
			DTEXTENTRYLIMITED +285 <EVAL (<DLOCAL._FOR>*30)+85> 270 25 0 0 0 <LOCAL.DEFNAME>

			// data
			IF (<SERV.ITEMDEF.<LOCAL.DEFNAME>>) 
				DHTMLGUMP +560 <EVAL (<DLOCAL._FOR>*30)+80> 270 25 1 0  
				
			ELSEIF (<SERV.CHARDEF.<LOCAL.DEFNAME>>)
				ARGS=<ldb.row.<dlocal._for>.data>
				LOCAL.BRAIN <strsub 8 99 <ARGV0>>
				DHTMLGUMP +560 <EVAL (<DLOCAL._FOR>*30)+80> 270 25 1 0 <DEF.NPCBrain.<dLOCAL.BRAIN>> (<dLOCAL.BRAIN>)
			ENDIF

		ENDFOR
	ENDIF
	
	BUTTON +0 +500 5537 5539 1 0 1 // PAGE  --
	BUTTON +30 +500 5540 5542 1 0 2 // PAGE +

	// SAĞ TARAF
	RESIZE 880,0,200,600
	DORIGIN 900 30
	
	// TYPEDEFS
	DHTMLGUMP +0 +0 150 25 1 0 <DEF.CENTER>RESOURCE TYPES
	BUTTON +0 +30 4006 4007 1 0 3 // ITEMDEFS BUTTON
	DTEXT +30 +30 0 ITEMDEFS
		
	BUTTON +0 +50 4006 4007 1 0 4 // CHARDEFS BUTTON
	DTEXT +30 +50 0 CHARDEFS
	
	BUTTON +0 +70 4006 4007 1 0 5 // AREADEFS BUTTON
	DTEXT +30 +70 0 AREADEFS
	
	BUTTON +0 +90 4006 4007 1 0 6 // ROOMDEFS BUTTON
	DTEXT +30 +90 0 ROOMDEFS
		
	BUTTON +0 +110 4006 4007 1 0 7 // SPAWNGROUP BUTTON
	DTEXT +30 +110 0 SPAWNGROUP
	
	//SIRALAMA
	DORIGIN 900 170
	DHTMLGUMP +0 +0 150 25 1 0 <DEF.CENTER>SIRALAMA	
	
	BUTTON +0 +30 4006 4007 1 0 100 // SIRALAMA BUTTON
	DTEXT +30 +30 0 Alfabetik
	
	//FİLTRELE
	DORIGIN 900 230
	DHTMLGUMP +0 +0 150 25 1 0 <DEF.CENTER>FİLTRELE	

	//ARAMA
	DORIGIN 900 380
	DHTMLGUMP +0 +0 150 25 1 0 <DEF.CENTER>ARAMA
	
	BUTTON +120 +30 4006 4007 1 0 101 // ARAMA BUTTON
	RESIZEPIC +0 +30 3000 120 25
	DTEXTENTRYLIMITED +5 +35 100 25 0 1 100 <QVAL (<ISBLANK <SRC.TAG0.RESTYPE_DLG.SearchTerm>>) ? : <SRC.TAG0.RESTYPE_DLG.SearchTerm> >  // ARAMA INPUT 

	LOCAL.DEFSELECTED = <SRC.TAG.RESTYPE_DLG.SPAWN_ID>
	// INFO MENU
	
	
	
	PAGE 2
	// ALT TARAF
	RESIZE 0,600,435,120
	
	DORIGIN 20 620
	
	// TYPEDEFS
	DHTMLGUMP +0 +0 50 25 1 0 ID:
	RESIZEPIC +55 +0 3000 340 25
	DTEXTENTRYLIMITED +60 +5 330 20 044 2 120 <LOCAL.DEFSELECTED>
	
	DHTMLGUMP +0 +30 50 25 1 0 NAME:
	RESIZEPIC +55 +30 3000 205 25
	
	IF (<SERV.ITEMDEF.<LOCAL.DEFSELECTED>>) 
		DTEXT +60 +35 0 <SERV.ITEMDEF.<LOCAL.DEFSELECTED>.NAME>

	ELSEIF (<SERV.CHARDEF.<LOCAL.DEFSELECTED>>)
		DTEXT +60 +35 0 <SERV.CHARDEF.<LOCAL.DEFSELECTED>.NAME>
		
	ELSEIF (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_AREA)
		DTEXT +60 +35 0 <SERV.AREA.<LOCAL.DEFSELECTED>.NAME>
		
	ELSEIF (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_ROOM)
		DTEXT +60 +35 0 <SERV.ROOM.<LOCAL.DEFSELECTED>.NAME>	
		
	ELSEIF (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_SPAWN)
		DTEXT +60 +35 0 <SERV.SPAWN.<LOCAL.DEFSELECTED>.DESCRIPTION>
	ENDIF

	IF (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_ITEMDEF) || (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_CHARDEF) || (<RESOURCETYPE <LOCAL.DEFSELECTED>> == RES_SPAWN) 
		
		IF !(<RESOURCETYPE <LOCAL.DEFNAME>> == RES_SPAWN) 
			BUTTON +280 +60 4006 4007 1 0 102  // OLUŞTUR
			DTEXT +310 +60 0480 Direct Oluştur
		ENDIF
		
		// Spawn
		RESIZE 435,600,435,120
		DORIGIN 455 620

		DHTMLGUMP +0 +0 85 25 1 0 AMOUNT:
		RESIZEPIC +90 +0 3000 85 25
		DTEXTENTRYLIMITED +95 +5 20 20 33 3 3 <QVAL (<ISBLANK <TAG0.RESTYPE_DLG.Spawn_AMOUNT>>) ? 1 : <dTAG0.RESTYPE_DLG.Spawn_AMOUNT>>
		
		DHTMLGUMP +0 +30 85 25 1 0 MAX DIST:
		RESIZEPIC +90 +30 3000 85 25
		DTEXTENTRYLIMITED +95 +35 20 20 33 4 3 <QVAL (<ISBLANK <TAG0.RESTYPE_DLG.Spawn_MOREZ>>) ? 1 : <dTAG0.RESTYPE_DLG.Spawn_MOREZ>>

		//
		DHTMLGUMP +180 +0 85 25 1 0 MIN TIME:
		RESIZEPIC +270 +0 3000 85 25
		DTEXTENTRYLIMITED +275 +5 20 20 33 5 3 <QVAL (<ISBLANK <TAG0.RESTYPE_DLG.Spawn_MOREX>>) ? 5 : <dTAG0.RESTYPE_DLG.Spawn_MOREX>>
		
		DHTMLGUMP +180 +30 85 25 1 0 MAX TIME:
		RESIZEPIC +270 +30 3000 85 25
		DTEXTENTRYLIMITED +275 +35 20 20 33 6 3 <QVAL (<ISBLANK <TAG0.RESTYPE_DLG.Spawn_MOREY>>) ? 15 : <dTAG0.RESTYPE_DLG.Spawn_MOREY>>


		BUTTON +0 +60 4006 4007 1 0 103 // Spawn sıç
		DTEXT +30 +60 0 Spawn sıç
		RESIZEPIC +90 +60 3000 50 25
		DTEXTENTRYLIMITED +95 +65 80 25 33 7 3 <QVAL (<SRC.dTAG0.Dialog.SpawnMenu.CheckDIST>)?<SRC.dTAG0.Dialog.SpawnMenu.CheckDIST>:0>
		DTEXT +140 +65 0 radius check

		BUTTON +280 +60 4006 4007 1 0 104 // SPAWN OLUŞTUR
		DTEXT +310 +60 0480 Spawn Oluştur
	ENDIF
	
ENDIF
lDB.CLOSE


[DIALOG D_RESTYPES_DEED BUTTON]
// PAGE --
ON=1
IF (<SRC.TAG0.RESTYPE_DLG.INDEX> > 0)
	SRC.TAG0.RESTYPE_DLG.INDEX -=15
ENDIF
SDIALOG D_RESTYPES_DEED


// PAGE ++
ON=2
SRC.TAG0.RESTYPE_DLG.INDEX +=15
SDIALOG D_RESTYPES_DEED


// ITEMDEF
ON=3
SRC.TAG0.RESTYPE_DLG.TYPE=ITEMDEF
SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
SRC.TAG0.RESTYPE_DLG.SearchTerm = 
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED

// CHARDEF
ON=4
SRC.TAG0.RESTYPE_DLG.TYPE=CHARDEF
SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
SRC.TAG0.RESTYPE_DLG.SearchTerm = 
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED

// AREADEF
ON=5
SRC.TAG0.RESTYPE_DLG.TYPE=AREADEF
SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
SRC.TAG0.RESTYPE_DLG.SearchTerm = 
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED

// ROOMDEF
ON=6
SRC.TAG0.RESTYPE_DLG.TYPE=ROOMDEF
SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
SRC.TAG0.RESTYPE_DLG.SearchTerm = 
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED


// SPAWN
ON=7
SRC.TAG0.RESTYPE_DLG.TYPE=SPAWN
SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
SRC.TAG0.RESTYPE_DLG.SearchTerm = 
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED








// SIRALAMA
ON=100




// ARAMA
ON=101
IF (<ISBLANK <ARGTXT[1]>>)
	SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>'"
	SRC.TAG0.RESTYPE_DLG.SearchTerm = 
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SRC.TAG0.RESTYPE_DLG.TYPE> resourcelerinde araniyor...
	SRC.TAG0.RESTYPE_DLG.SearchTerm = <ARGTXT[1]>
	SRC.TAG0.RESTYPE_DLG.WHERE="restype='<SRC.TAG0.RESTYPE_DLG.TYPE>' AND (name LIKE '%<ARGTXT[1]>%' OR defname LIKE '%<ARGTXT[1]>%')"
ENDIF
SRC.TAG0.RESTYPE_DLG.ORDER="name ASC"
SRC.TAG0.RESTYPE_DLG.INDEX=0
SDIALOG D_RESTYPES_DEED



// OLUŞTUR
ON=102
IF (<ISBLANK <ARGTXT[2]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Boş ID giremezsiniz.
ELSE
	LOCAL.DEFNAME = <ARGTXT[2]>
	IF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_ITEMDEF) 
		SRC.ADDITEM <LOCAL.DEFNAME>
		SRC.TAG0.RESTYPE_DLG.DefSelected <LOCAL.DEFNAME>
	ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_CHARDEF)
		SRC.ADDNPC <LOCAL.DEFNAME>
		SRC.TAG0.RESTYPE_DLG.DefSelected <LOCAL.DEFNAME>
	ENDIF
ENDIF
SDIALOG D_RESTYPES_DEED 2




// SPAWN Sıç
ON=103
IF (<ISBLANK <ARGTXT[2]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Boş ID giremezsiniz.
	
ELSEIF (<ISBLANK <ARGTXT[3]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Amount: Boş bırakamazsınız.
	
ELSEIF (<ISBLANK <ARGTXT[4]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Distance (Max): Boş bırakamazsınız.
	
ELSEIF (<ISBLANK <ARGTXT[5]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Time (Min): Boş bırakamazsınız.	
		
ELSEIF (<ISBLANK <ARGTXT[6]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Time (Max): Boş bırakamazsınız.	

ELSEIF (<ISBLANK <ARGTXT[7]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, (Check distance) :Boş bırakamazsınız.	

ELSEIF (<ARGTXT[7]> > 24)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, (Check distance): En fazla 24 olabilir.
	
ELSEIF (<ARGTXT[7]> < 1)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, (Check distance): En az 1 olabilir.
	
ELSE

	LOCAL.DEFNAME = <ARGTXT[2]>
	IF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_ITEMDEF) 
		LOCAL.TYPE t_spawn_item
		
	ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_CHARDEF)
		LOCAL.TYPE t_spawn_char
		
	ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_SPAWN)
		LOCAL.TYPE t_spawn_char
	ENDIF
	
	SRC.TAG0.RESTYPE_DLG.Spawn_TYPE			<LOCAL.TYPE> // TYPEDEF
	SRC.TAG0.RESTYPE_DLG.SPAWN_ID			<ARGTXT[2]>  // ID
	SRC.TAG0.RESTYPE_DLG.Spawn_AMOUNT		<ARGTXT[3]> // AMOUNT
	SRC.TAG0.RESTYPE_DLG.Spawn_MOREX		<ARGTXT[5]> // MIN TIME
	SRC.TAG0.RESTYPE_DLG.Spawn_MOREY		<ARGTXT[6]> //  MAX TIME
	SRC.TAG0.RESTYPE_DLG.Spawn_MOREZ		<ARGTXT[4]> // DISTANCE
		
	IF !(<SRC.FINDID.I_EQ_SPAWN_REPLACER>)
		SERV.NEWITEM I_EQ_SPAWN_REPLACER
		NEW.LINK=<SRC>
		NEW.TIMER=1
		NEW.MORE2=<ARGTXT[7]> // check distance
		SRC.EQUIP <NEW.UID>
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Check near: <new.dmore2> kare
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Tick time: <new.timer> sn
	ELSE
		SRC.CONSUME <DEF.CONSUME_FULL_AMOUNT> I_EQ_SPAWN_REPLACER
	ENDIF
	
ENDIF
SDIALOG D_RESTYPES_DEED 2






// SPAWN EKLE
ON=104
IF (<ISBLANK <ARGTXT[2]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Boş ID giremezsiniz.
	
ELSEIF (<ISBLANK <ARGTXT[3]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Amount: Boş bırakamazsınız.
	
ELSEIF (<ISBLANK <ARGTXT[4]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Distance (Max): Boş bırakamazsınız.
	
ELSEIF (<ISBLANK <ARGTXT[5]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Time (Min): Boş bırakamazsınız.	
		
ELSEIF (<ISBLANK <ARGTXT[6]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Time (Max): Boş bırakamazsınız.	
	
ELSE

	LOCAL.DEFNAME = <ARGTXT[2]>
	IF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_ITEMDEF) 
		LOCAL.TYPE t_spawn_item
	ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_CHARDEF)
		LOCAL.TYPE t_spawn_char
	ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_SPAWN)
		LOCAL.TYPE t_spawn_char
	ENDIF
	
	// 0 =  TYPEDEF
	// 1 =  ID
	// 2 =  AMOUNT
	// 3 =  MIN TIME
	// 4 =  MAX TIME
	// 5 =  DISTANCE
	TARGETFG F_CREATESPAWN <LOCAL.TYPE>,<LOCAL.DEFNAME>,<ARGTXT[3]>,<ARGTXT[5]>,<ARGTXT[6]>,<ARGTXT[4]>
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Spawni nereye yerlestirmek istiyorsun?

ENDIF

SDIALOG D_RESTYPES_DEED 2


		


// INFO
ON=1000 29999
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	lDB.Query "SELECT id, defname, data FROM 'restypes' WHERE id='<EVAL <DARGN>-1000>'"
	IF (<lDB.ROW.NUMROWS>)
		SRC.TAG0.RESTYPE_DLG.SPAWN_ID <ldb.row.0.defname>
		SDIALOG D_RESTYPES_DEED 2
	ENDIF
ENDIF
lDB.CLOSE




// PROCESS
ON=30000 60000
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	lDB.Query "SELECT id, defname, data FROM 'restypes' WHERE id='<EVAL <DARGN>-30000>'"
	
	IF (<lDB.ROW.NUMROWS>)
		LOCAL.DEFNAME = <ldb.row.0.defname>
		 SRC.TAG0.RESTYPE_DLG.SPAWN_ID
		SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <LOCAL.DEFNAME> / <DRESOURCETYPE <LOCAL.DEFNAME>>
		
		IF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_ITEMDEF) 
			// ADDITEM
			SRC.ADDITEM <LOCAL.DEFNAME>
			
		ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_CHARDEF)
			// ADDCHAR
			SRC.ADDNPC <LOCAL.DEFNAME>		
			
		ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_AREA) 
			// GO
			SRC.GO <SERV.AREA.<ldb.row.0.defname>.P>>
			SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SERV.AREA.<ldb.row.0.defname>.P>
			
		ELSEIF (<RESOURCETYPE <LOCAL.DEFNAME>> == RES_ROOM)
			// Go
			SRC.GO <SERV.ROOM.<ldb.row.0.defname>.P>>
			SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SERV.ROOM.<ldb.row.0.defname>.P>
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tanımsız resource.
		ENDIF
		
	ENDIF
ENDIF
lDB.CLOSE
SDIALOG D_RESTYPES_DEED
	
	



[ITEMDEF I_EQ_SPAWN_REPLACER]
DEFNAME=I_EQ_SPAWN_REPLACER
ID=i_memory
NAME=Spawn Replacer
TYPE=T_eq_script
LAYER=layer_special
WEIGHT=0

ON=@CREATE
TIMER=1

ON=@EQUIP
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Durdurmak için warmodeye geçiniz.
SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>,Spawn Replace: ON


ON=@UNEQUIP
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,Spawn Replace: Off

ON=@TIMER
IF (<TOPOBJ.FLAGS> & STATF_WAR)
	REMOVE
	RETURN 1
ENDIF

IF !(<MORE2>)
	LOCAL.DIST 13
ELSE
	LOCAL.DIST <dMORE2>
ENDIF

FORITEMS <DLOCAL.DIST>
	IF (<TYPE> == T_SPAWN_CHAR) && !(<TOPOBJ.CANSEE <UID>>)
		LOCAL.NEARBIT ++
	ENDIF
ENDFOR

IF (<DLOCAL.NEARBIT>)
	TOPOBJ.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <DLOCAL.DIST> kare etrafınızda başka spawn var dolasmaya devam edin.
ELSE

	SERV.NEWITEM=I_WORLDGEM_BIT
	NEW.TYPE=<TOPOBJ.TAG0.RESTYPE_DLG.Spawn_TYPE>			// TYPEDEF
	NEW.MORE=<TOPOBJ.TAG0.RESTYPE_DLG.SPAWN_ID>				// ID
	NEW.AMOUNT=<TOPOBJ.TAG0.RESTYPE_DLG.Spawn_AMOUNT>		// AMOUNT
	NEW.MOREX=<TOPOBJ.TAG0.RESTYPE_DLG.Spawn_MOREX>			// MIN TIME
	NEW.MOREY=<TOPOBJ.TAG0.RESTYPE_DLG.Spawn_MOREY>			//  MAX TIME
	NEW.MOREZ=<TOPOBJ.TAG0.RESTYPE_DLG.Spawn_MOREZ>			// DISTANCE
	NEW.ATTR=0B0
	NEW.P=<TOPOBJ.P>
	NEW.TIMER=1
	
	TOPOBJ.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Name=<new.name>, Type=<new.type>, More1=<new.more1>, Amount=<new.AMOUNT>, MoreX=<new.MOREX>, MoreY=<new.MOREY>, MoreZ=<new.MOREZ>


ENDIF
TIMER 1
RETURN 1






[function f_createspawn]
TAG0.RESTYPE_DLG.Spawn_TYPE			<ARGV0> // TYPEDEF
TAG0.RESTYPE_DLG.SPAWN_ID			<ARGV1> // ID
TAG0.RESTYPE_DLG.Spawn_AMOUNT		<ARGV2> // AMOUNT
TAG0.RESTYPE_DLG.Spawn_MOREX		<ARGV3> // MIN TIME
TAG0.RESTYPE_DLG.Spawn_MOREY		<ARGV4> //  MAX TIME
TAG0.RESTYPE_DLG.Spawn_MOREZ		<ARGV5> // DISTANCE

SERV.NEWITEM=I_WORLDGEM_BIT
NEW.TYPE=<ARGV0>			// TYPEDEF
NEW.MORE=<ARGV1>			// ID
NEW.AMOUNT=<ARGV2>			// AMOUNT
NEW.MOREX=<ARGV3>			// MIN TIME
NEW.MOREY=<ARGV4>			//  MAX TIME
NEW.MOREZ=<ARGV5>			// DISTANCE
NEW.ATTR=0B0
NEW.P=<TARGP>
NEW.TIMER=1





[function f_restypes_setup_items]
LOCAL.TABLENAME = restypes

//ITEMDEFS
FOR 0 <EVAL <SERV.DEFLIST.ITEMDEF.COUNT>-1>
	LOCAL.ITEM=<SERV.DEFLIST.ITEMDEF.<DLOCAL._FOR>>
	IF (<LOCAL.ITEM>)	
		// SERV.LOG <SERV.TILEDATA.ITEM(<DLOCAL._FOR>).NAME> 
		// SERV.LOG <SERV.TILEDATA.ITEM(<DLOCAL._FOR>).FLAGS> 
		SERV.NEWITEM <LOCAL.item>
		NEW.P 1,1,1,0
		NEW.TAG0.SILINECEK=1
		REF1=<NEW>
		NEW.REMOVE
		
		LOCAL.NAME <StringReplacerSQL <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>>
		LOCAL.ID <STRTOUPPER <SERV.ITEMDEF.<LOCAL.ITEM>.DEFNAME>>
		LOCAL.RESTYPE=ITEMDEF
		
		// <QVAL (<SERV.BANKMAXWEIGHT> == -1)?Sinirsiz: xxx >
		LOCAL.CATEGORY=<QVAL (<IsBlank <SERV.ITEMDEF.<LOCAL.ITEM>.CATEGORY>> == 1) ? Undefined : <STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.CATEGORY>>>
		LOCAL.SUBSECTION=<QVAL (<IsBlank <SERV.ITEMDEF.<LOCAL.ITEM>.SUBSECTION>> == 1) ? Undefined : <STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.SUBSECTION>> >
		LOCAL.DESCRIPTION=<QVAL (<IsBlank <SERV.ITEMDEF.<LOCAL.ITEM>.DESCRIPTION>> == 1) ? Undefined : <STRINGREPLACERSQL <SERV.ITEMDEF.<LOCAL.ITEM>.DESCRIPTION>> >
		
		// LOCAL.CATEGORY=
		// LOCAL.SUBSECTION=
		// LOCAL.DESCRIPTION=
		
		LOCAL.DATA = {"color":"<ref1.color>","type":"<strtoupper <ref1.type>>"}
					
		LDB.QUERY "SELECT id FROM '<LOCAL.TABLENAME>' WHERE defname='<LOCAL.ID>'"
		IF (<LDB.ROW.NUMROWS>)
			LDB.EXECUTE "UPDATE '<LOCAL.TABLENAME>' SET name='<LOCAL.NAME>', data='<LOCAL.DATA>', restype='<LOCAL.RESTYPE>', category='<local.category>', subsection='<local.subsection>', description='<local.description>' WHERE defname='<LOCAL.ID>'"
		ELSE
			ldb.EXECUTE INSERT INTO '<LOCAL.TABLENAME>' ('defname','restype','name','data','category','subsection','description') VALUES ("<LOCAL.ID>","<LOCAL.RESTYPE>","<LOCAL.NAME>",'<LOCAL.DATA>',"<LOCAL.CATEGORY>","<LOCAL.subsection>","<LOCAL.DESCRIPTION>")
		ENDIF
	ENDIF
ENDFOR
	
	
[function f_restypes_setup_chars]
LOCAL.TABLENAME = restypes

// CHARDEF
FOR 0 <EVAL <SERV.DEFLIST.CHARDEF.COUNT>-1>
	LOCAL.CHAR=<SERV.DEFLIST.CHARDEF.<DLOCAL._FOR>>
	IF (<LOCAL.CHAR>)
		
	
		LOCAL.NAME <StringReplacerSQL <SERV.CHARDEF.<LOCAL.CHAR>.NAME>>
		LOCAL.ID <STRTOUPPER <SERV.CHARDEF.<LOCAL.CHAR>.DEFNAME>>
		LOCAL.RESTYPE=CHARDEF

					
		LOCAL.CATEGORY=<QVAL (<IsBlank <SERV.CHARDEF.<LOCAL.CHAR>.CATEGORY>> == 1) ? Undefined : <STRINGREPLACERSQL <SERV.CHARDEF.<LOCAL.CHAR>.CATEGORY>> >
		LOCAL.SUBSECTION=<QVAL (<IsBlank <SERV.CHARDEF.<LOCAL.CHAR>.SUBSECTION>> == 1) ? Undefined : <STRINGREPLACERSQL <SERV.CHARDEF.<LOCAL.CHAR>.SUBSECTION>> >
		LOCAL.DESCRIPTION=<QVAL (<IsBlank <SERV.CHARDEF.<LOCAL.CHAR>.DESCRIPTION>> == 1) ? Undefined :<STRINGREPLACERSQL <SERV.CHARDEF.<LOCAL.CHAR>.DESCRIPTION>> >
		// LOCAL.CATEGORY=
		// LOCAL.SUBSECTION=
		// LOCAL.DESCRIPTION=
		
		SERV.NEWNPC <LOCAL.CHAR>
		NEW.P 1,1,1,0
		NEW.TAG0.SILINECEK=1
		REF1=<NEW>
		NEW.REMOVE
		
		LOCAL.DATA = {"npc":"<ref1.npc>"}
					
		LDB.QUERY "SELECT id FROM '<LOCAL.TABLENAME>' WHERE defname='<LOCAL.ID>'"
		IF (<LDB.ROW.NUMROWS>)
			LDB.EXECUTE "UPDATE '<LOCAL.TABLENAME>' SET name='<LOCAL.NAME>', data='<LOCAL.DATA>', restype='<LOCAL.RESTYPE>', category='<local.category>', subsection='<local.subsection>', description='<local.description>' WHERE defname='<LOCAL.ID>'"
		ELSE
			ldb.EXECUTE INSERT INTO '<LOCAL.TABLENAME>' ('defname','restype','name','data','category','subsection','description') VALUES ("<LOCAL.ID>","<LOCAL.RESTYPE>","<LOCAL.NAME>",'<LOCAL.DATA>',"<LOCAL.CATEGORY>","<LOCAL.subsection>","<LOCAL.DESCRIPTION>")
		ENDIF
		
	ENDIF
ENDFOR
	
	



[function f_restypes_setup_spawns]
LOCAL.TABLENAME = restypes

// SPAWN
FOR 0 <EVAL <SERV.DEFLIST.SPAWN.COUNT>-1>
	LOCAL.SPAWN=<SERV.DEFLIST.SPAWN.<DLOCAL._FOR>>
	IF (<LOCAL.SPAWN>)
		LOCAL.ID <STRTOUPPER <LOCAL.SPAWN>>
		LOCAL.RESTYPE=SPAWN
		
		LOCAL.CATEGORY=
		LOCAL.SUBSECTION=
		LOCAL.DESCRIPTION=
		
		LOCAL.DATA = 
		LDB.QUERY "SELECT id FROM '<LOCAL.TABLENAME>' WHERE defname='<LOCAL.ID>'"
		IF (<LDB.ROW.NUMROWS>)
			LDB.EXECUTE "UPDATE '<LOCAL.TABLENAME>' SET name='<LOCAL.NAME>', data='<LOCAL.DATA>', restype='<LOCAL.RESTYPE>', category='<local.category>', subsection='<local.subsection>', description='<local.description>' WHERE defname='<LOCAL.ID>'"
		ELSE
			ldb.EXECUTE INSERT INTO '<LOCAL.TABLENAME>' ('defname','restype','name','data','category','subsection','description') VALUES ("<LOCAL.ID>","<LOCAL.RESTYPE>","<LOCAL.NAME>","<LOCAL.DATA>","<LOCAL.CATEGORY>","<LOCAL.subsection>","<LOCAL.DESCRIPTION>")
		ENDIF
	ENDIF
ENDFOR
	

[function f_restypes_setup_areas]
LOCAL.TABLENAME = restypes

// AREADEFS
FOR 0 <EVAL <SERV.DEFLIST.AREADEF.COUNT>-1>
	LOCAL.AREA=<SERV.DEFLIST.AREADEF.<DLOCAL._FOR>>
	IF (<LOCAL.AREA>)
		LOCAL.NAME=<StringReplacerSQL <SERV.AREA.<LOCAL.AREA>.NAME>>
		LOCAL.ID <STRTOUPPER <SERV.AREA.<LOCAL.AREA>.DEFNAME>>
		LOCAL.RESTYPE=AREADEF
		LOCAL.CATEGORY=
		LOCAL.SUBSECTION=
		LOCAL.DESCRIPTION=
		LOCAL.DATA = {"group":"<StringReplacerSQL <SERV.AREA.<LOCAL.AREA>.GROUP>>", "p":"<SERV.AREA.<LOCAL.AREA>.P>","map":"<SERV.AREA.<LOCAL.AREA>.MAP>","flags":"<SERV.AREA.<LOCAL.AREA>.FLAGS>","events":"<SERV.AREA.<LOCAL.AREA>.EVENTS>"}		
		LDB.QUERY "SELECT id FROM '<LOCAL.TABLENAME>' WHERE defname='<LOCAL.ID>'"
		IF (<LDB.ROW.NUMROWS>)
			LDB.EXECUTE "UPDATE '<LOCAL.TABLENAME>' SET name='<LOCAL.NAME>', data='<LOCAL.DATA>', restype='<LOCAL.RESTYPE>', category='<local.category>', subsection='<local.subsection>', description='<local.description>' WHERE defname='<LOCAL.ID>'"
		ELSE
			ldb.EXECUTE INSERT INTO '<LOCAL.TABLENAME>' ('defname','restype','name','data','category','subsection','description') VALUES ("<LOCAL.ID>","<LOCAL.RESTYPE>","<LOCAL.NAME>",'<LOCAL.DATA>',"<LOCAL.CATEGORY>","<LOCAL.subsection>","<LOCAL.DESCRIPTION>")
		ENDIF
		
	ENDIF
ENDFOR

[function f_restypes_setup_rooms]
LOCAL.TABLENAME = restypes
	
// ROOMDEFS
FOR 0 <EVAL <SERV.DEFLIST.ROOMDEF.COUNT>-1>
	LOCAL.ROOM=<SERV.DEFLIST.ROOMDEF.<DLOCAL._FOR>>
	IF (<LOCAL.ROOM>)
		LOCAL.NAME=<StringReplacerSQL <SERV.ROOM.<LOCAL.ROOM>.NAME>>
		//LOCAL.ID <STRTOUPPER <SERV.ROOM.<LOCAL.ROOM>.DEFNAME>>
		LOCAL.ID <STRTOUPPER <local.room>>
		LOCAL.RESTYPE=ROOMDEF
		LOCAL.CATEGORY=
		LOCAL.SUBSECTION=
		LOCAL.DESCRIPTION=
		LOCAL.DATA = {"group":"<StringReplacerSQL <SERV.ROOM.<LOCAL.ROOM>.GROUP>>", "p":"<SERV.ROOM.<LOCAL.ROOM>.P>","map":"<SERV.ROOM.<LOCAL.ROOM>.MAP>","flags":"<SERV.ROOM.<LOCAL.ROOM>.FLAGS>"}
		
		LDB.QUERY "SELECT id FROM '<LOCAL.TABLENAME>' WHERE defname='<LOCAL.ID>'"
		IF (<LDB.ROW.NUMROWS>)
			LDB.EXECUTE "UPDATE '<LOCAL.TABLENAME>' SET name='<LOCAL.NAME>', data='<LOCAL.DATA>', restype='<LOCAL.RESTYPE>', category='<local.category>', subsection='<local.subsection>', description='<local.description>' WHERE defname='<LOCAL.ID>'"
		ELSE
			ldb.EXECUTE INSERT INTO '<LOCAL.TABLENAME>' ('defname','restype','name','data','category','subsection','description') VALUES ("<LOCAL.ID>","<LOCAL.RESTYPE>","<LOCAL.NAME>",'<LOCAL.DATA>',"<LOCAL.CATEGORY>","<LOCAL.subsection>","<LOCAL.DESCRIPTION>")
		ENDIF
	ENDIF
ENDFOR





[FUNCTION F_RESTYPES_SETUP]

SERV.LOG GETREFTYPE: <EVAL <GETREFTYPE>>

IF (<GETREFTYPE> == <def.tref_client>)
	SERV.LOG Eski nesneler siliniyor...
	FORITEMS 7168
		IF (<TAG0.SILINECEK>)
			REMOVE
		ENDIF
	ENDFOR

	FORCHARS 7168
		IF (<TAG0.SILINECEK>)
			REMOVE
		ENDIF
	ENDFOR
	SERV.LOG Eski nesneler silindi.
ENDIF

LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LOCAL.TABLENAME = restypes
	ldb.EXECUTE DROP TABLE IF EXISTS '<LOCAL.TABLENAME>'
	
	lDB.EXECUTE CREATE TABLE IF NOT EXISTS '<LOCAL.TABLENAME>' (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, defname TEXT, restype TEXT, name TEXT, data JSON, category TEXT, subsection TEXT, description TEXT, status INT, accesslevel INT, created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)
	local.hour=<serv.rticks>
	LDB.EXECUTE BEGIN
	
	f_restypes_setup_items 
	f_restypes_setup_chars
	f_restypes_setup_areas
	f_restypes_setup_rooms
	f_restypes_setup_spawns
	
	LDB.EXECUTE COMMIT
	serv.log Output done in <eval <serv.rticks>-<local.hour>> seconds.
	
LDB.CLOSE
ENDIF






[EOF]
