/// Uyarı deed
[ITEMDEF I_DEED_UYARI]
DEFNAME=I_DEED_UYARI
ID=I_DEED
NAME=Uyari
TYPE=T_DEED_UYARI
TEVENTS=ei_deed_uyari
RESDISPDNHUE=0480
CAN=004000|008000

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TAG0.SILINMEZ=1
TIMER -1
TAG0.TIME <SERV.RTIME>





[TYPEDEF T_DEED_UYARI_DIEPLAYER]

[TYPEDEF T_DEED_UYARI_UNCLOSE]

[TYPEDEF T_DEED_UYARI_UNCLOSE_FIELD]

[TYPEDEF T_DEED_UYARI_UNCLOSE_BLOCK]

[TYPEDEF T_DEED_UYARI_MULTI]

[TYPEDEF T_DEED_UYARI_MARK]

[TYPEDEF T_DEED_UYARI]



[Function Func_Mark_Yasak_Item_Controller]
REF1=<UID>
FORITEMS 50
REF100=<UID>
	IF (<REF1.DISTANCE <REF100>> < <REF100.TAG0.KARE>) && (<REF100.TYPE> == T_DEED_UYARI_MARK)
		REF1.TAG0.MARK_YASAK_KARE = <REF100.TAG0.KARE>
	ENDIF
ENDFOR
RETURN 0




[TYPEDEF ei_deed_uyari]
ON=@PICKUP_GROUND
IF (<SRC.ACCOUNT.PLEVEL> < 7)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sistem tarafından sabitlenmiştir.
	RETURN 1
ENDIF

ON=@CLICK
IF (<ATTR>&ATTR_INVIS)
	MESSAGE (Invis)
ENDIF
IF !(<TAG0.KARE>)
	TAG0.KARE=18
ENDIF
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
DISPID=<SERV.ITEMDEF.<BASEID>.ID>
UPDATE
IF (<DTAG0.KARE>)
MESSAGE (<DTAG0.KARE> kare)
ENDIF
MESSAGE @38,,1,1 <NAME>
FOR 1 <DTAG0.CLICKER>
	IF (<TAG0.CLICKER.<DLOCAL._FOR>>==<SRC>)
		LOCAL.CLICK=1
	ENDIF
ENDFOR
IF !(<LOCAL.CLICK>)
	TAG0.CLICKER ++
	TAG0.CLICKER.<DTAG0.CLICKER> <SRC>
ENDIF
RETURN 1


ON=@DCLICK
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
DISPID=<SERV.ITEMDEF.<BASEID>.ID>
UPDATE
// TIMER=1
IF !(<TAG0.KARE>)
	TAG0.KARE=18
ENDIF
FOR 1 <DTAG0.CLICKER>
	IF (<TAG0.CLICKER.<DLOCAL._FOR>>==<SRC>)
		LOCAL.CLICK=1
	ENDIF
ENDFOR
IF !(<LOCAL.CLICK>)
	TAG0.CLICKER ++
	TAG0.CLICKER.<DTAG0.CLICKER> <SRC>
ENDIF
DIALOGCLOSE D_UYARI_DEED
DIALOG D_UYARI_DEED
RETURN 1





[DIALOG D_UYARI_DEED]
<DEF.dlgstartpos>
RESIZE 0,0,320,200,Uyari Belgesi

FOR 1 <DTAG0.CLICKER>
	IF (<TAG0.CLICKER.<DLOCAL._FOR>>==<SRC>)
		LOCAL.CLICK=1
	ENDIF
ENDFOR
IF !(<LOCAL.CLICK>)
	TAG0.CLICKER ++
	TAG0.CLICKER.<DTAG0.CLICKER> <SRC>
ENDIF
DORIGIN 20 50
IF !(<LINK.ISVALIDE>)
	DTEXT +0 +0 1152 Uyarıyı yapan : Sistem
ELSE
	DTEXT +0 +0 1152 Uyarıyı yapan : <link.name>
ENDIF
DTEXT +0 +20 1152 Uyarı zamanı: <TAG0.TIME>
DTEXT +0 +40 1152 Etki alanı: <dTAG0.KARE> metre (kare)

// DTEXT +0 +60 0 Uyarı ;
DHTMLGUMP +0 +60 280 70 1 1 <DEF.BFONT_RED><DEF.BIG><STRTOUPPER <NAME>>

IF (<SRC.ACCOUNT.PLEVEL> > 1)
	RESIZE 330,0,180,200,Okuyanlar
	PAGE 1
	DORIGIN 350 50
	LOCAL.AUMENTAR=0
	LOCAL.PAGE=1
	FOR 1 <DTAG0.CLICKER>
		IF (<LOCAL.AUMENTAR> >= 8)
			LOCAL.AUMENTAR=0
			BUTTON 475 190 015A4 015A6 0 <EVAL <LOCAL.PAGE>+1> 0
			LOCAL.PAGE += 1
			PAGE <EVAL <LOCAL.PAGE>>
			BUTTON 445 190 015A1 015A3 0 <EVAL <LOCAL.PAGE>-1> 0
		ENDIF
		REF1=<TAG0.CLICKER.<DLOCAL._FOR>>
		IF (<REF1.ISVALIDE>) && (<REF1.ISPLAYER>)
			LOCAL.AUMENTAR += 1
			DCROPPEDTEXT +0 <EVAL (<LOCAL.AUMENTAR>*20)+30> 150 25 <QVAL (<REF1.ISONLINE>)?044:38> <REF1.NAME>
		ENDIF
	ENDFOR
ENDIF


[EOF]
