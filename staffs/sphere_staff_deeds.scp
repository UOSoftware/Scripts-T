VERSION=0.56T

[PLEVEL 2]
DEED

[FUNCTION DEED]
DIALOGCLOSE D_UYARI_STAFF
DIALOG D_UYARI_STAFF

[DIALOG D_UYARI_STAFF]
<DEF.dlgstartpos>
RESIZE 0,0,240,400,Deeds

DORIGIN 20 50

DTEXT +0 +0 0455 Etki alanı ;
RESIZEPIC +0 +30 2620 70 30
DTEXTENTRYLIMITED +5 +35 70 30 1000 1 2 8

BUTTON +0 +80 0845 0846 1 0 1
DTEXT +20 +80 0 Ev/Gemi yasak deed

BUTTON +0 +103 0845 0846 1 0 2
DTEXT +20 +100 0 Mark yasak deed

BUTTON +0 +123 0845 0846 1 0 3
DTEXT +20 +120 0 Field yasak deed

BUTTON +0 +143 0845 0846 1 0 4
DTEXT +20 +140 0 Kutu&Kasa yasak deed

BUTTON +0 +163 0845 0846 1 0 5
DTEXT +20 +160 0 Ölü Oyuncu yasak deed

BUTTON +0 +210 0845 0846 1 0 6
DTEXT +20 +210 0 Uyarı Deed

DTEXT +0 +230 0455 Uyarı ;
RESIZEPIC +0 +250 2620 200 80
DTEXTENTRYLIMITED +5 +255 200 80 1153 2 150     

[DIALOG D_UYARI_STAFF BUTTON]
// Ev/Gemi yasak
ON=1,5
IF (<ISBLANK <ARGTXT[1]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Etki alanı (kare) belirtiniz.
	SRC.DEED
	RETURN 1
ELSEIF !(<ISNUM <ARGTXT[1]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Etki alanına sadece rakam giriniz.
	SRC.DEED
	RETURN 1
ENDIF
IF (<ARGN> == 1)
	SERV.NEWITEM I_DEED_UYARI_MULTI
ELSEIF (<ARGN> == 2)
	SERV.NEWITEM I_DEED_UYARI_MARK
ELSEIF (<ARGN> == 3)
	SERV.NEWITEM I_DEED_UYARI_UNCLOSE_FIELD
ELSEIF (<ARGN> == 4)
	SERV.NEWITEM I_DEED_UYARI_UNCLOSE_BLOCK
ELSEIF (<ARGN> == 5)
	SERV.NEWITEM I_DEED_UYARI_DIEPLAYER
ENDIF
NEW.P <SRC.P>
NEW.LINK=<DEF.link_invalid>
NEW.TAG0.KARE=<ARGTXT[1]>


// Uyarı DEED
ON=6
IF (<ISEMPTY <ARGTXT[2]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Uyarı yazınız.
	SRC.DEED
	RETURN 1
ENDIF
SERV.NEWITEM I_DEED_UYARI
NEW.P <SRC.P>
NEW.NAME=<ARGTXT[2]>
NEW.TIMER -1
NEW.LINK=<DEF.link_invalid>






// OLU CHAR YASAK
[ITEMDEF I_DEED_UYARI_DIEPLAYER]
DEFNAME=I_DEED_UYARI_DIEPLAYER
ID=I_DEED
NAME=Bu alanda olu varlik bulunamaz.
TYPE=T_DEED_UYARI_DIEPLAYER
TEVENTS=ei_deed_uyari
CAN=004000|008000
RESDISPDNHUE=0480

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=attr_static|attr_move_never
TAG0.SILINMEZ=1
TAG0.TIME <SERV.RTIME>
TIMER={3 5}

ON=@TIMER
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
DISPID=<SERV.ITEMDEF.<BASEID>.ID>

TAG0.KARE=24
LOCAL.KARE <DTAG0.KARE>
// LOCAL.KARE=<QVAL (<DTAG0.KARE>)?<TAG0.KARE>:24>
REF1=<UID>
FORPLAYERS <DLOCAL.KARE>
REF2=<UID>
	IF !(<REF2.FINDID.I_MEMORY_DIEPLAYER_MEM>)
		IF (<REF2.FLAGS>&STATF_DEAD) && (<REF2.ISONLINE>)
			SERV.NEWITEM I_MEMORY_DIEPLAYER_MEM,1,<REF2>,1
			NEW.LINK=<REF1>
		ENDIF
	ENDIF
ENDFOR
TIMER={3 5}
RETURN 1



[ITEMDEF I_MEMORY_DIEPLAYER_MEM]
DEFNAME=I_MEMORY_DIEPLAYER_MEM
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
VALUE=0
CAN=004000|008000
WEIGHT=0
LAYER=30
NAME=No Die Player Screen

ON=@CREATE
COLOR=38
ATTR=ATTR_INVIS|ATTR_NEWBIE|ATTR_DECAY

ON=@EQUIP
MORE1={30 45}
TIMER=1
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Bu alanda ölü karakterler bekleme yapamaz. 
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <DMORE1> saniye sonra hala ölü halde burada durursanız Safe Zoneye gönderileceksiniz.

ON=@UNEQUIP
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Ölü karakterlerin yasaklı alanından çıktın!

on=@Timer
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
DISPID=<SERV.ITEMDEF.<BASEID>.ID>

IF !(<TOPOBJ.ISPLAYER>)
	REMOVE
	RETURN 1
ENDIF
IF !(<TOPOBJ.ISONLINE>)
	REMOVE
	RETURN 1
ENDIF
IF !(<TOPOBJ.FLAGS>&STATF_DEAD)
	REMOVE
	RETURN 1
ENDIF
IF (<TOPOBJ.DISTANCE <LINK>> > <LINK.TAG0.KARE>)
	REMOVE
	RETURN 1
ENDIF
IF (<MORE1>)
	MORE1 --
	TOPOBJ.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <DMORE1>
	TIMER=1
	RETURN 1
ELSE
	IF (<TOPOBJ.ISPK>)
		TOPOBJ.GO delucia
	ELSE
		TOPOBJ.GO BRITAIN
	ENDIF
	TOPOBJ.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Ölü karakterlerlerin beklemesi yasak alanda çok fazla beklediğiniz için alandan gönderildiniz.
	REMOVE
	RETURN 1
ENDIF
TIMER=1
RETURN 1








// MARK YASAK
[ITEMDEF I_DEED_UYARI_MARK]
DEFNAME=I_DEED_UYARI_MARK
ID=I_DEED
NAME=Bu alan marklanamaz.
TYPE=T_DEED_UYARI_MARK
TEVENTS=ei_deed_uyari
CAN=004000|008000
RESDISPDNHUE=0480

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TAG0.SILINMEZ=1
TAG0.TIME <SERV.RTIME>



/// EV GEMI YASSAK
[ITEMDEF I_DEED_UYARI_MULTI]
DEFNAME=I_DEED_UYARI_MULTI
ID=I_DEED
NAME=Bu alana ev ve gemi kurmak yasaktır.
TYPE=T_DEED_UYARI_MULTI
TEVENTS=ei_deed_uyari
RESDISPDNHUE=0480
CAN=004000|008000

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TAG0.SILINMEZ=1
TAG0.TIME <SERV.RTIME>



// ALAN IHLAL UYARISI
[ITEMDEF I_DEED_UYARI_UNCLOSE]
DEFNAME=I_DEED_UYARI_UNCLOSE
ID=I_DEED
NAME=Bu alan herhangi bir sekilde kapatilamaz.
TYPE=T_DEED_UYARI_UNCLOSE
TEVENTS=ei_deed_uyari
RESDISPDNHUE=0480
CAN=004000|008000

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
TIMER=2
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TAG0.SILINMEZ=1
TAG0.TIME <SERV.RTIME>

ON=@TIMER
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
DISPID=<SERV.ITEMDEF.<BASEID>.ID>

REF1=<UID>
LOCAL.KARE=<QVAL (<DTAG0.KARE>)?<TAG0.KARE>:18>
FORITEMS <DLOCAL.KARE>
REF2=<UID>
	IF (<REF1> != <REF2>)
		IF (<REF2.IsImpassableItem>) || (<REF2.TYPE> == T_SPELL) && !(<REF2.CONT>)
			REF2.TIMER
		ENDIF
	ENDIF
ENDFOR
IF (<REF1>)
	REF1.TIMER 2
ELSE
	TIMER 2
ENDIF
RETURN 1




