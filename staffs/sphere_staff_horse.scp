VERSION=0.56T


[PLEVEL 2]
BINEQ

[FUNCTION BINEQ]
IF !(<FINDID.I_STAFF_HORSE>)
	SERV.NEWITEM I_STAFF_HORSE,1,<UID>
	NEW.DCLICK
ENDIF

// IF (<FINDID.I_STAFF_HORSE>)
	// IF (<FINDLAYER.25>)
		// DISMOUNT
	// ELSE
		// FINDID.I_STAFF_HORSE.DCLICK
	// ENDIF
// ENDIF


[ITEMDEF I_STAFF_HORSE]
DEFNAME=I_STAFF_HORSE
ID=I_DEED
TYPE=T_SCRIPT
NAME=Staff Mount
RESDISPDNHUE=0901
WEIGHT=0.0

on=@create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_NEWBIE

on=@dclick
IF (0<SRC.ACCOUNT.PLEVEL> <= 1)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşya yetkililere aittir.
	REMOVE
	RETURN 1
ENDIF

IF (<SRC.FINDLAYER.25>)
	SRC.DISMOUNT
ELSE

	SRC.EVENTS +E_ETHEREAL_CONTROL_STAFF
	LOCAL.BINEKS C_LLAMA,C_OSTARD_DESERT,C_OSTARD_FOREST,C_OSTARD_ZOSTRICH,C_HORSE_BROWN_DK

	SERV.NEWNPC <ARRAY <LOCAL.BINEKS>,<R1,<ARRAYCOUNT <LOCAL.BINEKS>>>>
	NEW.TAG0.STAFFHORSE=<NEW.UID>
	NEW.COLOR { colors_white 1 colors_black 1}
	NEW.P <SRC.P>
	NEW.FLAGS <NEW.FLAGS>&STATF_PET
	REF1=<NEW.UID>
	NEW.MAKEMYPET <SRC>
	SRC.MOUNT <REF1>
	// REF1.MOUNT
	// SRC.DCLICK <REF1>
ENDIF
RETURN 1

ON=@PICKUP_PACK
RETURN 1


[EVENTS e_ethereal_control_staff]
ON=@DISMOUNT
// ARGO = MEMORY
// SRC = BINEK
// UID = PLAYER
IF (<SRC.ACCOUNT.PLEVEL> > 1)
	ARGO.REMOVE
	SRC.EVENTS -E_ETHEREAL_CONTROL_STAFF
ENDIF
RETURN 1


[EOF]
