


[PLEVEL 1]
TARGETAL
HEDEF
HEDEFAL
HEDEFLE

[FUNCTION HEDEFAL]
CUSTOM_TARGET

[FUNCTION TARGETAL]
CUSTOM_TARGET

[FUNCTION HEDEF]
CUSTOM_TARGET

[FUNCTION HEDEFLE]
CUSTOM_TARGET


[FUNCTION CUSTOM_TARGET]
TARGET
SYSMESSAGE Select target...






[PLEVEL 1]
REGS
INGOTS
ORES
POTIONS
OTHERS
MALZEME

[FUNCTION MALZEME]
CLEARCTAGS Dialog.Malzeme
IF (<ISEMPTY <ARGS>>)
	CTAG0.Dialog.Malzeme.Type RESOURCE_MAGERY_REAGENTS
ELSE
	CTAG0.Dialog.Malzeme.Type <ARGS>
ENDIF
FOR 1 <ARRAYCOUNT <DEF.<CTAG0.Dialog.Malzeme.Type>>>
	LOCAL.MALZEME <ARRAY <DEF.<CTAG0.Dialog.Malzeme.Type>>,<DLOCAL._FOR>>
	CTAG0.Dialog.Malzeme.Count ++
	CTAG0.Dialog.Malzeme.M<dCTAG0.Dialog.Malzeme.Count> <LOCAL.MALZEME>
ENDFOR
// IF !(<DCTAG.Dialog.Malzeme.Page>)
	CTAG.Dialog.Malzeme.Page=1
// ENDIF
CTAG.Dialog.Malzeme.MaxPage=<eval (((<dCTAG0.Dialog.Malzeme.Count>-1)/20)+1)>
DIALOGCLOSE D_MALZEME
DIALOG D_MALZEME


[FUNCTION REGS]
MALZEME RESOURCE_MAGERY_REAGENTS

[FUNCTION INGOTS]
MALZEME RESOURCE_INGOTS

[FUNCTION ORES]
MALZEME RESOURCE_ORES

[FUNCTION POTIONS]
MALZEME RESOURCE_POTIONS

[FUNCTION OTHERS]
MALZEME RESOURCE_OTHERS

[FUNCTION SCROLLS]
MALZEME RESOURCE_MAGERY_SCROLLS


[DIALOG D_MALZEME]
<DEF.dlgstartpos>
IF (<dCTAG0.Dialog.Malzeme.Count> > 20)
	LOCAL.MAINH 600
ELSE
	LOCAL.MAINH <EVAL (<dCTAG0.Dialog.Malzeme.Count>*25)+80>
ENDIF
RESIZE 0,0,250,<DLOCAL.MAINH>,Malzeme (<dCTAG0.Dialog.Malzeme.Count>)
LOCAL.X=10
LOCAL.Y=50
FOR <eval ((<dCTAG0.Dialog.Malzeme.Page> - 1) * 20) + 1> <eval (<dCTAG0.Dialog.Malzeme.Page> * 20)>
	LOCAL.MALZEME <CTAG0.Dialog.Malzeme.M<DLOCAL._FOR>>
	IF !(<ISBLANK <LOCAL.MALZEME>>)
	
		LOCAL.ID = <SERV.ITEMDEF.<LOCAL.MALZEME>.ID>
		
		IF (<SERV.ITEMDEF.<LOCAL.MALZEME>.TYPE> == T_INGOT)
			LOCAL.ID +=1
		ELSEIF (<SERV.ITEMDEF.<LOCAL.MALZEME>.TYPE> == T_ORE)
			LOCAL.ID +=2
		// ELSEIF (<SERV.ITEMDEF.<LOCAL.MALZEME>.TYPE> == T_POTION)
			// LOCAL.ID +=1
		ENDIF
		
		TILEPICHUE <DLOCAL.X> <EVAL (<DLOCAL.Y>)> <LOCAL.ID> <DSERV.ITEMDEF.<LOCAL.MALZEME>.RESDISPDNHUE>
		DCROPPEDTEXT <eval <DLOCAL.X>+50> <EVAL (<DLOCAL.Y>)> 125 25 0 <SERV.ITEMDEF.<LOCAL.MALZEME>.NAME>
		
		IF (<CTAG0.<CTAG0.Dialog.Malzeme.Type>.BANK>)
			DCROPPEDTEXT <EVAL <DLOCAL.X>+170> <EVAL (<DLOCAL.Y>)> 90 25 <QVAL (<Bank_Counter <LOCAL.MALZEME>> < 20)?38:044> <Bank_Counter <LOCAL.MALZEME>>
		ELSE
			DCROPPEDTEXT <EVAL <DLOCAL.X>+170> <EVAL (<DLOCAL.Y>)> 90 25 <QVAL (<Pack_Counter <LOCAL.MALZEME>> < 20)?38:044> <Pack_Counter <LOCAL.MALZEME>>
		ENDIF
		
		LOCAL.Y +=25
	ENDIF
ENDFOR
DORIGIN 20 <EVAL <DLOCAL.MAINH>-40>
IF (<CTAG0.Dialog.Malzeme.Page> > 1)
	BUTTON +0 +0 015a1 015a3 1 0 998 // -- 
ENDIF
IF (<CTAG0.Dialog.Malzeme.Page> < <CTAG0.Dialog.Malzeme.MaxPage>)
	BUTTON +25 +0 015a4 015a6 1 0 997 // ++
ENDIF
	
DORIGIN 280 50
RESIZE 260,0,200,230,Malzemeler

BUTTON +0 +0 4006 4007 1 0 1 
DTEXT +30 +0 0 Reagents

BUTTON +0 +20 4006 4007 1 0 2 
DTEXT +30 +20 0 Ingots

BUTTON +0 +40 4006 4007 1 0 3
DTEXT +30 +40 0 Ores

BUTTON +0 +60 4006 4007 1 0 4
DTEXT +30 +60 0 Potions

BUTTON +0 +80 4006 4007 1 0 5
DTEXT +30 +80 0 Scrolls

BUTTON +0 +100 4006 4007 1 0 6
DTEXT +30 +100 0 Others

BUTTON +0 +140 4006 4007 1 0 999
IF (<CTAG0.<CTAG0.Dialog.Malzeme.Type>.BANK>)
	DTEXT +30 +140 0 Çantamdakileri göster
ELSE
	DTEXT +30 +140 0 Bankamdakileri göster
ENDIF


[DIALOG D_MALZEME BUTTON]
ON=1
REGS

ON=2
INGOTS

ON=3
ORES

ON=4
POTIONS

ON=5
SCROLLS

ON=6
OTHERS

ON=999
IF (<CTAG0.<CTAG0.Dialog.Malzeme.Type>.BANK>)
	CTAG0.<CTAG0.Dialog.Malzeme.Type>.BANK=
ELSE
	CTAG0.<CTAG0.Dialog.Malzeme.Type>.BANK=1
ENDIF
MALZEME <CTAG0.Dialog.Malzeme.Type>

ON=998 // PAGE - 
IF (<CTAG0.Dialog.Malzeme.Page> > 1)
 CTAG0.Dialog.Malzeme.Page --
ENDIF
DIALOG D_MALZEME

ON=997 // PAGE +
IF (<CTAG0.Dialog.Malzeme.Page> < <CTAG0.Dialog.Malzeme.MaxPage>)
 CTAG0.Dialog.Malzeme.Page ++
ENDIF
DIALOG D_MALZEME





[eof]