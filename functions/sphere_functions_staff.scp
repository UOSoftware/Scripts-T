VERSION=0.56T


[PLEVEL 2]
S
SC


[FUNCTION S]
FUNC_Staff_Chat <ARGS>

[FUNCTION SC]
FUNC_Staff_Chat <ARGS>


[FUNCTION FUNC_Staff_Chat]
IF (<ISEMPTY <ARGS>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600011 // "Boş giriş yapamazsınız."
	RETURN 1
ENDIF
IF (0<ACCOUNT.PLEVEL> > 1)
	SERV.ALLCLIENTS Func_Staff_To_Staff_Chat [Yetkili] <SRC.NAME> : <ARGS>
ENDIF

[FUNCTION Func_Staff_To_Staff_Chat]
IF (<ACCOUNT.PLEVEL> > 1)
	SYSMESSAGE @035,,1,1 <ARGS>
ENDIF


[FUNCTION Func_Player_To_Staff_Chat]
IF (<ACCOUNT.PLEVEL> > 1)
	SYSMESSAGE @037,,1,1 <ARGS>
ENDIF





[PLEVEL 6]
RY

[FUNCTION RY]
SERV.RESYNC











[PLEVEL 2]
HAZIRLA

[FUNCTION HAZIRLA]
Func_Char_Start_Staff

[FUNCTION Func_Char_Start_Staff]
IF (<ISONLINE>)
	CLOSEPAPERDOLL
ENDIF

IF !(<ISGM>)
	GM=1
ENDIF
IF !(<FLAGS>&STATF_INVUL)
	INVUL=1
ENDIF
	PRIVSHOW=1
IF (<FLAGS>&STATF_DEAD)
	RESURRECT 1
ENDIF
IF (<FLAGS>&STATF_STONE)
	STONE=0
ENDIF
IF (<SPEEDMODE>)
	SPEEDMODE=
ENDIF
// SPEEDSET=1
KILLS=0
DEATHS=0
CRIMINAL=0

BODY=C_MAN
OBODY=C_MAN

FOR 1 54
	IF (<DLOCAL._FOR> != 29)
		IF (<FINDLAYER(<DLOCAL._FOR>)>)
			FINDLAYER(<DLOCAL._FOR>).REMOVE
		ENDIF
	ENDIF
ENDFOR

DORAND 5
	SERV.NEWITEM I_GM_ROBE,1,<UID>,1
	SERV.NEWITEM I_ROBE_GM,1,<UID>,1
	SERV.NEWITEM I_DUPRE,1,<UID>,1
	SERV.NEWITEM I_PERSON_BLACK_THORNE,1,<UID>,1
	SERV.NEWITEM I_PERSON_LORD_BRITISH,1,<UID>,1
ENDDO

NEW.LINK=<SRC>
// NEW.ATTR=ATTR_MOVE_NEVER
NEW.EVENTS ei_robe_gm

SERV.NEWITEM I_STAFF_HORSE,1,<UID>,1
NEW.CONTP 44,121

SERV.NEWITEM I_RESTYPES_DEED,1,<UID>,1
NEW.CONTP 77,121


Func_STATFIX 100,100,100

MODAR=0
MODAC=0
MODSTR=0
MODDEX=0
MODINT=0

LIGHT=0
NIGHTSIGHT=1

COLOR=COLORS_SKIN

KARMA=0
FAME=0
// TITLE <SERV.NAME> Staff

EQUIPHALO -1
// ALLSKILLS=0
// ALLSKILLS=1000	
SKILLCLASS Class_Staff
OPENPAPERDOLL
// BINEQ
PACK
IF (<ISONLINE>)
	DIALOGCLOSE D_HAZIRLA
	DIALOG D_HAZIRLA
ENDIF

HITS=<STR>
STAM=<DEX>
MANA=<INT>
UpdateAllForce




[DIALOG D_HAZIRLA]
<DEF.dlgstartpos>
LOCAL.BODYLIST C_MAN_GM,C_MAN,C_WOMAN,C_ELF_MALE,C_ELF_FEMALE
RESIZE 0,0,140,<EVAL (<ARRAYCOUNT <LOCAL.BODYLIST>>*20)+60>,Bodies
DORIGIN 20 30
FOR 1 <ARRAYCOUNT <LOCAL.BODYLIST>>
	LOCAL.BODY = <ARRAY <LOCAL.BODYLIST>,<DLOCAL._FOR>>
	BUTTON +0 *20 0845 0846 1 0 <dlocal._for>
	DTEXT +20 +0 1000 <SERV.CHARDEF.<LOCAL.BODY>.JOB>
ENDFOR

[DIALOG D_HAZIRLA BUTTON]
ON=1 99
LOCAL.BODYLIST C_MAN_GM,C_MAN,C_WOMAN,C_ELF_MALE,C_ELF_FEMALE
LOCAL.BODY = <ARRAY <LOCAL.BODYLIST>,<DARGN>>	
BODY=<LOCAL.BODY>
OBODY=<LOCAL.BODY>
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Body: <LOCAL.BODY>
COLOR=COLORS_SKIN





[FUNCTION MARKLA]
SERV.NEWITEM I_RUNE_MARKER
NEW.MOREP <SRC.P>
IF !(STRMATCH('','<ARGS>'))
	NEW.NAME <ARGS>
ELSE
	NEW.NAME <SRC.REGION.NAME>
ENDIF
NEW.BOUNCE
CALL Func_Map_Colors <NEW.MOREX>,<NEW.MOREY>,<NEW.MOREZ>,<NEW.MOREM>
NEW.COLOR <DLOCAL.REGIONCOLOR_MARK>
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, [GM] Marklanan alan : <NEW.NAME>
	






[FUNCTION ANKH]
IF (<DIR> == 2) || (<DIR> == 6)
	SERV.NEWITEM 7576
	NEW.P <P>
	NEW.TYPE T_SHRINE
	NEW.NAME Ankh
	NEW.ATTR ATTR_STATIC|ATTR_MOVE_NEVER

	SERV.NEWITEM 7575
	NEW.P <P>
	NEW.MOVE S
	NEW.TYPE T_SHRINE
	NEW.NAME Ankh
	NEW.ATTR ATTR_STATIC|ATTR_MOVE_NEVER
ENDIF

IF (<DIR> == 4) || (<DIR> == 0)
	SERV.NEWITEM 7773
	NEW.P <P>
	NEW.TYPE T_SHRINE
	NEW.NAME Ankh
	NEW.ATTR ATTR_STATIC|ATTR_MOVE_NEVER

	SERV.NEWITEM 7772
	NEW.P <P>
	NEW.MOVE E
	NEW.TYPE T_SHRINE
	NEW.NAME Ankh
	NEW.ATTR ATTR_STATIC|ATTR_MOVE_NEVER
ENDIF




[eof]
