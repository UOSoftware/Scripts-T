

// Full Stats Function
[FUNCTION FUNC_FULLSTATS]
HITS <STR>
MANA <INT>
STAM <DEX>
Cure


[FUNCTION FUNC_STATFIX]
IF (<ISBLANK <ARGV0>>)
	LOCAL.STR=25
ELSEIF !(<ISNUM <ARGV0>>)
	LOCAL.STR=25
ELSE
	LOCAL.STR=<ARGV0>
ENDIF
IF (<ISBLANK <ARGV1>>)
	LOCAL.DEX=25
ELSEIF !(<ISNUM <ARGV1>>)
	LOCAL.DEX=25
ELSE
	LOCAL.DEX=<ARGV1>
ENDIF
IF (<ISBLANK <ARGV2>>)
	LOCAL.INT=25
ELSEIF !(<ISNUM <ARGV2>>)
	LOCAL.INT=25
ELSE
	LOCAL.INT=<ARGV2>
ENDIF

SPELLEFFECT S_DISPEL,100.0,0,<UID>
IF (<FINDLAYER.layer_spell_stats>)
	FINDLAYER.layer_spell_stats.REMOVE
ENDIF
IF (<FINDLAYER.layer_flag_potion>)
	FINDLAYER.layer_flag_potion.REMOVE
ENDIF

IF (<FINDLAYER.layer_flag_drunk>)
	FINDLAYER.layer_flag_drunk.REMOVE
ENDIF

TARGETKAPAT

// EVENTS +E_STAT // .ini de zaten var

MODDEX=0
MODINT=0
MODSTR=0

OSTR=<DLOCAL.STR>
ODEX=<DLOCAL.DEX>
OINT=<DLOCAL.INT>

STR = <OSTR>
DEX = <ODEX>
INT = <OINT>

MAXHITS=
MAXSTAM=
MAXMANA=

IF (<HITS> >= <STR>)
	HITS=<EVAL <STR>/2>
ENDIF
IF (<STAM> >= <DEX>)
	STAM=<EVAL <DEX>/2>
ENDIF
IF (<MANA> >= <INT>)
	MANA=<EVAL <INT>/2>
ENDIF

STATLOCK[1] 2
STATLOCK[2] 2
STATLOCK[0] 2
UPDATE



[FUNCTION FULLSTAT_DAMAGE]
// HITS
FUNC_TAKE_HITS_FIX <ARGV0>
// STAM
FUNC_TAKE_MANA_FIX <ARGV1>
// MANA
FUNC_TAKE_STAM_FIX <ARGV2>


// Hits --
[FUNCTION FUNC_TAKE_HITS_FIX]
IF (<HITS> >= 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	IF (<HITS> <= <DLOCAL.DROP>)
		HITS 0
	ELSE
		HITS -=<DLOCAL.DROP>
	ENDIF
	// IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, "-<DLOCAL.DROP> Hits"
	// ENDIF
ENDIF

// Mana --
[FUNCTION FUNC_TAKE_MANA_FIX]
IF (<MANA> > 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	IF (<MANA> <= <DLOCAL.DROP>)
		MANA 0
	ELSE
		MANA -=<DLOCAL.DROP>
	ENDIF
	// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, "-<DLOCAL.DROP> Mana"
ENDIF

// Stam --
[FUNCTION FUNC_TAKE_STAM_FIX]
IF (<STAM> > 1)
	LOCAL.DROP = <QVAL (<ISEMPTY <ARGS>>)?1:<ARGS>>
	IF (<STAM> <= <DLOCAL.DROP>)
		STAM 0
	ELSE
		STAM -=<DLOCAL.DROP>
	ENDIF
	// IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,"-<DLOCAL.DROP> Stam"
	// ENDIF
ENDIF







// Hits ++
[FUNCTION FUNC_GIVE_HITS_FIX]
IF (<HITS> >= <STR>)
	HITS=<STR>
ENDIF
IF (<HITS> < <STR>)
	LOCAL.HITS=<ARGS>
	HITS +=<DLOCAL.HITS>
	IF (<ISPLAYER>)
		// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.HITS> Hits"
	ENDIF
ELSE
	HITS=<STR>
ENDIF
IF (<HITS> >= <STR>)
	HITS=<STR>
ENDIF


// Mana ++
[FUNCTION FUNC_GIVE_MANA_FIX]
IF (<MANA> >= <INT>)
	MANA=<INT>
ENDIF
IF (<MANA> < <INT>)
	LOCAL.MANA=<ARGS>
	MANA +=<DLOCAL.MANA>
	// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.MANA> Mana"
ELSE
	MANA=<INT>
ENDIF
IF (<MANA> >= <INT>)
	MANA=<INT>
ENDIF

// Stam ++
[FUNCTION FUNC_GIVE_STAM_FIX]
IF (<STAM> >= <DEX>)
	STAM=<DEX>
ENDIF
IF (<STAM> < <DEX>)
	LOCAL.STAM=<ARGS>
	STAM +=<DLOCAL.STAM>
	// SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, "+<DLOCAL.STAM> Stam"
ELSE
	STAM=<DEX>
ENDIF
IF (<STAM> >= <DEX>)
	STAM=<DEX>
ENDIF















[FUNCTION MODMAXHITS]
LOCAL.Result=<EVAL <ARGS>>
IF (<ISEMPTY <ARGS>>)
   RETURN <EVAL <TAG0.MODMAXHITS>>
ELSE
   TAG.MODMAXHITS=<EVAL <TAG0.MODMAXHITS>+<LOCAL.Result>>
   IF !(<TAG0.MODMAXHITS>)
      TAG.MODMAXHITS=
      MAXHITS=
   ELSE
      MAXHITS=<EVAL <MAXHITS>+<LOCAL.Result>>
   ENDIF
ENDIF

[FUNCTION MODMAXSTAM]
LOCAL.Result=<EVAL <ARGS>>
IF (<ISEMPTY <ARGS>>)
   RETURN <EVAL <TAG0.MODMAXSTAM>>
ELSE
   TAG.MODMAXSTAM=<EVAL <TAG0.MODMAXSTAM>+<LOCAL.Result>>
   IF !(<TAG0.MODMAXSTAM>)
      TAG.MODMAXSTAM=
      MAXSTAM=
   ELSE
      MAXSTAM=<EVAL <MAXSTAM>+<LOCAL.Result>>
   ENDIF
ENDIF

[FUNCTION MODMAXMANA]
LOCAL.Result=<EVAL <ARGS>>
IF (<ISEMPTY <ARGS>>)
   RETURN <EVAL <TAG0.MODMAXMANA>>
ELSE
   TAG.MODMAXMANA=<EVAL <TAG0.MODMAXMANA>+<LOCAL.Result>>
   IF !(<TAG0.MODMAXMANA>)
      TAG.MODMAXMANA=
      MAXMANA=
   ELSE
      MAXMANA=<EVAL <MAXMANA>+<LOCAL.Result>>
   ENDIF
ENDIF



[eof]