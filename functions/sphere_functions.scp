MOVE ne <ARGS>
MOVE e <ARGS>
MOVE se <ARGS>
MOVE s <ARGS>
MOVE sw <ARGS>
MOVE w <ARGS>
MOVE nw <ARGS>
ENDDO


[FUNCTION SPEEDSET]
IF (<ISEMPTY <ARGS>>) || (<ARGS> == 0)
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Karakter hızı: Normal
ELSEIF (<ARGS> == 1)
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Karakter hızı: Hızlı
ELSEIF (<ARGS> == 2)
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Karakter hızı: Sadece yürüme
ELSEIF (<ARGS> == 3)
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Karakter hızı: Hızlı yürüme
ELSEIF (<ARGS> == 3)
	SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Karakter hızı: Yürüme/koşma kapalı
ENDIF
SPEEDMODE=<ARGS>






