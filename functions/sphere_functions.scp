[FUNCTION LOGOUT]
IF (<ISPLAYER>) && (<ISONLINE>)
	// DISCONNECT 2
	SENDPACKET 0D1 0AD // LOGOUT CLIENT
	SENDPACKET 082 04 // LOGIN DENIED
	FOR 1 2
		DISCONNECT 2
	ENDFOR
	// DISCONNECT
	// DISCONNECT 1
ENDIF 













