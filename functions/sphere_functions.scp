[FUNCTION RANDMOVE]
LOCAL._DIRECTIONS=S,W,N,E,SW,NE,ES,WN,NW,SE
MOVE <ARRAY <LOCAL._DIRECTIONS>,<R1,<ARRAYCOUNT <LOCAL._DIRECTIONS>>>> <ARGS>





// Add Gold Function
// Kullanım;
// I = 5000 (Char)
// NEW = 5000 (Item)
[FUNCTION ADDGold]
WHILE (<ARGS> > 0)
  SERV.NEWITEM I_GOLD
  IF (<ARGS> > <SERV.ItemsMaxAmount>)
    NEW.AMOUNT=<SERV.ItemsMaxAmount>
  ELSE
    NEW.AMOUNT=<ARGS>
  ENDIF
  NEW.CONT=<UID>
  ARGS -= <NEW.AMOUNT>
ENDWHILE






// Yüzde hesaplama
// Kullanımı;
// <PERCENT 10,222>  222 = %si alınacak rakam 10 = % değeri.
[FUNCTION PERCENT]
RETURN <EVAL (<DARGV[1]>*<DARGV[0]>)/100>






// Custom All Dialog Close Function
[FUNCTION DIALOGCLOSEALL]
IF (<ISONLINE>)
	IF (<DIALOGLIST.COUNT>)
		FOR 0 <EVAL <DIALOGLIST.COUNT>-1>
			IF !((STRMATCH('D_STAFF_PANEL','<DIALOGLIST.<dLOCAL._FOR>.ID>')) || (STRMATCH('d_pin_login','<DIALOGLIST.<dLOCAL._FOR>.ID>')))
				DIALOGCLOSE <DIALOGLIST.<dLOCAL._FOR>.ID> // <ARGN2>
			ENDIF
		ENDFOR
	ENDIF
ENDIF

[FUNCTION ISDIALOGOPEN]
FOR 0 <EVAL <DIALOGLIST.COUNT>-1>
	IF (STRMATCH('<DIALOGLIST.<DLOCAL._FOR>.ID>','<ARGS>'))
		RETURN 1
	ENDIF
ENDFOR
RETURN 0






[PLEVEL 9]
WRITEFILE
DELETEFILE

[FUNCTION WRITEFILE]
IF (STRMATCH(*.scp*,'<ARGS>')) 
	RETURN 1
ELSEIF (STRMATCH(*.php*,'<ARGS>'))
	RETURN 1
ENDIF

IF !(<FILE.INUSE>)
	FILE.MODE.CREATE=1
	FILE.MODE.APPEND=1
	FILE.MODE.WRITEFLAG=1
	IF (<FILE.OPEN <STRARG <ARGS>>>)
		FILE.WRITELINE <STREAT <ARGS>>
		FILE.CLOSE
	ENDIF
ENDIF



[FUNCTION DELETEFILE]
IF (STRMATCH(*.scp*,'<ARGS>')) 
	RETURN 1
ELSEIF (STRMATCH(*.php*,'<ARGS>'))
	RETURN 1
ENDIF
	IF !(<FILE.INUSE>)
	FILE.MODE.APPEND=1
	FILE.DELETEFILE <ARGS>
	FILE.CLOSE
ENDIF
























