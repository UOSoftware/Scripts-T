	REF1=<ARGS>
ENDIF
FORCHARMEMORYTYPE memory_ipet
	remove
ENDFOR
FORCHARMEMORYTYPE memory_friend
	remove
ENDFOR
FORCHARMEMORYTYPE memory_guard
	remove
ENDFOR
IF (<REF1>)
	ATTACK=<REF1>
ENDIF
