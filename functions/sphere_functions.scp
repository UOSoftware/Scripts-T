RETURN <ARGV[<LOCAL.TORET>]>













// Make mypet function
[FUNCTION MAKEMYPET]
CONSUME 100 I_MEMORY
SERV.NEWITEM = I_MEMORY
NEW.COLOR = MEMORY_IPET
NEW.ATTR = ATTR_NEWBIE
NEW.MORE1 = 04
NEW.MORE2 = <SERV.TIME>
NEW.MOREP = <P>
NEW.LINK = <ARGS>
NEW.CONT = <UID>




[FUNCTION WARMODE]
IF !(0<ARGN1>)
	FLAGS &= ~STATF_WAR
	IF (<ISPLAYER>) || (<ISGM>) && (<ISONLINE>)
		SENDPACKET 072 00 00 32 00
	ENDIF
ELSE
	FLAGS |= STATF_WAR
	IF (<ISPLAYER>) || (<ISGM>) && (<ISONLINE>)
		SENDPACKET 072 01 00 32 00
	ENDIF
ENDIF








// Item Unequip All Function
[FUNCTION UnEquipAll]
FOR 1 24
	IF (<FINDLAYER(<DLOCAL._FOR>)>)
	   IF (<DLOCAL._FOR> != 11) && (<DLOCAL._FOR> != 15) && (<DLOCAL._FOR> != 16) && (<DLOCAL._FOR> != 21)
			REF1=<FINDLAYER.<DLOCAL._FOR>>
			IF (<ISEMPTY <ARGS>>)
				UNEQUIP <REF1>
			ELSE
				REF1.CONT = <FINDLAYER.29>
			ENDIF
	   ENDIF
	ENDIF
ENDFOR
IF (<FINDLAYER.32>)
	FINDLAYER.32.remove
ENDIF
IF (<FINDLAYER.44>)
	FINDLAYER.44.remove
ENDIF
IF (<FINDLAYER.47>)
	FINDLAYER.47.remove
ENDIF
UPDATE







			
[FUNCTION GetCharActionName]
IF ((<ACTION> >= skill_anatomy) && (<ACTION> <= skill_throwing))	//1 ~ 57
 return <DEF.skillact_using> <SERV.SKILL.<eval <ACTION> & 0ff>.KEY>
ELIF (<ACTION> == 100)
 return <DEF.skillact_following>
ELIF (<ACTION> == 101)
 return <DEF.skillact_staying>
ELIF (<ACTION> == 102)
 return <DEF.skillact_goingto>
ELIF (<ACTION> == 103)
 return <DEF.skillact_wandering>
ELIF (<ACTION> == 104)
 return <DEF.skillact_looking>
ELIF (<ACTION> == 105)
 return <DEF.skillact_fleeing>
ELIF (<ACTION> == 106)
 return <DEF.skillact_talking>
ELIF (<ACTION> == 107)
 return <DEF.skillact_talkfollow>
ELIF (<ACTION> == 108)
 return <DEF.skillact_guarding>
ELIF (<ACTION> == 109)
 return <DEF.skillact_goinghome>
ELIF (<ACTION> == 110)
 return <DEF.skillact_breathing>
ELIF (<ACTION> == 111)
 return <DEF.skillact_ridden>
ELIF (<ACTION> == 112)
 return <DEF.skillact_throwing>
ELIF (<ACTION> == 113)
 return <DEF.skillact_training>
ELIF (<ACTION> == 114)
 return <DEF.skillact_searchingfood>
ELIF (<ACTION> == 115)
 return <DEF.skillact_runningto>
ELSE
 return <DEF.skillact_idling>
ENDIF



[FUNCTION SPELLCIRCLE] // Büyülerin kaçıncı circle olduğunu döndürür.
//ARGN1=SPELL NUMBER
IF (<ARGN1> >= 1) && (<ARGN1> <= 64) //ONLY WITH DEFAULT (MAGE) SPELLS
	RETURN <EVAL ((<ARGN1>-1)/8)+1>
ELSE
	RETURN 1
ENDIF



