


[FUNCTION StaffDummyArmorSet]
LOCAL.ARMORINCREMENT = 2
LOCAL.COUNT = 0
FORINSTANCES C_DUMMY_STAFF
	MODAR=0
    LOCAL.COUNT ++
    LOCAL.ARMORVALUE = <EVAL <LOCAL.COUNT> * <LOCAL.ARMORINCREMENT>>
	COLOR= <EVAL <DLOCAL.ARMORVALUE>+60>
    MODAR = <LOCAL.ARMORVALUE>
ENDFOR
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <DLOCAL.COUNT> DUMMY


[CHARDEF C_DUMMY_STAFF]
DEFNAME=C_DUMMY_STAFF
ID=C_MAN
NAME=#NAMES_HUMANMALE the Trainer
CAN=MT_EQUIP|MT_USEHANDS|MT_NONMOVER
DAM=0
ARMOR=0
TEVENTS=e_damage_counter
CATEGORY=Vendors
BLOODCOLOR=-1
SUBSECTION=Others
DESCRIPTION=Trainer Dummy
RESDISPDNHUE=0

ON=@Create
StaffDummyArmorSet
COLOR=colors_skin
KARMA=-100
NPC=brain_animal
STR=100
DEX=100
INT=0
WRESTLING=100.0
TACTICS=100.0
MAGERY=0.0


ON=@GETHIT
IF (<FINDID.I_RUNE_POISON>)
	FINDID.I_RUNE_POISON.REMOVE
ENDIF
HITS=<STR>
DIR=3
UPDATE

ON=@NOTOSEND
ARGN1=5

ON=@CLICK
HITS=<STR>
MESSAGE @0515,,1,1 (Armor: <ar>)
DIR=3
UPDATE

ON=@DEATH
HITS=<STR>
RETURN 1

ON=@DCLICK
DIALOGCLOSE d_dummy_damage_show
DIALOG d_dummy_damage_show

HITS=<STR>
DIR=3
UPDATE
RETURN 1

ON=@HIT
HITS=<STR>
DIR=3
UPDATE

ON=@HITTRY
DIR=3
UPDATE
RETURN 1

ON=@DESTROY
// RETURN 1



[EVENTS e_damage_counter]
ON=@HitMiss
REF1=<SRC.WEAPON>
REF2=<WEAPON>
IF (<ARGN2>&02)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=<REF1.NAME>
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.EXECUTE INSERT INTO 'damages' ('dest_uid', 'dest_name', dest_baseid, dest_armorl, dest_armorh, dest_daml, dest_damh, dest_weapon_baseid, dest_weapon_daml, dest_weapon_damh, src_uid, src_name, src_baseid, src_armorl, src_armorh, src_daml, src_damh, src_weapon_baseid, src_weapon_daml, src_weapon_damh, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>', '@GetHit', '<DamTypesOfString <ARGN2>>', <ARGN1>);
ENDIF
LDB.CLOSE



ON=@Hit
REF1=<SRC.WEAPON>
REF2=<WEAPON>
IF (<ARGN2>&02)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=<REF1.NAME>
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF

LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.EXECUTE INSERT INTO 'damages' ('dest_uid', 'dest_name', dest_baseid, dest_armorl, dest_armorh, dest_daml, dest_damh, dest_weapon_baseid, dest_weapon_daml, dest_weapon_damh, src_uid, src_name, src_baseid, src_armorl, src_armorh, src_daml, src_damh, src_weapon_baseid, src_weapon_daml, src_weapon_damh, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>', '@GetHit', '<DamTypesOfString <ARGN2>>', <ARGN1>);
ENDIF
LDB.CLOSE


ON=@GetHit
// SRC = VURAN
// UID = HASAR ALAN
REF1=<SRC.WEAPON> // vuranin silahi
REF2=<WEAPON> // hasar alanin silahi

IF (<ARGN2>&dam_physical|dam_slash|dam_pierce)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=Fight
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSEIF (<ARGN2>&dam_magic|dam_poison|dam_fire|dam_energy|dam_breath)
	LOCAL.ARGUMENT=Spell
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF

LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.EXECUTE INSERT INTO 'damages' ('dest_uid', 'dest_name', dest_baseid, dest_armorl, dest_armorh, dest_daml, dest_damh, dest_weapon_baseid, dest_weapon_daml, dest_weapon_damh, src_uid, src_name, src_baseid, src_armorl, src_armorh, src_daml, src_damh, src_weapon_baseid, src_weapon_daml, src_weapon_damh, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>', '@GetHit', '<DamTypesOfString <ARGN2>>', <ARGN1>);
	IF (<SRC.ISPLAYER>)
		DIALOGCLOSE d_dummy_damage_show
		DIALOG d_dummy_damage_show
	ENDIF
ENDIF
LDB.CLOSE




[DIALOG d_dummy_damage_show]
<DEF.dlgstartpos>

RESIZE 0,0,220,340,Dummy Damage Counter

DORIGIN 20 50
DTEXT +0 +0 <DEF.NOTO.<SRC.NOTOGETFLAG <UID>>> Char: <NAME> <- <SRC.NAME>
DTEXT +0 +20 1000 Armor: <AR>


LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)

	LDB.EXECUTE CREATE TABLE IF NOT EXISTS 'damages' (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, dest_uid TEXT, dest_name TEXT, dest_baseid TEXT, dest_armorl INT, dest_armorh INT, dest_daml INT, dest_damh INT, dest_weapon_baseid TEXT, dest_weapon_daml INT, dest_weapon_damh INT, src_uid TEXT, src_name TEXT, src_baseid TEXT, src_armorl INT, src_armorh INT, src_daml INT, src_damh INT, src_weapon_baseid TEXT, src_weapon_daml INT, src_weapon_damh INT, argument TEXT, triggername TEXT, dam_types TEXT, dam_result INT, created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)
	DORIGIN 20 90
	
	LDB.Query "SELECT COUNT(id) AS total_hits FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.VerilenToplamDarbe = <ldb.row.0.total_hits>
	DTEXT +0 +0 0 Toplam Darbe: <BOLUKAYIR <dLOCAL.VerilenToplamDarbe>>
	
	LDB.Query "SELECT SUM(dam_result) AS total_damage FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.VerilenToplamHasar = <ldb.row.0.total_damage>
	DTEXT +0 +20 0 Toplam Hasar: <BOLUKAYIR <dLOCAL.VerilenToplamHasar>>

	LDB.Query "SELECT MIN(dam_result) AS min_damage FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.VerilenEnAzHasar = <ldb.row.0.min_damage>
	DTEXT +0 +40 0 En Düşük Hasar: <BOLUKAYIR <dLOCAL.VerilenEnAzHasar>>

	LDB.Query "SELECT MIN(dam_result) AS min_damage FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.VerilenEnAzHasar = <ldb.row.0.min_damage>
	DTEXT +0 +40 0 En Düşük Hasar: <BOLUKAYIR <dLOCAL.VerilenEnAzHasar>>
	
	LDB.Query "SELECT MAX(dam_result) AS max_damage FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.VerilenEnFazlaHasar = <ldb.row.0.max_damage>
	DTEXT +0 +60 0 En Yüksek Hasar: <BOLUKAYIR <dLOCAL.VerilenEnFazlaHasar>>

	LDB.Query "SELECT dam_result AS last_damage FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>' ORDER BY created_at DESC LIMIT 1"
	LOCAL.SonVerilenHasar = <ldb.row.0.last_damage>
	DTEXT +0 +80 0 Son Verilen Hasar: <BOLUKAYIR <dLOCAL.SonVerilenHasar>>

	LDB.Query "SELECT CAST((julianday('now') - julianday(MIN(created_at))) * 24 * 60 AS INTEGER) AS elapsed_time FROM 'damages' WHERE dest_uid='<uid>' AND src_uid='<src>'"
	LOCAL.GecenSureDakika = <ldb.row.0.elapsed_time>
	DTEXT +0 +100 0 Geçen Süre: <dLOCAL.GecenSureDakika> dk

	BUTTON +0 +120 0fb5 0fb4 1 0 1
	DTEXT +30 +120 38 Sıfırla

ENDIF


LDB.CLOSE
	
IF (<SRC.WEAPON>)
	REF1=<SRC.WEAPON>
	DORIGIN 20 210
	DTEXT +0 +20 0 Silah Adı: <REF1.NAME>
	DTEXT +0 +40 0 Silah Hasarı: <REF1.DAM.LO>/<REF1.DAM.HI>
	DTEXT +0 +60 0 Silah Hızı: <SERV.ITEMDEF.<REF1.ID>.SPEED.LO>/<SERV.ITEMDEF.<REF1.ID>.SPEED.HI> <QVAL (<REF1.dTAG0.OVERRIDE.SPEED>)?[+<REF1.dTAG0.OVERRIDE.SPEED>]:>
	DTEXT +0 +80 0 Silah Range: <DREF1.RANGEL>/<DREF1.RANGEH>
	DTEXT +0 +100 0 Silah Sağlamlığı: <REF1.HITS>/<REF1.MAXHITS>
ENDIF

[dialog d_dummy_damage_show button]
on=1
LDB.CONNECT "db/main.db"
IF (<LDB.CONNECTED>)
	LDB.EXECUTE "DELETE FROM 'damages' WHERE dest_uid='<UID>'"
	DIALOGCLOSE d_dummy_damage_show
	DIALOG d_dummy_damage_show
ENDIF
DB.CLOSE





// Kullanim <DamTypesOfString <damtype>>
[function DamTypesOfString]
LOCAL.DAMTYPE_NAME = 0,

IF (<ARGV0>&dam_god)
	LOCAL.DAMTYPE_NAME= .=God,
ENDIF

IF (<ARGV0>&dam_physical)
	LOCAL.DAMTYPE_NAME .=Physical,
ENDIF
	
IF (<ARGV0>&dam_magic)
	LOCAL.DAMTYPE_NAME .=Magic,
ENDIF

IF (<ARGV0>&dam_poison)
	LOCAL.DAMTYPE_NAME .=Poison,	
ENDIF

IF (<ARGV0>&dam_fire)
	LOCAL.DAMTYPE_NAME .=Fire,		
ENDIF

IF (<ARGV0>&dam_energy)
	LOCAL.DAMTYPE_NAME .=Energy,
ENDIF

IF (<ARGV0>&dam_general)
	LOCAL.DAMTYPE_NAME .=Genel,	
ENDIF

IF (<ARGV0>&dam_acidic)
	LOCAL.DAMTYPE_NAME .=Acidic	,
ENDIF

IF (<ARGV0>&dam_cold)
	LOCAL.DAMTYPE_NAME .=Cold,	
ENDIF

IF (<ARGV0>&dam_slash)
	LOCAL.DAMTYPE_NAME .=Slash	,
ENDIF	

IF (<ARGV0>&dam_pierce)
	LOCAL.DAMTYPE_NAME .=Pierce,
ENDIF
	
IF (<ARGV0>&dam_noreveal)
	LOCAL.DAMTYPE_NAME .=NoReveal,
ENDIF
	
IF (<ARGV0>&dam_nounparalyze)
	LOCAL.DAMTYPE_NAME .=NoUnParalyze,
ENDIF

ARGS <LOCAL.DAMTYPE_NAME>
FOR 1 <EVAL <ARGV>-1>
	IF (STRMATCH('0','<LOCAL.RESULT>'))
		LOCAL.RESULT =<ARGV<DLOCAL._FOR>>,
	ELSE
		LOCAL.RESULT .=<ARGV<DLOCAL._FOR>>,
	ENDIF
ENDFOR
// SERV.B <LOCAL.RESULT>
RETURN <LOCAL.RESULT>
	
	
	
	
[eof]
