


[FUNCTION DUMMYARMORSET]
LOCAL.ARMORINCREMENT = 2
LOCAL.COUNT = 0
FORINSTANCES C_DUMMY_STAFF
	MODAR=0
    LOCAL.COUNT ++
    LOCAL.ARMORVALUE = <EVAL <LOCAL.COUNT> * <LOCAL.ARMORINCREMENT>>
	// SERV.B <DLOCAL.COUNT>: <DLOCAL.ARMORVALUE>
	COLOR= <EVAL <DLOCAL.ARMORVALUE>+60>
    MODAR = <LOCAL.ARMORVALUE>
ENDFOR
SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <DLOCAL.COUNT> DUMMY


[FUNCTION DUMMYSIFIRLA]
DUMMYARMORSET
IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
		DB.EXECUTE CREATE TABLE IF NOT EXISTS sphere_istatistik_hitdamages (id INTEGER PRIMARY KEY AUTO_INCREMENT NOT NULL, uid VARCHAR(100), name VARCHAR(100), baseid VARCHAR(100), armorlo INT, armorhi INT, damlo INT, damhi INT, weapon_baseid VARCHAR(100), weapon_damlo INT, weapon_damhi INT, src_uid VARCHAR(100), src_name VARCHAR(100), src_baseid VARCHAR(100), src_armorlo INT, src_armorhi INT, src_damlo INT, src_damhi INT, src_weapon_baseid VARCHAR(100),src_weapon_damlo INT, src_weapon_damhi INT, argument VARCHAR(100), triggername VARCHAR(100), dam_types VARCHAR(100), dam_result INT, created_at timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP)
		DB.EXECUTE "DELETE FROM sphere_istatistik_hitdamages WHERE baseid='c_dummy_staff'"
	 ENDIF
	DB.CLOSE
ENDIF

[CHARDEF C_DUMMY_STAFF]
DEFNAME=C_DUMMY_STAFF
ID=C_MAN
NAME=#NAMES_HUMANMALE the Trainer
CAN=MT_EQUIP|MT_USEHANDS|MT_NONMOVER
DAM=0
ARMOR=0
CATEGORY=Vendors
BLOODCOLOR=-1
SUBSECTION=Others
DESCRIPTION=Trainer Dummy
RESDISPDNHUE=0

ON=@Create
DUMMYARMORSET
COLOR=colors_skin
KARMA=-100
NPC=brain_animal
STR=100
DEX=100
INT=0
WRESTLING=100.0
TACTICS=100.0
MAGERY=0.0
// ITEMNEWBIE=i_robe
// ARMOR=0
// COLOR=colors_red
// HITPOINTS=10000

on=@clienttooltip
ADDCLILOC <DEF.EMPTY_CLILOC2>,<DEF.BIG><DEF.BFONT_CYAN>ARMOR: <AR><DEF.BIGE><DEF.BFONTE>

ON=@GETHIT
// IF !(<SRC.ISPLAYER>)
	// RETURN 1
// ENDIF
IF (<FINDID.I_RUNE_POISON>)
	FINDID.I_RUNE_POISON.REMOVE
ENDIF
HITS=<STR>
DIALOGCLOSE D_DAMAGE_SHOW
DIALOG D_DAMAGE_SHOW
DIR=3
UPDATE

ON=@NOTOSEND
ARGN1=5

ON=@CLICK
HITS=<STR>
MESSAGE @0515,,1,1 (Armor: <ar>)
DIR=3
UPDATE

ON=@DEATH
HITS=<STR>
RETURN 1

ON=@DCLICK
DIALOGCLOSE D_DAMAGE_SHOW
DIALOG D_DAMAGE_SHOW
HITS=<STR>
DIR=3
UPDATE
RETURN 1

ON=@HIT
HITS=<STR>
DIR=3
UPDATE

ON=@HITTRY
DIR=3
UPDATE
RETURN 1

ON=@DESTROY
// RETURN 1




[events e_damage_counter]
ON=@HitMiss
REF1=<SRC.WEAPON>
REF2=<WEAPON>

IF (<ARGN2>&02)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=<REF1.NAME>
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF

IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
		DB.EXECUTE INSERT INTO sphere_istatistik_hitdamages (uid, name, baseid, armorlo, armorhi, damlo, damhi, weapon_baseid, weapon_damlo, weapon_damhi, src_uid, src_name, src_baseid, src_armorlo, src_armorhi, src_damlo, src_damhi, src_weapon_baseid, src_weapon_damlo, src_weapon_damhi, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>', '@HitMiss', '<DamTypesOfString <ARGN2>>', <ARGN1>);
	
	ENDIF
	DB.CLOSE
ENDIF

ON=@Hit
REF1=<SRC.WEAPON>
REF2=<WEAPON>

IF (<ARGN2>&02)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=<REF1.NAME>
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF

IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
		DB.EXECUTE INSERT INTO sphere_istatistik_hitdamages (uid, name, baseid, armorlo, armorhi, damlo, damhi, weapon_baseid, weapon_damlo, weapon_damhi, src_uid, src_name, src_baseid, src_armorlo, src_armorhi, src_damlo, src_damhi, src_weapon_baseid, src_weapon_damlo, src_weapon_damhi, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>','@Hit', '<DamTypesOfString <ARGN2>>', <ARGN1>);
	
	 ENDIF
	DB.CLOSE
ENDIF

ON=@GetHit
// SRC = VURAN
// UID = HASAR ALAN
REF1=<SRC.WEAPON>
REF2=<WEAPON>

// SAYU <HARGN2>

IF (<ARGN2>&dam_physical|dam_slash|dam_pierce)
	IF (<REF1.ISVALIDE>)
		LOCAL.ARGUMENT=Fight
	ELSE (<SRC.ACTION>==SKILL_WRESTLING)
		LOCAL.ARGUMENT=Wrest
	ENDIF
ELSEIF (<ARGN2>&dam_magic|dam_poison|dam_fire|dam_energy|dam_breath)
	LOCAL.ARGUMENT=Spell
ELSE
	LOCAL.ARGUMENT=<DamTypesOfString <ARGN2>>
ENDIF

	
IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
		DB.EXECUTE INSERT INTO sphere_istatistik_hitdamages (uid, name, baseid, armorlo, armorhi, damlo, damhi, weapon_baseid, weapon_damlo, weapon_damhi, src_uid, src_name, src_baseid, src_armorlo, src_armorhi, src_damlo, src_damhi, src_weapon_baseid, src_weapon_damlo, src_weapon_damhi, argument, triggername, dam_types, dam_result) VALUES ('<UID>', '<NAME>', '<BASEID>', <ARMOR.LO>, <ARMOR.HI>, <DAM.LO>, <DAM.HI>, <QVAL (<REF2.ISVALIDE>)?'<REF2.BASEID>': NULL>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.LO>:0>, <QVAL (<REF2.ISVALIDE>)?<REF2.DAM.HI>:0>, '<SRC>', '<SRC.NAME>', '<SRC.BASEID>', <SRC.ARMOR.LO>, <SRC.ARMOR.HI>, <SRC.DAM.LO>, <SRC.DAM.HI>, <QVAL (<REF1.ISVALIDE>)?'<REF1.BASEID>':NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.LO>:NULL>, <QVAL (<REF1.ISVALIDE>)?<REF1.DAM.HI>:NULL>, '<LOCAL.ARGUMENT>', '@GetHit', '<DamTypesOfString <ARGN2>>', <ARGN1>);
	
	ENDIF
	DB.CLOSE
ENDIF

IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSE d_damage_show
	SRC.DIALOG d_damage_show
ENDIF

[dialog d_damage_show]
<DEF.dlgstartpos>

RESIZEPIC 0 0 5120 240 340
RESIZEPIC 10 10 3000 220 320

DORIGIN 20 20
DTEXT +0 +0 <def.noto.<src.notogetflag <uid>>> Char: <NAME>
DTEXT +0 +20 1000 Armor: <AR>

IF (<SRC.WEAPON>)
	ref1=<src.weapon>
	DORIGIN 20 180
	DTEXT +0 +20 0 Silah: <ref1.name>
	DTEXT +0 +40 0 Hasarı: <ref1.dam.lo>/<ref1.dam.hi>
	DTEXT +0 +60 0 Hızı: <SERV.ITEMDEF.<REF1.ID>.SPEED.LO>/<SERV.ITEMDEF.<REF1.ID>.SPEED.HI> <QVAL (<REF1.dTAG0.OVERRIDE.SPEED>)?[+<REF1.dTAG0.OVERRIDE.SPEED>]:>
	DTEXT +0 +80 0 Range: <dref1.rangel>/<dref1.rangeh>
	// DTEXT +0 +100 0 Durability: <ref1.hits>/<ref1.maxhits> (<REF1.ShowDurability>)
	DTEXT +0 +100 0 Durability: <ref1.hits>/<ref1.maxhits>
ENDIF

DORIGIN 20 280
BUTTON +0 +20 0fb5 0fb4 1 0 1
DTEXT +30 +20 38 Sıfırla

IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
	 	DB.EXECUTE CREATE TABLE IF NOT EXISTS sphere_istatistik_hitdamages (id INTEGER PRIMARY KEY AUTO_INCREMENT NOT NULL, uid VARCHAR(100), name VARCHAR(100), baseid VARCHAR(100), armorlo INT, armorhi INT, damlo INT, damhi INT, weapon_baseid VARCHAR(100), weapon_damlo INT, weapon_damhi INT, src_uid VARCHAR(100), src_name VARCHAR(100), src_baseid VARCHAR(100), src_armorlo INT, src_armorhi INT, src_damlo INT, src_damhi INT, src_weapon_baseid VARCHAR(100),src_weapon_damlo INT, src_weapon_damhi INT, argument VARCHAR(100), triggername VARCHAR(100), dam_types VARCHAR(100), dam_result INT, created_at timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP)
			
		DORIGIN 20 60
		DB.Query "SELECT COUNT(id) AS total_hits FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.VerilenToplamDarbe = <db.row.0.total_hits>
		DTEXT +0 +0 0 Toplam Darbe: <BOLUKAYIR <dLOCAL.VerilenToplamDarbe>>

				
		DB.Query "SELECT SUM(dam_result) AS total_damage FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.VerilenToplamHasar = <db.row.0.total_damage>
		DTEXT +0 +20 0 Toplam Hasar: <BOLUKAYIR <dLOCAL.VerilenToplamHasar>>

		
		DB.Query "SELECT MIN(dam_result) AS min_damage FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.VerilenEnAzHasar = <db.row.0.min_damage>
		DTEXT +0 +40 0 En Düşük Hasar: <BOLUKAYIR <dLOCAL.VerilenEnAzHasar>>

		DB.Query "SELECT MIN(dam_result) AS min_damage FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.VerilenEnAzHasar = <db.row.0.min_damage>
		DTEXT +0 +40 0 En Düşük Hasar: <BOLUKAYIR <dLOCAL.VerilenEnAzHasar>>
		
		DB.Query "SELECT MAX(dam_result) AS max_damage FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.VerilenEnFazlaHasar = <db.row.0.max_damage>
		DTEXT +0 +60 0 En Yüksek Hasar: <BOLUKAYIR <dLOCAL.VerilenEnFazlaHasar>>

		DB.Query "SELECT dam_result AS last_damage FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>' ORDER BY created_at DESC LIMIT 1"
		LOCAL.SonVerilenHasar = <db.row.0.last_damage>
		DTEXT +0 +80 0 Son Verilen Hasar: <BOLUKAYIR <dLOCAL.SonVerilenHasar>>

		DB.Query "SELECT TIMESTAMPDIFF(MINUTE, MIN(created_at), NOW()) AS elapsed_time FROM sphere_istatistik_hitdamages WHERE uid='<uid>' AND src_uid='<src>'"
		LOCAL.GecenSureDakika = <db.row.0.elapsed_time>
		DTEXT +0 +100 0 Geçen Süre: <dLOCAL.GecenSureDakika> dk

	 ENDIF
	DB.CLOSE
ENDIF

[dialog d_damage_show button]
on=1
IF (<SERV.MYSQL>)
	DB.CONNECT
	 IF (<DB.CONNECTED>)
		DB.EXECUTE "DELETE FROM sphere_istatistik_hitdamages WHERE uid='<UID>'"
		DIALOGCLOSE d_damage_show
		DIALOG d_damage_show
	 ENDIF
	DB.CLOSE
ENDIF


// Kullanim <DamTypesOfString <damtype>>
[function DamTypesOfString]
LOCAL.DAMTYPE_NAME = 0,

IF (<ARGV0>&dam_god)
	LOCAL.DAMTYPE_NAME= .=God,
ENDIF

IF (<ARGV0>&dam_physical)
	LOCAL.DAMTYPE_NAME .=Physical,
ENDIF
	
IF (<ARGV0>&dam_magic)
	LOCAL.DAMTYPE_NAME .=Magic,
ENDIF

IF (<ARGV0>&dam_poison)
	LOCAL.DAMTYPE_NAME .=Poison,	
ENDIF

IF (<ARGV0>&dam_fire)
	LOCAL.DAMTYPE_NAME .=Fire,		
ENDIF

IF (<ARGV0>&dam_energy)
	LOCAL.DAMTYPE_NAME .=Energy,
ENDIF

IF (<ARGV0>&dam_general)
	LOCAL.DAMTYPE_NAME .=Genel,	
ENDIF

IF (<ARGV0>&dam_acidic)
	LOCAL.DAMTYPE_NAME .=Acidic	,
ENDIF

IF (<ARGV0>&dam_cold)
	LOCAL.DAMTYPE_NAME .=Cold,	
ENDIF

IF (<ARGV0>&dam_slash)
	LOCAL.DAMTYPE_NAME .=Slash	,
ENDIF	

IF (<ARGV0>&dam_pierce)
	LOCAL.DAMTYPE_NAME .=Pierce,
ENDIF
	
// IF (<ARGV0>&dam_nodisturb)
	// LOCAL.DAMTYPE_NAME .=NoDisturb,
// ENDIF
	
IF (<ARGV0>&dam_noreveal)
	LOCAL.DAMTYPE_NAME .=NoReveal,
ENDIF
	
IF (<ARGV0>&dam_nounparalyze)
	LOCAL.DAMTYPE_NAME .=NoUnParalyze,
ENDIF

IF (<ARGV0>&dam_fixed)
	LOCAL.DAMTYPE_NAME .=Fixed,
ENDIF

IF (<ARGV0>&dam_breath)
	LOCAL.DAMTYPE_NAME .=Breath,
ENDIF

IF (<ARGV0>&dam_thrown)
	LOCAL.DAMTYPE_NAME .=Throw,
ENDIF
	
IF (<ARGV0>&dam_reactive)
	LOCAL.DAMTYPE_NAME .=Reactive,
ENDIF
ARGS <LOCAL.DAMTYPE_NAME>
FOR 1 <EVAL <ARGV>-1>
	IF (STRMATCH('0','<LOCAL.RESULT>'))
		LOCAL.RESULT =<ARGV<DLOCAL._FOR>>,
	ELSE
		LOCAL.RESULT .=<ARGV<DLOCAL._FOR>>,
	ENDIF
ENDFOR
// SERV.B <LOCAL.RESULT>
RETURN <LOCAL.RESULT>
	
	
	
	
[eof]
