
[ITEMDEF i_golem_tinker_repair]
DEFNAME=i_golem_tinker_repair
DEFNAME2=i_golem_repair
NAME=golem repairing tool
ID=i_tinker_tools
WEIGHT=1.0
RESDISPDNHUE=0454

On=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>

ON=@DCLICK
IF (<SRC.STAMINA> < 10)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Golem tamir edemeyecek kadar yorgunsunuz.
	RETURN 1
ELSEIF (<SRC.TINKERING> < 70.0)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Golem tamir edebilmek icin Tinkering becerinizin 70.0 veya ustu olmasi gerekiyor.
	RETURN 1
ELSEIF !(<SRC.RESTEST 10 I_INGOT_IRON>) || !(<SRC.RESTEST 10 I_INGOT_BRONZE>)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Golem tamir edebilmek icin icin 10 bronze ingot, 10 iron ingot'a ihtiyaciniz var.
	RETURN 1
ENDIF
TARGET Tamir edeceginiz golemi seciniz.
RETURN 1

On=@TargOn_Item
RETURN 1

ON=@TARGON_CHAR
IF (<SRC.TARG.DISTANCE> > 3)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Goleme cok uzaksiniz
	RETURN 1
ELSEIF !((<SRC.TARG.BASEID> == C_M_GOLEM_TINKER1) || (<SRC.TARG.BASEID> == C_M_GOLEM_TINKER2))
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu uretilmis bir golem degil.
	RETURN 1
ELSEIF (<SRC.TARG.HITS> >= <SRC.TARG.STR>)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Golemin tamire ihtiyaci yok.
	SRC.TARG.HITS=<SRC.TARG.STR>
	RETURN 1
ENDIF
SRC.TARG.HITS +=80
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Golemi tamir ettiniz.
SRC.CONSUME 10 I_INGOT_IRON
SRC.CONSUME 10 I_INGOT_BRONZE
SRC.STAMINA -=10
RETURN 1



