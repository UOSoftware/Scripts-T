[events e_golem_tinker]
ON=@GETHIT
IF (<MEMORYFINDTYPE.MEMORY_IPET>)
	REF1=<MEMORYFINDTYPE.MEMORY_IPET.LINK>
	IF (<REF1.CANSEELOS>) && (<ARGN> > 5)
		IF (<REF1.MANA> > 5)
			REF1.MANA -=<R3,5>
		ELSEIF (<REF1.HITS> > 5)
			REF1.DAMAGE <R10,20>
		ENDIF
	ENDIF
ENDIF

ON=@SPELLEFFECT
IF ((<ARGN> == 4) || (<ARGN> == 29))
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Golemleri buyu ile iyilestiremezsiniz.
	RETURN 1
ENDIF

ON=@RECEIVEITEM
RETURN 1

ON=@ENVIRONCHANGE
FOOD=<MAXFOOD>

ON=@CLICK
IF (<MEMORYFINDTYPE.MEMORY_IPET>)
	MESSAGE * <MEMORYFINDTYPE.MEMORY_IPET.LINK.NAME> *
ENDIF




