ON=@DESTROY
FireElementalCheckFireField


// Fire Elementallerin ortaya çıkarttığı fire fieldler badlink hatası geçici fixi.

[FUNCTION FireElementalCheckFireField]
REF1=<UID>
FORINSTANCES I_FX_FIELD_FIRE_NS
	IF (<LINK.ISVALIDE> && <LINK> == <REF1> && <TYPE> == T_FIRE)
		REMOVE
	ENDIF
ENDFOR

FORINSTANCES I_FX_FIELD_FIRE
	IF (<LINK.ISVALIDE> && <LINK> == <REF1> && <TYPE> == T_FIRE)
		REMOVE
	ENDIF
ENDFOR



