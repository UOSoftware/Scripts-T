	NEWITEM=I_MT_HORSE_GRAY
	NEW.EQUIP
ENDIF
RETURN 1

ON=@SKILLSTART
IF !<SRC.RESTEST 1 I_MT_HORSE_GRAY>
	NEWITEM=I_MT_HORSE_GRAY
	NEW.EQUIP
ENDIF
RETURN 1

ON=@DEATH
IF <SRC.RESTEST 1 I_MT_HORSE_GRAY>
	SRC.FINDID.I_MT_HORSE_GRAY.REMOVE
ENDIF
RETURN 0

