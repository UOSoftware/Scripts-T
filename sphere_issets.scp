[FUNCTION IsEquipArmorType]
LOCAL.TYPE=<ARGV0>
ARGS=4,6,7,10,13,19,24
WHILE (<DARGS>)
	IF (<FINDLAYER.<ARGV0>.ISVALIDE>) && (<FINDLAYER.<ARGV0>.TYPE> == <LOCAL.TYPE>)
		LOCAL.AR ++
	ENDIF
	ARGS=<STREAT <ARGS>>
ENDWHILE
RETURN <DLOCAL.AR>




