ELSEIF (<TYPE> == T_MULTI_CUSTOM)
	RETURN 1
ENDIF
RETURN 0




// Ev sistemi icinde var.
// [FUNCTION IsOnHouse]
// REF1 = <REGION.UID>
// IF (<IsInHouse>) && !(<Z> == <SERV.MAP(<P.X>,<P.Y>,<P.M>).TERRAIN.Z>)
	// RETURN 1
// ENDIF
// RETURN 0


[FUNCTION IsInHouse]
IF (<REGION.FLAGS>&REGION_FLAG_HOUSE)
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsInShip]
IF (<REGION.FLAGS>&REGION_FLAG_SHIP)
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsOnSea]
IF !(<REGION.FLAGS>&REGION_FLAG_SHIP)
	// IF (<P.Z> <= -3) && ( (<P.TYPE> == T_WATER) || (<P.TERRAIN> == 05f) || (<P.TERRAIN> == 055) || (<P.TERRAIN> == 059) || (<P.TERRAIN> == 064) || (<P.TERRAIN> == 0AA) || (<ISNEARTYPE T_WATER 0>) )
	IF (<P.Z> <= -1) && ( (<P.TYPE> == T_WATER) || (<P.TERRAIN> == 05f) || (<P.TERRAIN> == 055) || (<P.TERRAIN> == 059) || (<P.TERRAIN> == 064) || (<P.TERRAIN> == 0AA) || (<ISNEARTYPE T_WATER 0>) )
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION IsDeath]
IF (<FLAGS>&STATF_DEAD) 
	RETURN 1
ELSEIF (<HITS> <= 0)
	RETURN 1
ENDIF
RETURN 0


