// [FUNCTION IsPk]
// IF (<KILLS> >= <SERV.MURDERMINCOUNT>)
	// RETURN 1
// ENDIF
// RETURN 0

[FUNCTION ISPK]
IF (<ISCHAR>)
	IF !(<NPC>)
	LOCAL.MURDERKILL=<EVAL <SERV.MURDERMINCOUNT>+1>
		IF (<KILLS> >= <LOCAL.MURDERKILL>) || (<KARMA> <= -2001)
			RETURN 1
		ENDIF
	ELSE
		IF (<KARMA> <= -800)
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 0



[FUNCTION ISCRIMINAL]
