[FUNCTION ISBADCHAR]
LOCAL.CHAR=<ASC <ARGS>>
IF ( (<LOCAL.CHAR> >= 030) && (<LOCAL.CHAR> <= 039)) // 0-9
	RETURN 0
ELSEIF ( (<LOCAL.CHAR> >= 041) && (<LOCAL.CHAR> <= 05A)) // A-Z
	RETURN 0
ELSEIF ( (<LOCAL.CHAR> >= 061) && (<LOCAL.CHAR> <= 07A)) // a-z
	RETURN 0
ELSEIF (<LOCAL.CHAR> == 0A0 || <LOCAL.CHAR> == 020 || <LOCAL.CHAR> == 00) // NO-BREAK SPACE
	RETURN 0
ENDIF
RETURN 1



[FUNCTION ISFORBIDSTRING]
IF  (STRMATCH(*<SERV.NAME>*,'<ARGS>'))
	RETURN 1
ENDIF
FOR 1 <ARRAYCOUNT <DEF.forbidden_strings>>
	IF  (STRMATCH(*<ARRAY <DEF.forbidden_strings>,<DLOCAL._FOR>>*,'<ARGS>'))
		RETURN 1
	ENDIF
ENDFOR
RETURN 0


[FUNCTION ISSTRING]
IF (STRREGEX(^[a-zA-Z]+$,<ARGS>))
	RETURN 1
ENDIF
RETURN 0





[FUNCTION ISALPHANUMERIC]
IF (STRREGEX(^[a-zA-Z0-9]+$,<ARGS>))
	RETURN 1
ENDIF
RETURN 0




[FUNCTION IsBlank]
LOCAL.ASC <ASC <ARGS>>

IF !(<EVAL STRLEN(<ARGS>)>)
	RETURN 1
ELSEIF (<dLOCAL.ASC> == 0) 
	RETURN  1
ELSEIF (STRMATCH('0','<ARGS>')) 
	RETURN  1
ELSEIF (STRMATCH('','<ARGS>')) 
	RETURN  1
ELSEIF (<ISEMPTY <ARGS>>)
	RETURN  1
ELSEIF (STRMATCH('-','<ARGS>'))
	RETURN 1
ELSEIF (STRMATCH('-','<STRSUB 0 1 <ARGS>>'))
	RETURN 1
ENDIF
IF (<ISNUM <ARGS>>)
	IF (<ARGS> <= 0)
		RETURN 1
	ENDIF
ENDIF
RETURN 0



[FUNCTION IsDamageName]
IF (<HITS> > <MAXHITS>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_PERFECT> // kusursuz
	
ELSEIF (<HITS> == <MAXHITS>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_FULL> // hasarsız
	
ELSEIF (<HITS> > <EVAL <MAXHITS> / 2>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_WELLWORN> // iyi
		
ELSEIF (<HITS> > <EVAL <MAXHITS> / 3>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_SCRATCHED>  // yıpranmış
		
ELSEIF (<HITS> > 3)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_BADLY> // ağır hasarlı
ELSE
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_FALL_APART> // parçalanmak üzere
ENDIF

RETURN <LOCAL.STATUSMSG>

		
		
		
[FUNCTION IsWeaponPoisonLevelName]
IF (<MOREZ>)
	IF ((<MOREZ> >= 1) && (<MOREZ> < 53))
		LOCAL.CONDITION sickly
	ELSEIF ((<MOREZ> >= 53) && (<MOREZ> < 73))
		LOCAL.CONDITION very ill
	ELSEIF ((<MOREZ> >= 73) && (<MOREZ> < 96))
		LOCAL.CONDITION extremely
	ELSEIF ((<MOREZ> >= 96) && (<MOREZ> < 127))
		LOCAL.CONDITION deadly
	ENDIF
RETURN <LOCAL.CONDITION>
ENDIF	





[FUNCTION IsHomeFullPosition]
ARGS=<HOME>
IF (<ARGV> == 2)
	LOCAL.HOMEP <ARGV0>,<ARGV1>,0,0
	
ELSEIF (<ARGV> == 3)
	LOCAL.HOMEP <ARGV0>,<ARGV1>,<ARGV2>,0
ELSEIF (<ARGV> == 4)
	LOCAL.HOMEP <ARGV0>,<ARGV1>,<ARGV2>,<ARGV3> 
ENDIF

IF (<ARGV0> <= 0)
	LOCAL.HOMEP=0
ENDIF
RETURN <LOCAL.HOMEP>





