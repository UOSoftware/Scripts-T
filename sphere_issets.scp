[function Isinpacktest]
targetf f_target_isinpacktest


[FUNCTION f_target_isinpacktest]
if (<argo>)
	if (<ISINPACK <argo>>)
		SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, Evet çantada veya üzerinde. <ISINPACK <argo>>
	ELSE
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,  Hayır çantada veya üzerinde değil.. <ISINPACK <argo>>
	endif
endif


