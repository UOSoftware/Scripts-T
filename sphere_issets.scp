//add here something to format <LOCAL.Timestamp> into a readable value (eg: 1 month, 8 days, etc)
[FUNCTION AccountAgeDiffforHuman]
ARGS=<EXPLODE /., <ACCOUNT.FIRSTCONNECTDATE>>
LOCAL.Timestamp =<SERV.RTICKS.FROMTIME <ARGV0>,<ARGV1>,<ARGV2>,<ARGV3>,<ARGV4>,<ARGV5>>
LOCAL.sec=<eval (<SERV.RTICKS>-<LOCAL.Timestamp>)/5>
If (<eval <local.sec>/518400>)
  local.timeleft=<eval <local.sec>/518400> ay.
elif (<eval <local.sec>/86400>)
  local.timeleft=<eval <local.sec>/86400> gun.
elif (<eval <local.sec>/3600>)
  local.timeleft=<eval <local.sec>/3600> saat.
elif (<eval <local.sec>/60>)
  local.timeleft=<eval <local.sec>/60> dk.
else
  local.timeleft=<eval <local.sec>> sn.
endif
return <local.timeleft>





[FUNCTION AccountAge]
ARGS=<EXPLODE /., <ACCOUNT.FIRSTCONNECTDATE>>
LOCAL.Timestamp =<SERV.RTICKS.FROMTIME <ARGV0>,<ARGV1>,<ARGV2>,<ARGV3>,<ARGV4>,<ARGV5>>
LOCAL.Timestamp=<eval (<SERV.RTICKS>-<LOCAL.Timestamp>)>
return <DLOCAL.Timestamp>




