[FUNCTION IsSignID]
// START: 0x0BA3 = 2979
// END: 0x0C0E = 3086
IF (<DISPID> == 0B95)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 0B96)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 01F28)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 01F29)
	LOCAL.SIGN=1
ENDIF
IF ((<DISPID> >= 2979) && (<DISPID> <= 3086))
	LOCAL.SIGN=1
ENDIF
RETURN <DLOCAL.SIGN>


